+#!/usr/bin/env python3
+"""The end-to-end smoke run: one real Cadence-on-Haiku run of the smallest task, in under 10 minutes.
+
+Owner (2026-10-25): "Smoke test must run in under 10 minutes, must also be paired with toy run regressions.
+Must run with every change locally as a part of precommit." The toy-run regressions (examples/toy-run, no
+model) replay the gates on fixed artifacts; they passed on #233, and the fresh runs on #233 still stopped at
+A1, P1, P4 and E1. So this run uses the model, the plugin of this checkout and the spec as the whole prompt
+(`/cadence <spec>`), as a benchmark run does (harness-benchmark scripts/host_trial.py), on the toy package.
+
+The run passes only when all of these hold:
+
+- the agent ends inside the time limit (default 600 s, CADENCE_SMOKE_SECONDS),
+- the run's session is closed at R7 (`status: completed`, which activate_session.py --deactivate allows only
+  once E1 through R6 pass) and no hard stop is recorded,
+- `headless.py next` finds no open block of the run's manifest,
+- a clean clone of the run's HEAD passes `make test`, and its subtract() gives both of the spec's results.
+
+Usage::
+
+    python3 scripts/smoke_run.py                 # exit 0 when the run passes; the record is printed
+    python3 scripts/smoke_run.py --keep DIR      # keep the sandbox (repo, HOME, transcript) in DIR
+    python3 scripts/smoke_run.py --dry-run       # set up the sandbox and print the agent command only
+
+Exit 0: pass. 1: the run failed a check (the record says which). 2: setup failed (no `claude`, an API key set).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+TOY = ROOT / "tests" / "fixtures" / "toy_repo"
+MODEL = os.environ.get("CADENCE_SMOKE_MODEL", "<model id redacted>")
+PEER_MODEL = os.environ.get("CADENCE_SMOKE_PEER_MODEL", "haiku")
+LIMIT = int(os.environ.get("CADENCE_SMOKE_SECONDS", "600"))
+
+SPEC = """---
+id: smoke-1
+---
+# Add subtract() to toy_pkg
+
+`src/toy_pkg/core.py` has `add(a, b)`. Add `subtract(a, b)`, which returns `a - b`.
+
+1. `subtract(5, 3)` returns 2.
+2. `subtract(2, 5)` returns -3.
+
+The project's tests run with `make test`. Add a test for each numbered item to `tests/test_core.py`.
+"""
+
+TEST_CORE = '"""Tests of toy_pkg.core."""\n\nfrom toy_pkg.core import add\n\n\ndef test_add():\n    assert add(2, 3) == 5\n'
+RUN_TESTS = ('"""Run every test_* function of tests/test_core.py; exit 1 on the first failure."""\n'
+             "import sys\n\nsys.path.insert(0, 'tests')\nimport test_core  # noqa: E402\n\n"
+             "for name in sorted(n for n in dir(test_core) if n.startswith('test_')):\n"
+             "    getattr(test_core, name)()\n    print('ok', name)\n")
+MAKEFILE = "test:\n\tPYTHONPATH=src python3 tests/run_tests.py\n"
+DELIVERABLE = ("import sys; sys.path.insert(0, 'src'); from toy_pkg.core import subtract; "
+               "assert subtract(5, 3) == 2 and subtract(2, 5) == -3; print('subtract ok')")
+
+
+def git(cwd: Path, *args: str, env: dict[str, str]) -> subprocess.CompletedProcess:
+    return subprocess.run(["git", *args], cwd=cwd, env=env, capture_output=True, text=True, check=False)
+
+
+def base_env(home: Path) -> dict[str, str]:
+    """The agent's environment: a fresh HOME, this checkout as CADENCE_HOME, no API key, no git hook variables."""
+    drop = set(subprocess.run(["git", "rev-parse", "--local-env-vars"], capture_output=True, text=True,
+                              check=False).stdout.split())
+    env = {k: v for k, v in os.environ.items()
+           if k not in drop and not k.startswith(("UV_", "VIRTUAL_ENV", "PYTEST_", "CLAUDECODE", "CLAUDE_CODE_"))
+           and k not in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "PYTHONPATH")}
+    venv = os.environ.get("VIRTUAL_ENV")
+    env["PATH"] = os.pathsep.join(d for d in env.get("PATH", "").split(os.pathsep) if d and not (venv and d.startswith(venv)))
+    env.update(HOME=str(home), CADENCE_HOME=str(ROOT), DISABLE_AUTOUPDATER="1", CLAUDE_AUTO_BACKGROUND_TASKS="false",
+               CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS="0", PYTHONDONTWRITEBYTECODE="1",
+               GIT_AUTHOR_NAME="smoke", GIT_AUTHOR_EMAIL="smoke@example.com",
+               GIT_COMMITTER_NAME="smoke", GIT_COMMITTER_EMAIL="smoke@example.com", GIT_CONFIG_NOSYSTEM="1")
+    return env
+
+
+def setup(base: Path) -> tuple[Path, Path, dict[str, str]]:
+    """The toy repository (main, pushed to a local bare origin), the spec outside it, and the fresh HOME."""
+    repo, home, spec = base / "repo", base / "home", base / "spec" / "smoke-1.md"
+    shutil.copytree(TOY, repo)
+    (repo / "tests").mkdir()
+    (repo / "tests" / "test_core.py").write_text(TEST_CORE, encoding="utf-8")
+    (repo / "tests" / "run_tests.py").write_text(RUN_TESTS, encoding="utf-8")
+    (repo / "Makefile").write_text(MAKEFILE, encoding="utf-8")
+    (repo / ".cadence.json").write_text(json.dumps({"adapter": "none", "profile": "core"}, indent=1) + "\n",
+                                        encoding="utf-8")
+    spec.parent.mkdir(parents=True)
+    spec.write_text(SPEC, encoding="utf-8")
+    (home / ".config" / "cadence").mkdir(parents=True)
+    (home / ".config" / "cadence" / "config.json").write_text(json.dumps({"peer_models": {"default": PEER_MODEL}}) + "\n")
+    env = base_env(home)
+    for args in (("init", "-q", "-b", "main"), ("add", "-A"), ("commit", "-qm", "toy package")):
+        done = git(repo, *args, env=env)
+        if done.returncode != 0:
+            raise SystemExit(f"smoke: git {' '.join(args)} failed: {done.stderr}")
+    git(base, "init", "-q", "--bare", str(base / "origin.git"), env=env)
+    git(repo, "remote", "add", "origin", str(base / "origin.git"), env=env)
+    git(repo, "push", "-q", "-u", "origin", "main", env=env)
+    return repo, spec, env
+
+
+def agent_argv(spec: Path) -> list[str]:
+    return ["claude", "-p", f"/cadence {spec}", "--model", MODEL, "--permission-mode", "auto",
+            "--output-format", "stream-json", "--verbose", "--plugin-dir", str(ROOT), "--add-dir", str(spec.parent)]
+
+
+def sessions(repo: Path) -> list[dict]:
+    found = []
+    for path in sorted((repo / ".context" / "sessions" / "by-worktree").glob("*.json")):
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            continue
+        if isinstance(data, dict) and "ref" not in data:
+            found.append(data)
+    return found
+
+
+def open_block(repo: Path, env: dict[str, str]) -> dict:
+    """headless.py next on a copy of the repository, with the copy's own worktree session (host_trial.rebind_sessions)."""
+    with tempfile.TemporaryDirectory() as tmp:
+        copy = Path(tmp) / "repo"
+        shutil.copytree(repo, copy, symlinks=True)
+        folder = copy / ".context" / "sessions" / "by-worktree"
+        key = hashlib.sha256(str(copy.resolve()).encode("utf-8")).hexdigest()[:16]
+        for data in sessions(copy):
+            folder.mkdir(parents=True, exist_ok=True)
+            (folder / f"{key}.json").write_text(json.dumps({**data, "workspace": str(copy.resolve())}) + "\n")
+            break
+        done = subprocess.run([sys.executable, str(ROOT / "scripts" / "headless.py"), "next", "--json"], cwd=copy,
+                              env=env, capture_output=True, text=True, timeout=300, check=False)
+    try:
+        report = json.loads(done.stdout)
+    except ValueError:
+        return {"block": "?", "why": f"headless.py next exited {done.returncode}: {done.stderr.strip()[-300:]}"}
+    nxt = report.get("next")
+    if not nxt:
+        return {"block": None, "why": None}
+    failing = [r for r in report.get("results", []) if not r.get("ok")]
+    why = next((line.strip() for line in str((failing[-1] if failing else {}).get("output") or "").splitlines()
+                if line.strip()), "")
+    return {"block": nxt.get("block"), "slug": nxt.get("slug"), "why": why}
+
+
+def deliverable(base: Path, repo: Path, env: dict[str, str]) -> dict:
+    """`make test` and the spec's two results in a clean clone of the run's HEAD."""
+    clone = base / "clean"
+    git(base, "clone", "-q", str(repo), str(clone), env=env)
+    make = subprocess.run(["make", "test"], cwd=clone, env=env, capture_output=True, text=True, timeout=120, check=False)
+    calc = subprocess.run([sys.executable, "-c", DELIVERABLE], cwd=clone, env=env, capture_output=True, text=True,
+                          timeout=60, check=False)
+    return {"make_test": make.returncode, "subtract": calc.returncode,
+            "output": (make.stdout + make.stderr + calc.stdout + calc.stderr)[-600:]}
+
+
+def judge(record: dict) -> list[str]:
+    problems = []
+    if record["timed_out"]:
+        problems.append(f"the run took longer than {record['limit_seconds']} s")
+    elif record["agent_exit"] != 0:
+        problems.append(f"claude exited {record['agent_exit']}")
+    if record["hard_stop"]:
+        problems.append(f"hard stop: {record['hard_stop']}")
+    if record["session_status"] != "completed":
+        problems.append(f"the session was not closed at R7 (status {record['session_status']!r})")
+    if record["open_block"].get("block"):
+        problems.append(f"open block {record['open_block']['block']}: {record['open_block'].get('why')}")
+    if record["deliverable"]["make_test"] != 0 or record["deliverable"]["subtract"] != 0:
+        problems.append(f"the deliverable fails in a clean clone: {record['deliverable']['output'][-200:]}")
+    return problems
+
+
+def run(base: Path, dry_run: bool) -> int:
+    for tool in ("claude", "git", "make"):
+        if shutil.which(tool) is None:
+            print(f"smoke: {tool} is not on PATH", file=sys.stderr)
+            return 2
+    if os.environ.get("ANTHROPIC_API_KEY"):
+        print("smoke: ANTHROPIC_API_KEY is set: the smoke run uses the subscription, never an API key", file=sys.stderr)
+        return 2
+    repo, spec, env = setup(base)
+    argv = agent_argv(spec)
+    if dry_run:
+        print(json.dumps({"cwd": str(repo), "argv": argv}, indent=1))
+        return 0
+    started = time.monotonic()
+    with open(base / "transcript.jsonl", "w") as out, open(base / "agent.stderr", "w") as err:
+        agent = subprocess.Popen(argv, cwd=repo, env=env, stdout=out, stderr=err, start_new_session=True)
+        try:
+            code, timed_out = agent.wait(timeout=LIMIT), False
+        except subprocess.TimeoutExpired:
+            code, timed_out = None, True
+        for sig in (15, 9):
+            try:
+                os.killpg(agent.pid, sig)
+            except ProcessLookupError:
+                break
+            time.sleep(1)
+    seconds = round(time.monotonic() - started, 1)
+    found = sessions(repo)
+    record = {
+        "cadence": subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture_output=True, text=True,
+                                  check=False).stdout.strip(),
+        "model": MODEL, "peer_model": PEER_MODEL, "seconds": seconds, "limit_seconds": LIMIT,
+        "timed_out": timed_out, "agent_exit": code,
+        "session_status": next((s.get("status") for s in found), None),
+        "hard_stop": next((s.get("hard_stop") for s in found if s.get("hard_stop")), None),
+        "open_block": open_block(repo, env),
+        "deliverable": deliverable(base, repo, env),
+    }
+    record["problems"] = judge(record)
+    record["ok"] = not record["problems"]
+    (base / "smoke.json").write_text(json.dumps(record, indent=1) + "\n", encoding="utf-8")
+    print(json.dumps(record, indent=1))
+    print(f"smoke: {'PASS' if record['ok'] else 'FAIL'} in {seconds} s (limit {LIMIT} s); sandbox {base}")
+    return 0 if record["ok"] else 1
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
+    ap.add_argument("--keep", type=Path, help="keep the sandbox in this new directory")
+    ap.add_argument("--dry-run", action="store_true", help="set up the sandbox and print the agent command only")
+    args = ap.parse_args(argv)
+    if args.keep:
+        args.keep.mkdir(parents=True, exist_ok=False)
+        return run(args.keep.resolve(), args.dry_run)
+    with tempfile.TemporaryDirectory(prefix="cadence-smoke-") as tmp:
+        return run(Path(tmp), args.dry_run)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
