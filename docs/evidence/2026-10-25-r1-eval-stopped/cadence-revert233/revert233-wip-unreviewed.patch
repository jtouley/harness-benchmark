+def _aggregator_step(rows: list[dict[str, Any]], open_row: dict[str, Any] | None,
+                     workspace: Path) -> dict[str, Any] | None:
+    """The code-review round (owner, 2026-10-25): R2 and R3 report on the reviewed diff, then R4 carries R1, R2 and
+    R3 in one PR review update, then one /spec-driven round fixes what it carries.
+
+    While a row of a round whose rows name a `report` fails, and every such report is written, the open block is
+    the round's aggregator (`aggregates` in stages.json) until its update carries the round and no must-fix row is
+    open. Then the walk goes on: a failing R2 or R3 runs again on the fixed tree. A round with no `report` rows
+    (the plan round: its aggregator P3 comes after it in the walk) is never redirected."""
+    name = open_row.get("round") if open_row else None
+    agg = next((r for r in rows if name and r.get("aggregates") == name), None)
+    members = [r for r in rows if name and r.get("round") == name]
+    if agg is None or not members or not all(r.get("report") for r in members):
+        return None
