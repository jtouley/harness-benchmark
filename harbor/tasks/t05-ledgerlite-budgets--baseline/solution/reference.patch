+"""Monthly category budgets."""
+
+import json
+import re
+from decimal import Decimal
+
+import pytest
+
+from ledgerlite import storage
+from ledgerlite.cli import main
+
+
+@pytest.fixture
+def cli(ledger, capsys):
+    """Call `main` on the fixture store. Return (exit code, stdout lines, stderr)."""
+
+    def call(*args: str):
+        capsys.readouterr()
+        code = main(["--store", str(ledger.store), *args])
+        captured = capsys.readouterr()
+        return code, captured.out.splitlines(), captured.err
+
+    return call
+
+
+@pytest.fixture
+def checking(ledger):
+    ledger("account", "add", "c")
+    return ledger
+
+
+def write_csv(ledger, text: str, name: str = "s.csv") -> str:
+    path = ledger.tmp / name
+    path.write_text(text)
+    return str(path)
+
+
+# --- Phase 1: budget set / budget list / storage -------------------------------
+
+
+def test_budget_set_stores_limit(ledger):
+    assert ledger("budget", "set", "groceries", "200") == ["set budget groceries 200.00"]
+    assert ledger("budget", "list") == ["groceries: 200.00"]
+
+
+def test_budget_list_sorted_two_decimals(ledger):
+    ledger("budget", "set", "rent", "1e3")
+    ledger("budget", "set", "groceries", "200.5")
+    ledger("budget", "set", "dining", "10.005")
+    assert ledger("budget", "list") == ["dining: 10.01", "groceries: 200.50", "rent: 1000.00"]
+
+
+def test_budget_list_empty(ledger):
+    assert ledger("budget", "list") == []
+
+
+def test_budget_set_overwrites(ledger):
+    ledger("budget", "set", "groceries", "200")
+    ledger("budget", "set", "groceries", "150")
+    assert ledger("budget", "list") == ["groceries: 150.00"]
+
+
+@pytest.mark.parametrize(
+    "category, limit",
+    [
+        ("groceries", "0"),
+        ("groceries", "-5"),
+        ("groceries", "abc"),
+        ("groceries", "NaN"),
+        ("groceries", "Infinity"),
+        ("groceries", "0.001"),
+        ("groceries", "1e30"),
+        ("", "10"),
+    ],
+)
+def test_budget_set_rejects_bad_limit(ledger, cli, category, limit):
+    code, out, err = cli("budget", "set", "--", category, limit)
+    assert code == 2
+    assert out == []
+    assert err.startswith("error: ")
+    assert ledger("budget", "list") == []
+
+
+def test_budget_set_too_large_limit_message(cli):
+    code, _, err = cli("budget", "set", "groceries", "1e30")
+    assert code == 2
+    assert "too large" in err
+
+
+@pytest.mark.parametrize("budgets", [None, ["x"], {"groceries": "abc"}, {"groceries": "NaN"}, {"groceries": "0"}])
+def test_store_with_bad_budgets_exits_2(ledger, cli, budgets):
+    ledger.store.write_text(json.dumps({"version": 1, "accounts": {}, "budgets": budgets}))
+    code, out, err = cli("budget", "list")
+    assert code == 2
+    assert out == []
+    assert "bad budgets" in err
