     return lines
+
+
+def spending(ledger: Ledger) -> dict[tuple[str, str], Decimal]:
+    """SPENT per (category, month) for budgeted categories, rounded half up to cents.
+
+    SPENT is the sum of the negative amounts as a positive number. Refunds do not
+    reduce it. A non-finite amount that a store holds is skipped.
+    """
+    totals: dict[tuple[str, str], Decimal] = defaultdict(lambda: Decimal("0"))
+    with localcontext() as ctx:
+        ctx.prec = BUDGET_PRECISION
+        for tx in ledger.all_transactions():
+            if tx.category in ledger.budgets and tx.amount.is_finite() and tx.amount < 0:
+                totals[(tx.category, tx.month)] -= tx.amount
+        return {key: total.quantize(CENT, rounding=ROUND_HALF_UP) for key, total in totals.items()}
+
+
+def budget(ledger: Ledger, month: str) -> list[str]:
+    spent = spending(ledger)
+    lines = []
+    for category, limit in sorted(ledger.budgets.items()):
+        amount = spent.get((category, month), Decimal("0.00"))
+        with localcontext() as ctx:
+            ctx.prec = BUDGET_PRECISION
+            pct = (amount / limit * 100).quantize(Decimal("1"), rounding=ROUND_HALF_UP)
+        line = f"{category}: spent {amount:.2f} of {limit:.2f} ({pct}%)"
+        lines.append(line + " OVER" if amount > limit else line)
+    return lines
+
+
+def budget_alerts(ledger: Ledger, before: dict[tuple[str, str], Decimal]) -> list[str]:
+    """One alert per (category, month) that went from at or under its limit to over it.
+
+    `before` is `spending(ledger)` from before the command. Sorted by month, then category.
+    """
+    after = spending(ledger)
+    crossed = [
+        (category, month)
+        for (category, month), spent in after.items()
+        if before.get((category, month), Decimal("0")) <= ledger.budgets[category] < spent
+    ]
+    return [
+        f"alert: {category} over budget for {month} ({after[(category, month)]:.2f}/{ledger.budgets[category]:.2f})"
+        for category, month in sorted(crossed, key=lambda key: (key[1], key[0]))
+    ]
