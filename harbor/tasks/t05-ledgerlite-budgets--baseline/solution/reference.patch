+# --- Phase 3: over-budget alerts ----------------------------------------------
+
+ADDED = re.compile(r"added [0-9a-f]{12}")
+
+
+def assert_added(lines: list[str], *alerts: str) -> None:
+    assert ADDED.fullmatch(lines[0])
+    assert lines[1:] == list(alerts)
+
+
+def test_tx_add_alert_on_crossing(budgeted):
+    assert_added(budgeted("tx", "add", "c", "2026-01-05", "-150", "groceries"))
+    assert_added(
+        budgeted("tx", "add", "c", "2026-01-06", "-60", "groceries"),
+        "alert: groceries over budget for 2026-01 (210.00/200.00)",
+    )
+
+
+def test_tx_add_no_alert_when_already_over(budgeted):
+    budgeted("tx", "add", "c", "2026-01-05", "-250", "groceries")
+    assert_added(budgeted("tx", "add", "c", "2026-01-06", "-10", "groceries"))
+
+
+def test_alert_when_before_equals_limit(budgeted):
+    assert_added(budgeted("tx", "add", "c", "2026-01-05", "-200.00", "groceries"))
+    assert_added(
+        budgeted("tx", "add", "c", "2026-01-06", "-10.00", "groceries"),
+        "alert: groceries over budget for 2026-01 (210.00/200.00)",
+    )
+
+
+def test_no_alert_when_after_equals_limit(budgeted):
+    budgeted("tx", "add", "c", "2026-01-05", "-150.00", "groceries")
+    assert_added(budgeted("tx", "add", "c", "2026-01-06", "-50.00", "groceries"))
+
+
+def test_no_alert_for_refund_or_unbudgeted_category(budgeted):
+    budgeted("tx", "add", "c", "2026-01-05", "-250", "dining")
+    assert_added(budgeted("tx", "add", "c", "2026-01-06", "-250", "dining"))
+    assert_added(budgeted("tx", "add", "c", "2026-01-06", "500", "groceries"))
+
+
+@pytest.mark.parametrize("on", ["20260110", "2026-W03-1"])
+def test_alert_month_from_basic_iso_date(budgeted, on):
