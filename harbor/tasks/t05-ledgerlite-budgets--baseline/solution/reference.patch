+def test_import_two_months_two_alerts(checking):
+    checking("budget", "set", "groceries", "100")
+    # CSV order puts February first. Only the month sort puts January first.
+    path = write_csv(checking, "date,amount,category\n2026-02-10,-150.00,groceries\n2026-01-10,-150.00,groceries\n")
+    assert checking("import", "c", path) == [
+        "imported 2 transactions",
+        "alert: groceries over budget for 2026-01 (150.00/100.00)",
+        "alert: groceries over budget for 2026-02 (150.00/100.00)",
+    ]
