+
+    def _refill(self):
+        now = self._clock()
+        elapsed = max(0.0, now - self._last)
+        self._last = now
+        self._tokens = min(float(self.capacity), self._tokens + elapsed * self.refill_rate)
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        if not isinstance(n, int) or isinstance(n, bool) or n < 1 or n > self.capacity:
+            raise ValueError("n must be an int between 1 and capacity")
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
