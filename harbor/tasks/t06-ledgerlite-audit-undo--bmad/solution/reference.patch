index 0000000..00865dd
--- /dev/null
+++ b/ledgerlite/audit.py
@@ -0,0 +1,83 @@
+"""Audit log: record each change to the ledger, print the log, and undo changes."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import datetime
+from decimal import Decimal
+from typing import Any
+
+from ledgerlite.models import AuditEntry, Ledger, LedgerError, Transaction
+
+Clock = Callable[[], datetime]
+
+
+def _field(text: str) -> str:
+    """One summary field on one line: collapse each whitespace run (newlines too) to one space."""
+    return " ".join(str(text).split())
+
+
+def record(ledger: Ledger, command: str, summary: str, change: dict[str, Any], now: Clock) -> AuditEntry:
+    seq = ledger.audit[-1].seq + 1 if ledger.audit else 1
+    entry = AuditEntry(seq, now().isoformat(timespec="seconds"), command, summary, change)
+    ledger.audit.append(entry)
+    return entry
+
+
+def record_account_add(ledger: Ledger, name: str, now: Clock) -> AuditEntry:
+    return record(ledger, "account add", _field(name), {"account": name}, now)
+
+
+def record_tx_add(ledger: Ledger, tx: Transaction, now: Clock) -> AuditEntry:
+    summary = " ".join(_field(f) for f in (tx.account, tx.on, _amount(tx.amount), tx.category))
+    return record(ledger, "tx add", summary, {"account": tx.account, "tx_ids": [tx.id]}, now)
+
+
+def record_import(ledger: Ledger, account: str, csv: str, added: list[Transaction], now: Clock) -> AuditEntry:
+    change = {"account": account, "csv": csv, "tx_ids": [t.id for t in added]}
+    return record(ledger, "import", f"{_field(account)} {len(added)} rows", change, now)
+
+
+def format_entry(entry: AuditEntry) -> str:
+    return f"{entry.seq} {entry.command} {entry.summary}"
+
+
+def undoable(ledger: Ledger) -> list[AuditEntry]:
+    """Entries that undo can still revert, oldest first. An undo entry is never undoable."""
+    undone = {seq for e in ledger.audit if e.command == "undo" for seq in e.change["reverted"]}
+    return [e for e in ledger.audit if e.command != "undo" and e.seq not in undone]
+
+
+def undo(ledger: Ledger, n: int, now: Clock) -> list[AuditEntry]:
+    """Revert the last ``n`` undoable entries, newest first, and record one undo entry.
+
+    Changes happen in memory only. The caller saves once, so a failure leaves the store as it was.
+    """
+    if n < 1:
+        raise LedgerError(f"undo needs a count of at least 1, got {n}")
+    candidates = undoable(ledger)
+    if len(candidates) < n:
+        noun = "change" if n == 1 else "changes"
+        raise LedgerError(f"cannot undo {n} {noun}: only {len(candidates)} can be undone")
+    targets = candidates[::-1][:n]
+    for entry in targets:
+        try:
+            _revert(ledger, entry)
+        except LedgerError as exc:
+            raise LedgerError(f"cannot undo {format_entry(entry)}: {exc}") from exc
+    reverted = [e.seq for e in targets]
+    record(ledger, "undo", " ".join(map(str, reverted)), {"reverted": reverted}, now)
+    return targets
+
+
+def _revert(ledger: Ledger, entry: AuditEntry) -> None:
+    if entry.command == "account add":
+        ledger.remove_account(entry.change["account"])
+    elif entry.command in ("tx add", "import"):
+        ledger.remove_transactions(entry.change["account"], entry.change["tx_ids"])
+    else:
+        raise LedgerError(f"unknown command {entry.command!r}")
+
+
+def _amount(amount: Decimal) -> str:
+    return format(amount, "f")
