+++ b/tests/test_audit.py
@@ -0,0 +1,342 @@
+import json
+from decimal import Decimal
+
+import pytest
+
+from ledgerlite import storage
+from ledgerlite.cli import main
+from ledgerlite.cli import run
+from ledgerlite.models import AuditEntry, Ledger, LedgerError, Transaction
+
+
+def test_audit_log_round_trips_through_save_and_load(tmp_path):
+    store = tmp_path / "ledger.json"
+    ledger = Ledger()
+    ledger.add_account("checking")
+    entries = [
+        AuditEntry(1, "2026-01-01T00:00:00+00:00", "account add", "checking", {"account": "checking"}),
+        AuditEntry(2, "2026-01-01T00:00:01+00:00", "undo", "1", {"reverted": [1]}),
+    ]
+    ledger.audit.extend(entries)
+    storage.save(ledger, store)
+    assert storage.load(store).audit == entries
+    assert json.loads(store.read_text())["version"] == 2
+
+
+def test_store_without_audit_key_loads_and_records_from_seq_1(ledger):
+    ledger.store.write_text(json.dumps({"version": 1, "accounts": {"checking": {"transactions": []}}}))
+    ledger("tx", "add", "checking", "2026-01-05", "-1", "x")
+    audit = json.loads(ledger.store.read_text())["audit"]
+    assert [e["seq"] for e in audit] == [1]
+
+
+TWO_ROWS = "date,amount,category,memo\n2026-01-01,-3.10,coffee,cafe\n2026-01-02,1200,salary,\n"
+
+
+def _tx_ids(ledger, account="checking"):
+    return [t["id"] for t in ledger.read_store()["accounts"][account]["transactions"]]
+
+
+MUTATIONS = {
+    "account add": lambda ledger: ledger("account", "add", "savings"),
+    "tx add": lambda ledger: ledger("tx", "add", "checking", "2026-01-05", "-42.50", "groceries", "corner shop"),
+    "import": lambda ledger: ledger("import", "checking", str(ledger.write_csv("s.csv", TWO_ROWS))),
+}
+
+
+@pytest.mark.parametrize("command", sorted(MUTATIONS))
+def test_each_mutating_command_appends_one_entry(ledger, command):
+    ledger("account", "add", "checking")
+    MUTATIONS[command](ledger)
+    assert [(e["seq"], e["command"]) for e in ledger.read_store()["audit"]] == [(1, "account add"), (2, command)]
+
+
+@pytest.mark.parametrize("command", sorted(MUTATIONS))
+def test_entry_holds_seq_iso_utc_timestamp_command_and_change(ledger, command):
+    ledger("account", "add", "checking")
+    MUTATIONS[command](ledger)
+    entry = ledger.read_store()["audit"][-1]
+    expected_change = {
+        "account add": {"account": "savings"},
+        "tx add": {"account": "checking", "tx_ids": _tx_ids(ledger)},
+        "import": {"account": "checking", "csv": str(ledger.tmp / "s.csv"), "tx_ids": _tx_ids(ledger)},
+    }[command]
+    assert entry["seq"] == 2
+    assert entry["at"] == "2026-10-09T12:00:00+00:00"
+    assert entry["command"] == command
+    assert entry["change"] == expected_change
+
+
+READ_ONLY = [("report", "balances"), ("report", "monthly", "2026-01"), ("audit",)]
+
+
+@pytest.mark.parametrize("args", READ_ONLY, ids=" ".join)
+def test_read_only_commands_append_no_entry(ledger, args):
+    ledger("account", "add", "checking")
+    before = ledger.store.read_bytes()
+    ledger(*args)
+    assert ledger.store.read_bytes() == before
+
+
+def test_report_keeps_existing_audit_log(ledger):
+    ledger("account", "add", "checking")
+    ledger("report", "balances")
+    assert [e["summary"] for e in ledger.read_store()["audit"]] == ["checking"]
+
+
+def test_report_on_missing_store_creates_no_file(ledger):
+    ledger("report", "balances")
+    assert not ledger.store.exists()
+
+
+def test_failed_mutating_command_appends_no_entry(ledger):
+    ledger("account", "add", "checking")
+    with pytest.raises(LedgerError):
+        ledger("account", "add", "checking")
+    assert len(ledger.read_store()["audit"]) == 1
+
+
+def test_empty_import_is_audited_with_zero_rows(ledger):
+    ledger("account", "add", "checking")
+    assert ledger("import", "checking", str(ledger.write_csv("e.csv", "date,amount,category\n"))) == ["imported 0 transactions"]
+    entry = ledger.read_store()["audit"][-1]
+    assert (entry["command"], entry["summary"], entry["change"]["tx_ids"]) == ("import", "checking 0 rows", [])
+
+
+def test_audit_prints_entries_oldest_first_in_seq_command_summary_form(ledger):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-42.50", "groceries", "corner shop")
+    ledger("tx", "add", "checking", "2026-01-06", "1e3", "salary")
+    ledger("import", "checking", str(ledger.write_csv("s.csv", TWO_ROWS)))
+    ledger("import", "checking", str(ledger.write_csv("e.csv", "date,amount,category\n")))
+    assert ledger("audit") == [
+        "1 account add checking",
+        "2 tx add checking 2026-01-05 -42.50 groceries",
+        "3 tx add checking 2026-01-06 1000 salary",
+        "4 import checking 2 rows",
+        "5 import checking 0 rows",
+    ]
+
+
+def test_tx_add_summary_leaves_out_memo(ledger):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-1", "x", "line one\nline two")
+    assert ledger("audit")[-1] == "2 tx add checking 2026-01-05 -1 x"
+
+
+def test_summary_fields_with_newlines_print_on_one_line(ledger):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-1", " eating\n out ")
+    assert ledger("audit")[-1] == "2 tx add checking 2026-01-05 -1 eating out"
+
+
+def test_audit_on_empty_log_prints_nothing(ledger):
+    assert ledger("audit") == []
+    assert not ledger.store.exists()
+
+
+def _accounts(ledger):
+    return {name: [t["id"] for t in a["transactions"]] for name, a in ledger.read_store()["accounts"].items()}
+
+
+def test_undo_reverts_most_recent_change(ledger):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-1", "x")
+    assert ledger("undo") == ["undid 2 tx add checking 2026-01-05 -1 x"]
+    assert _accounts(ledger) == {"checking": []}
+
+
+def test_undo_n_reverts_last_n_changes_newest_first(ledger):
+    ledger("account", "add", "checking")
+    ledger("import", "checking", str(ledger.write_csv("s.csv", TWO_ROWS)))
+    assert ledger("undo", "2") == ["undid 2 import checking 2 rows", "undid 1 account add checking"]
+    assert _accounts(ledger) == {}
+
+
+def test_undo_n_beyond_undoable_count_exits_2_and_keeps_store_bytes(ledger, capsys):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-1", "x")
+    ledger("undo")
+    before = ledger.store.read_bytes()
+    assert main(["--store", str(ledger.store), "undo", "2"]) == 2
+    assert ledger.store.read_bytes() == before
+    assert "cannot undo 2 changes: only 1 can be undone" in capsys.readouterr().err
+
+
+def test_undo_error_uses_singular_for_one_change(ledger):
+    with pytest.raises(LedgerError, match="cannot undo 1 change: only 0 can be undone"):
+        ledger("undo")
+
+
+def test_undo_of_import_removes_all_its_rows(ledger):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-1", "x")
+    kept = _accounts(ledger)["checking"]
+    ledger("import", "checking", str(ledger.write_csv("s.csv", TWO_ROWS)))
+    assert len(_accounts(ledger)["checking"]) == 3
+    ledger("undo")
+    assert _accounts(ledger) == {"checking": kept}
+
+
+def test_undo_appends_one_undo_entry_listing_reverted_seqs(ledger):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-1", "x")
+    ledger("import", "checking", str(ledger.write_csv("s.csv", TWO_ROWS)))
+    ledger("undo", "2")
+    entry = ledger.read_store()["audit"][-1]
+    assert (entry["seq"], entry["command"], entry["change"]) == (4, "undo", {"reverted": [3, 2]})
+    assert ledger("audit")[-1] == "4 undo 3 2"
+
+
+def test_second_undo_skips_undo_entries_and_reverts_next_change(ledger):
+    ledger("account", "add", "checking")
+    ledger("tx", "add", "checking", "2026-01-05", "-1", "x")
+    ledger("undo")
+    assert ledger("undo") == ["undid 1 account add checking"]
+    assert _accounts(ledger) == {}
+    assert ledger("audit")[2:] == ["3 undo 2", "4 undo 1"]
+
+
+def test_bare_undo_with_nothing_undoable_exits_2(ledger):
+    assert main(["--store", str(ledger.store), "undo"]) == 2
+    assert not ledger.store.exists()
+    ledger("account", "add", "checking")
+    ledger("undo")
+    before = ledger.store.read_bytes()
+    assert main(["--store", str(ledger.store), "undo"]) == 2
+    assert ledger.store.read_bytes() == before
+
+
+@pytest.mark.parametrize("n", ["0", "-1"])
+def test_undo_rejects_n_below_1(ledger, n):
+    ledger("account", "add", "checking")
+    with pytest.raises(LedgerError, match="at least 1"):
+        ledger("undo", n)
+    assert _accounts(ledger) == {"checking": []}
+
+
+def test_undo_rejects_non_integer_n(ledger):
+    with pytest.raises(SystemExit) as exc:
+        ledger("undo", "two")
+    assert exc.value.code == 2
+
+
+def _drop_first_imported_row(ledger):
+    data = ledger.read_store()
+    data["accounts"]["checking"]["transactions"].pop(0)
+    ledger.write_store(data)
+    return "cannot undo 2 import checking 2 rows: no transaction"
+
+
+def _drop_account(ledger):
+    data = ledger.read_store()
+    del data["accounts"]["checking"]
+    ledger.write_store(data)
+    return "cannot undo 1 account add checking: no account 'checking'"
+
+
+def _drop_account_of_tx(ledger):
+    data = ledger.read_store()
+    data["accounts"]["checking"]["transactions"].clear()
+    del data["accounts"]["checking"]
+    ledger.write_store(data)
+    return "cannot undo 2 tx add checking 2026-01-05 -1 x: no account 'checking'"
+
+
+def _rename_command(ledger):
+    data = ledger.read_store()
+    data["audit"][0]["command"] = "account rename"
+    ledger.write_store(data)
+    return "cannot undo 1 account rename checking: unknown command 'account rename'"
+
+
+def _add_row_by_hand(ledger):
+    data = ledger.read_store()
+    data["accounts"]["checking"]["transactions"].append(
+        {"id": "handmade0001", "on": "2026-01-01", "amount": "1", "category": "x", "memo": ""}
+    )
+    ledger.write_store(data)
+    return "cannot undo 1 account add checking: account 'checking' still holds transactions"
+
+
+@pytest.mark.parametrize(
+    "setup, edit",
+    [
+        (lambda l: l("import", "checking", str(l.write_csv("s.csv", TWO_ROWS))), _drop_first_imported_row),
+        (lambda l: None, _drop_account),
+        (lambda l: None, _add_row_by_hand),
+        (lambda l: l("tx", "add", "checking", "2026-01-05", "-1", "x"), _drop_account_of_tx),
+        (lambda l: None, _rename_command),
+    ],
+    ids=[
+        "missing transaction",
+        "missing account",
+        "account holds transactions",
+        "missing account of transaction",
+        "unknown command",
+    ],
+)
+def test_undo_fails_when_target_does_not_match_store_and_changes_nothing(ledger, setup, edit):
+    ledger("account", "add", "checking")
+    setup(ledger)
+    message = edit(ledger)
+    before = ledger.store.read_bytes()
+    with pytest.raises(LedgerError, match=message):
+        ledger("undo")
+    assert ledger.store.read_bytes() == before
+
+
+def test_undo_never_reverts_rows_from_before_the_log(ledger):
+    row = {"id": "legacy000001", "on": "2026-01-01", "amount": "5", "category": "x", "memo": ""}
+    ledger.write_store({"version": 1, "accounts": {"checking": {"transactions": [row]}}})
+    with pytest.raises(LedgerError, match="only 0 can be undone"):
+        ledger("undo")
+    assert _accounts(ledger) == {"checking": ["legacy000001"]}
+
+
+def test_undo_after_new_change_reverts_the_new_change(ledger):
+    ledger("account", "add", "a")
+    ledger("undo")
+    ledger("account", "add", "b")
+    assert ledger("undo") == ["undid 3 account add b"]
+    assert _accounts(ledger) == {}
+
+
+def test_remove_transactions_checks_every_id_before_it_removes_any():
+    ledger = Ledger()
+    ledger.add_account("checking")
+    tx = ledger.add_transaction(Transaction("checking", "2026-01-01", Decimal("1"), "x"))
+    with pytest.raises(LedgerError, match="no transaction 'missing'"):
+        ledger.remove_transactions("checking", [tx.id, "missing"])
+    assert ledger.account("checking").transactions == [tx]
+
