+def test_default_clock_writes_utc_timestamp_in_seconds(tmp_path):
+    store = tmp_path / "ledger.json"
+    run(["--store", str(store), "account", "add", "checking"])
+    at = json.loads(store.read_text())["audit"][0]["at"]
+    assert at.endswith("+00:00")
+    assert len(at) == len("2026-10-09T12:00:00+00:00")
+
+
+def test_new_entry_seq_follows_last_seq_not_log_length(ledger):
+    ledger("account", "add", "a")
+    ledger("account", "add", "b")
+    data = ledger.read_store()
+    del data["audit"][0]
+    ledger.write_store(data)
+    ledger("account", "add", "c")
+    assert [e["seq"] for e in ledger.read_store()["audit"]] == [2, 3]
+
+
+@pytest.mark.parametrize(
+    "audit",
+    [None, [{"seq": 1}], [{"seq": 1, "at": "x", "command": "undo", "summary": "", "change": None}]],
+    ids=["null log", "entry missing keys", "change not an object"],
+)
+def test_malformed_audit_log_is_a_ledger_error(ledger, audit):
+    ledger.write_store({"version": 2, "accounts": {}, "audit": audit})
+    before = ledger.store.read_bytes()
+    with pytest.raises(LedgerError, match="bad audit log"):
+        ledger("audit")
+    assert ledger.store.read_bytes() == before
