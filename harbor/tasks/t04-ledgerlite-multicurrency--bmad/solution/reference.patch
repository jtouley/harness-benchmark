     def all_transactions(self) -> list[Transaction]:
         return [t for a in self.accounts.values() for t in a.transactions]
+
+    def set_rate(self, source: str, target: str, rate: Decimal) -> tuple[str, str]:
+        """Store 1 source = rate target. Return the normalized (source, target) pair."""
+        source, target = normalize_currency(source), normalize_currency(target)
+        if source == target:
+            raise LedgerError(f"a rate from {source} to {target} is not allowed")
+        if not rate.is_finite() or rate <= 0:
+            raise LedgerError(f"bad rate {rate}: use a number greater than 0")
+        self.rates[(source, target)] = rate
+        return source, target
+
+    def rate(self, source: str, target: str) -> Decimal:
+        """1 source = rate target. Direct pair first, then the inverse of the reverse pair."""
+        if source == target:
+            return Decimal("1")
+        if (source, target) in self.rates:
+            return self.rates[(source, target)]
+        if (target, source) in self.rates:
+            return Decimal("1") / self.rates[(target, source)]
+        raise LedgerError(f"no exchange rate from {source} to {target}: run 'rate set {source} {target} RATE'")
+
+    def convert(self, amount: Decimal, source: str, target: str) -> Decimal:
+        return amount * self.rate(source, target)
