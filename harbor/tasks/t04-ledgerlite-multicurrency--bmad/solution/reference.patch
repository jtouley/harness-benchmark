+DEFAULT_CURRENCY = "USD"
+_CURRENCY_CODE = re.compile(r"[A-Z]{3}")
+
 
 class LedgerError(ValueError):
     """A user-facing error: bad input or an impossible operation."""
 
 
+def normalize_currency(code: str) -> str:
+    """Return the upper-case three-letter code, or raise LedgerError."""
+    normalized = str(code).strip().upper()
+    if not _CURRENCY_CODE.fullmatch(normalized):
+        raise LedgerError(f"bad currency {code!r}: use a three-letter code such as USD")
+    return normalized
+
