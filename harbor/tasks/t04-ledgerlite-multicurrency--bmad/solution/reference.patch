index 0000000..c8e4d2b
--- /dev/null
+++ b/tests/test_currency.py
@@ -0,0 +1,253 @@
+"""Multi-currency: model rules, storage, CLI, reports, and CSV import."""
+
+import json
+from decimal import Decimal
+
+import pytest
+
+from ledgerlite import storage
+from ledgerlite.cli import main
+from ledgerlite.models import Ledger, LedgerError, normalize_currency
+
+
+# --- model: codes and rates (D1, D2, D3) -------------------------------------
+
+
+def test_normalize_currency_uppercases_valid_code():
+    assert normalize_currency(" eur ") == "EUR"
+
+
+@pytest.mark.parametrize("code", ["EURO", "EU", "E1R", "", "€UR"])
+def test_normalize_currency_rejects_non_three_letter_code(code):
+    with pytest.raises(LedgerError, match="bad currency"):
+        normalize_currency(code)
+
+
+def test_add_account_defaults_to_usd_and_accepts_currency():
+    ledger = Ledger()
+    assert ledger.add_account("checking").currency == "USD"
+    assert ledger.add_account("savings", "eur").currency == "EUR"
+
+
+def test_rate_same_currency_is_one_without_stored_rate():
+    assert Ledger().rate("EUR", "EUR") == Decimal("1")
+
+
+def test_rate_uses_direct_then_inverse_of_reverse():
+    ledger = Ledger()
+    ledger.set_rate("EUR", "USD", Decimal("1.25"))
+    assert ledger.rate("EUR", "USD") == Decimal("1.25")
+    assert ledger.rate("USD", "EUR") == Decimal("0.8")
+
+
+def test_rate_direct_wins_over_reverse_when_both_stored():
+    ledger = Ledger()
+    ledger.set_rate("EUR", "USD", Decimal("1.10"))
+    ledger.set_rate("USD", "EUR", Decimal("0.5"))
+    assert ledger.rate("USD", "EUR") == Decimal("0.5")
+    assert ledger.rate("EUR", "USD") == Decimal("1.10")
+
+
+def test_rate_missing_pair_names_both_currencies():
+    with pytest.raises(LedgerError, match="no exchange rate from GBP to USD"):
+        Ledger().rate("GBP", "USD")
+
+
+def test_set_rate_rejects_same_currency_pair():
+    with pytest.raises(LedgerError, match="USD"):
+        Ledger().set_rate("USD", "usd", Decimal("2"))
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "NaN", "sNaN", "Infinity"])
+def test_set_rate_rejects_non_positive_or_non_finite(value):
+    with pytest.raises(LedgerError, match="bad rate"):
+        Ledger().set_rate("EUR", "USD", Decimal(value))
+
+
+# --- storage (D8) ---------------------------------------------------------------
+
+
+def test_storage_round_trips_currency_and_rates(tmp_path):
+    path = tmp_path / "l.json"
+    ledger = Ledger()
+    ledger.add_account("savings", "EUR")
+    ledger.set_rate("EUR", "USD", Decimal("1.10"))
+    storage.save(ledger, path)
+
+    loaded = storage.load(path)
+
+    assert loaded.account("savings").currency == "EUR"
+    assert loaded.rates == {("EUR", "USD"): Decimal("1.10")}
+    assert json.loads(path.read_text())["version"] == 2
+
+
+def test_storage_loads_v1_file_as_usd(ledger):
+    ledger.store.write_text(
+        json.dumps(
+            {
+                "version": 1,
+                "accounts": {
+                    "checking": {
+                        "transactions": [
+                            {"id": "a1", "on": "2026-01-05", "amount": "-42.50", "category": "food", "memo": ""}
+                        ]
+                    }
+                },
+            }
+        )
+    )
+    checking = storage.load(ledger.store).account("checking")
+    assert (checking.currency, checking.balance()) == ("USD", Decimal("-42.50"))
+    assert ledger("report", "balances") == ["checking: -42.50 USD", "TOTAL: -42.50 USD"]
+
+
+def test_storage_load_reads_hand_edited_json_number_rate_exactly(tmp_path):
+    path = tmp_path / "l.json"
+    path.write_text('{"version": 2, "accounts": {}, "rates": {"EUR/USD": 1.1}}')
+    assert storage.load(path).rates == {("EUR", "USD"): Decimal("1.1")}
+
+
+@pytest.mark.parametrize(
+    ("rates", "accounts", "message"),
+    [
+        ({"EURUSD": "1.10"}, {}, "expected FROM/TO"),
+        ({"EUR/USD": "0"}, {}, "bad rate"),
+        ({"EUR/USD": "abc"}, {}, "bad stored rate"),
+        ({}, {"s": {"currency": "EURO", "transactions": []}}, "bad currency"),
+        ({"EUR/USD": None}, {}, "bad stored rate"),
+        ({"EUR/USD": True}, {}, "bad stored rate"),
+        (["EUR/USD", "1.10"], {}, "expected an object"),
+    ],
+    ids=[
+        "rate-key-without-slash",
+        "zero-rate",
+        "non-numeric-rate",
+        "bad-account-currency",
+        "null-rate",
+        "boolean-rate",
+        "rates-not-object",
+    ],
+)
+def test_storage_load_rejects_bad_stored_values(tmp_path, rates, accounts, message):
+    path = tmp_path / "l.json"
+    path.write_text(json.dumps({"version": 2, "accounts": accounts, "rates": rates}))
+    with pytest.raises(LedgerError, match=message):
+        storage.load(path)
+
+
+# --- CLI: accounts and rates (A1-A4) ---------------------------------------------
+
+
+def test_cli_account_add_stores_default_and_given_currency(ledger):
+    ledger("account", "add", "checking")
+    assert ledger("account", "add", "savings", "--currency", "eur") == ["added account savings (EUR)"]
+    loaded = storage.load(ledger.store)
+    assert (loaded.account("checking").currency, loaded.account("savings").currency) == ("USD", "EUR")
+
+
+def test_cli_account_add_rejects_bad_currency_with_exit_2(ledger, capsys):
+    assert main(["--store", str(ledger.store), "account", "add", "x", "--currency", "EURO"]) == 2
+    assert "bad currency" in capsys.readouterr().err
+    assert not ledger.store.exists()
+
+
+def test_cli_rate_set_prints_and_persists_rate(ledger):
+    assert ledger("rate", "set", "eur", "usd", "1.10") == ["rate EUR USD 1.10"]
+    assert storage.load(ledger.store).rates == {("EUR", "USD"): Decimal("1.10")}
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "abc", "NaN", "Infinity"])
+def test_cli_rate_set_rejects_bad_rate_with_exit_2(ledger, capsys, value):
+    assert main(["--store", str(ledger.store), "rate", "set", "EUR", "USD", value]) == 2
+    assert "bad rate" in capsys.readouterr().err
+
+
+# --- reports with a base currency (A7-A12, A17, A18) -------------------------------
+
+
+def two_currency_ledger(ledger, *, rate: str | None = "1.10"):
+    """checking: -42.50 USD (Jan). savings: 100 EUR (Jan). Optional EUR->USD rate."""
+    ledger("account", "add", "checking")
+    ledger("account", "add", "savings", "--currency", "EUR")
+    ledger("tx", "add", "checking", "2026-01-05", "-42.50", "groceries")
+    ledger("tx", "add", "savings", "2026-01-06", "100", "interest")
+    if rate is not None:
+        ledger("rate", "set", "EUR", "USD", rate)
+    return ledger
+
+
+def test_balances_show_account_currency_and_total_in_usd(ledger):
+    two_currency_ledger(ledger)
+    assert ledger("report", "balances") == ["checking: -42.50 USD", "savings: 100.00 EUR", "TOTAL: 67.50 USD"]
+
+
+def test_balances_missing_rate_exits_2_and_names_both_currencies(ledger, capsys):
+    two_currency_ledger(ledger, rate=None)
+    assert main(["--store", str(ledger.store), "report", "balances"]) == 2
+    assert "no exchange rate from EUR to USD" in capsys.readouterr().err
+
+
+def test_balances_missing_rate_needed_for_zero_balance_account(ledger):
+    ledger("account", "add", "checking")
+    ledger("account", "add", "travel", "--currency", "GBP")
+    with pytest.raises(LedgerError, match="no exchange rate from GBP to USD"):
+        ledger("report", "balances")
+
+
+def test_balances_base_uses_inverse_of_stored_rate(ledger):
+    two_currency_ledger(ledger, rate="1.25")
+    # -42.50 USD * (1 / 1.25) = -34.00 EUR, plus 100.00 EUR.
+    assert ledger("report", "balances", "--base", "eur")[-1] == "TOTAL: 66.00 EUR"
+
+
+@pytest.mark.parametrize("report", [["balances"], ["monthly", "2026-01"]])
+def test_reports_reject_bad_base_with_exit_2(ledger, capsys, report):
+    two_currency_ledger(ledger)
+    assert main(["--store", str(ledger.store), "report", *report, "--base", "EURO"]) == 2
+    assert "bad currency" in capsys.readouterr().err
+
+
+def test_monthly_converts_to_base_and_keeps_line_format(ledger):
+    two_currency_ledger(ledger)
+    ledger("tx", "add", "savings", "2026-01-20", "-10", "groceries")
+    # groceries: -42.50 USD + (-10 EUR * 1.10) = -53.50. interest: 100 EUR * 1.10 = 110.00.
+    assert ledger("report", "monthly", "2026-01") == ["groceries: -53.50", "interest: 110.00", "NET: 56.50"]
+    assert ledger("report", "monthly", "2026-01", "--base", "EUR") == [
+        "groceries: -48.64",
+        "interest: 100.00",
+        "NET: 51.36",
+    ]
+
+
+def test_monthly_needs_no_rate_for_currency_absent_from_month(ledger):
+    two_currency_ledger(ledger, rate=None)
+    ledger("tx", "add", "checking", "2026-02-01", "-5", "groceries")
+    assert ledger("report", "monthly", "2026-02") == ["groceries: -5.00", "NET: -5.00"]
+
+
+# --- CSV currency column (A13-A16) -------------------------------------------------
+
+
+def import_rows(ledger, rows: str) -> list[str]:
+    ledger("account", "add", "savings", "--currency", "EUR")
+    csv = ledger.tmp / "s.csv"
+    csv.write_text("date,amount,category,currency\n" + rows)
+    return ledger("import", "savings", str(csv))
+
+
+def test_import_accepts_matching_or_empty_currency_any_case(ledger):
+    assert import_rows(ledger, "2026-01-01,10,a,EUR\n2026-01-02,5,b,eur\n2026-01-03,1,c,\n") == [
+        "imported 3 transactions"
+    ]
+    assert ledger("report", "balances", "--base", "EUR") == ["savings: 16.00 EUR", "TOTAL: 16.00 EUR"]
+
+
+def test_import_rejects_other_currency_and_keeps_store_unchanged(ledger):
+    with pytest.raises(LedgerError, match=r"line 3: .*USD.*EUR"):
+        import_rows(ledger, "2026-01-01,10,a,EUR\n2026-01-02,5,b,USD\n")
+    assert storage.load(ledger.store).account("savings").transactions == []
+
+
+def test_import_rejects_bad_currency_code_with_line_number(ledger):
+    with pytest.raises(LedgerError, match="line 2: bad currency"):
+        import_rows(ledger, "2026-01-01,10,a,EURO\n")
