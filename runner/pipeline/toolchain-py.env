# The P1 and P2 toolchain, given to the agent and to the grader's make (runner/entrypoint.sh).
# Python 3.12 and every pinned package come from the image's warm uv cache; uv never goes online.
PATH=/opt/hb/bin:/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
UV_CACHE_DIR=/opt/hb/cache/uv
UV_PYTHON_INSTALL_DIR=/opt/hb/python
UV_PYTHON_DOWNLOADS=never
UV_OFFLINE=1
UV_LINK_MODE=copy
TZ=UTC
