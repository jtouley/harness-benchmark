# The P3 toolchain (P1's plus the JVM side), given to the agent and to the grader's make.
# JDK 17, sbt and Python 3.12 are in the image; Spark, Scala and ScalaTest come from the warm coursier
# and ivy caches, and the dbt-spark closure from the wheelhouse (pip never reads an index).
PATH=/opt/hb/bin:/opt/java/openjdk/bin:/opt/sbt/bin:/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
JAVA_HOME=/opt/java/openjdk
UV_CACHE_DIR=/opt/hb/cache/uv
UV_PYTHON_INSTALL_DIR=/opt/hb/python
UV_PYTHON_DOWNLOADS=never
UV_OFFLINE=1
UV_LINK_MODE=copy
COURSIER_CACHE=/opt/hb/cache/coursier
COURSIER_MODE=offline
SBT_OPTS=-Dsbt.ivy.home=/opt/hb/cache/ivy -Dsbt.boot.directory=/opt/hb/cache/sbt-boot -Dsbt.global.base=/opt/hb/cache/sbt-global -Dsbt.server.forcestart=false -Dsbt.offline=true -Xss4m
PIP_CACHE_DIR=/opt/hb/cache/pip
PIP_NO_INDEX=1
PIP_FIND_LINKS=/opt/hb/wheelhouse
PIP_DISABLE_PIP_VERSION_CHECK=1
TZ=UTC
