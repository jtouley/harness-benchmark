@@ -0,0 +1,34 @@
+"""Registries keyed by kind: sources by `kind`, transforms by `engine`, sinks by `kind` (decision cd-1-engine-interface)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import pyarrow as pa
+
+
+def _no_checkpoint(point: str) -> None:
+    return None
+
+
+@dataclass
+class RunContext:
+    lake_dir: Path
+    run_id: str
+    checkpoint: Callable[[str], None] = _no_checkpoint
+    deadline: float | None = None  # time.monotonic() value at which a stream source stops
+
+
+def as_table(value: pa.Table | pa.RecordBatchReader) -> pa.Table:
+    """Batch readers are read to the end here. A stream sink reads them batch by batch instead."""
+    if isinstance(value, pa.RecordBatchReader):
+        return value.read_all()
+    return value
+
+
+SOURCES: dict[str, Callable[[dict[str, Any], RunContext], pa.Table]] = {}
+TRANSFORMS: dict[str, Callable[[dict[str, Any], list[pa.Table]], pa.Table]] = {}
+SINKS: dict[str, Callable[[dict[str, Any], pa.Table, RunContext], None]] = {}
