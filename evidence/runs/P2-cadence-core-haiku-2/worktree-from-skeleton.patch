+import sys
+import time
+import uuid
+from pathlib import Path
+
+from engine.config import PipelineInvalid, load_pipeline, validate_file
+from engine.core import run_pipeline
+
+LAKE_DIR = Path("lake")
+USAGE = (
+    "usage: python -m engine <command> [args]\n"
+    "  validate <pipeline.yml>\n"
+    "  run <pipeline.yml> [--duration SECONDS]\n"
+)
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) == 2 and argv[0] == "validate":
+        try:
+            problems = validate_file(Path(argv[1]))
+        except OSError as exc:
+            sys.stdout.write(f"{argv[1]}:1:1: cannot read file: {exc.strerror}\n")
+            return 1
+        for problem in problems:
+            sys.stdout.write(f"{problem}\n")
+        return 1 if problems else 0
+    if argv and argv[0] == "run":
+        return _run(argv[1:])
+    sys.stderr.write(USAGE)
+    return 2
+
+
+def _run(args: list[str]) -> int:
+    if len(args) not in (1, 3) or (len(args) == 3 and args[1] != "--duration"):
+        sys.stderr.write(USAGE)
+        return 2
+    duration = float(args[2]) if len(args) == 3 else None
+    try:
+        config = load_pipeline(Path(args[0]))
+    except PipelineInvalid as exc:
+        for problem in exc.problems:
+            sys.stdout.write(f"{problem}\n")
+        return 1
+    deadline = time.monotonic() + duration if duration is not None else None
+    run_pipeline(config, lake_dir=LAKE_DIR, run_id=uuid.uuid4().hex, deadline=deadline)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
