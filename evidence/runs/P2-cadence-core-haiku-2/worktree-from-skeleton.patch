+-- Check 5: edits and net bytes per wiki, human and bot, for the replayed hour (the first 3600 s of event time
+-- in the lake). Late events are included.
+with hour as (
+    select min(timestamp) as start_ts
+    from read_parquet('lake/stream_recentchange/*.parquet')
+)
+select
+    r.wiki,
+    case when r.bot then 'bot' else 'human' end as actor_type,
+    count(*) as edits,
+    sum(r.net_bytes) as net_bytes
+from read_parquet('lake/stream_recentchange/*.parquet') r
+cross join hour h
+where r.is_edit
+  and r.timestamp >= h.start_ts
+  and r.timestamp < h.start_ts + 3600
+group by r.wiki, actor_type
+order by r.wiki, actor_type;
