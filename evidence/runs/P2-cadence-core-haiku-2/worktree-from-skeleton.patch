+"""sitematrix_json: one row per wiki. Groups' `site` lists and the `specials` list together make the 1073 wikis."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pyarrow as pa
+
+from engine.registry import SOURCES, RunContext
+from engine.sources.base import SourceError
+
+
+def sitematrix_json(entry: dict, ctx: RunContext) -> pa.Table:
+    path = Path(entry["path"])
+    if not path.is_file():
+        raise SourceError(f"{path}: sitematrix file not found")
+    matrix = json.loads(path.read_text(encoding="utf-8"))["sitematrix"]
+    sites: list[tuple[str, dict]] = []
+    for key, group in matrix.items():
+        if key in ("count", "specials"):
+            continue
+        sites.extend((group["code"], site) for site in group.get("site", []))
+    sites.extend((special["lang"], special) for special in matrix.get("specials", []))
