+        "language_code": pa.array([lang for lang, _ in sites], pa.string()),
+        "project": pa.array([s["code"] for _, s in sites], pa.string()),
+        "url": pa.array([s["url"] for _, s in sites], pa.string()),
+        "closed": pa.array([bool(s.get("closed", False)) for _, s in sites], pa.bool_()),
+        "_source_file": pa.array([str(path)] * len(sites), pa.string()),
+        "_source_row": pa.array(range(1, len(sites) + 1), pa.int64()),
+    })
