diff --git a/transform/models/stream/mart_wiki_window_5min.sql b/transform/models/stream/mart_wiki_window_5min.sql
new file mode 100644
index 0000000..491089b
--- /dev/null
+++ b/transform/models/stream/mart_wiki_window_5min.sql
@@ -0,0 +1,55 @@
+-- Grain: window_start x wiki x namespace x actor_type, on-time edits only.
+-- Incremental (decision cd-1-stream-commit, MF-4 and MF-6). A run:
+--   1. selects the grain keys of fact rows with arrival_seq above the mark and not late,
+--      where the mark is the largest last_arrival_seq already in this table (0 on the first run);
+--   2. recomputes those keys from all on-time fact rows;
+--   3. deletes the old rows of those keys and inserts the recomputed ones (delete+insert).
+-- An increment with no such keys changes nothing.
+{{ config(
+    materialized='incremental',
+    incremental_strategy='delete+insert',
+    unique_key=['window_start', 'wiki', 'namespace', 'actor_type'],
+    tags=['stream'],
+    post_hook=["copy (select * from {{ this }}) to '" ~ var('marts_dir') ~ "/mart_wiki_window_5min.parquet' (format parquet)"]
+) }}
+
+with on_time as (
+    select * from {{ ref('stream_edit_fact') }}
+    where not is_late
+),
+{% if is_incremental() %}
+mark as (
+    select coalesce(max(last_arrival_seq), 0) as seq from {{ this }}
+),
+touched as (
+    select distinct f.window_start, f.wiki, f.namespace, f.actor_type
+    from {{ ref('stream_edit_fact') }} f
+    cross join mark
+    where f.arrival_seq > mark.seq
+      and not f.is_late
+),
+changed as (
+    select o.*
+    from on_time o
+    join touched t
+      on t.window_start = o.window_start
+     and t.wiki = o.wiki
+     and t.namespace = o.namespace
+     and t.actor_type = o.actor_type
+)
+{% else %}
+changed as (
+    select * from on_time
+)
+{% endif %}
+select
+    md5(cast(window_start as varchar) || '|' || wiki || '|' || cast(namespace as varchar) || '|' || actor_type) as window_key,
+    window_start,
+    wiki,
+    namespace,
+    actor_type,
+    cast(count(*) as bigint) as edit_count,
+    cast(sum(net_bytes) as bigint) as net_bytes_added,
+    cast(max(arrival_seq) as bigint) as last_arrival_seq
+from changed
+group by window_start, wiki, namespace, actor_type
diff --git a/transform/models/stream/stream_edit_fact.sql b/transform/models/stream/stream_edit_fact.sql
new file mode 100644
index 0000000..529ef1c
--- /dev/null
+++ b/transform/models/stream/stream_edit_fact.sql
@@ -0,0 +1,25 @@
+-- One row per consumed edit, on time or late (decision cd-1-event-identity).
+-- Incremental on arrival_seq: each run reads only the rows above the largest arrival_seq already present.
+{{ config(
+    materialized='incremental',
+    incremental_strategy='delete+insert',
+    unique_key='meta_id',
+    tags=['stream']
+) }}
+
+select
+    meta_id,
+    wiki,
+    namespace,
+    case when bot then 'bot' else 'human' end as actor_type,
+    window_start,
+    net_bytes,
+    is_late,
+    arrival_seq,
+    timestamp,
+    type
+from {{ source('lake', 'stream_recentchange') }}
+where is_edit
+{% if is_incremental() %}
+  and arrival_seq > (select coalesce(max(arrival_seq), 0) from {{ this }})
+{% endif %}
