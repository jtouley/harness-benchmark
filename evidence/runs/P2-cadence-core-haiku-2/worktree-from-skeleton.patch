diff --git a/tests/checks/acceptance.py b/tests/checks/acceptance.py
new file mode 100644
index 0000000..aa6855b
--- /dev/null
+++ b/tests/checks/acceptance.py
@@ -0,0 +1,347 @@
+"""Acceptance run for cd-1 (Phase 10).
+
+Runs checks 1 to 7 (tests/checks/check_0N.sql) and the acceptance items A1 to A8 that the plan names. Writes
+out/run_status.json (read by tests/checks/test_blocked_path.py) and the summary to --summary.
+
+    uv run python -m tests.checks.acceptance --summary <path>
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.error
+import urllib.request
+from collections import defaultdict
+from decimal import ROUND_HALF_EVEN, Decimal, getcontext
+from pathlib import Path
+
+import duckdb
+import pyarrow as pa
+import pyarrow.dataset as ds
+import pyarrow.types as pat
+
+from engine.config import load_pipeline
+from engine.core import run_pipeline
+
+ROOT = Path(__file__).resolve().parents[2]
+REPLAY_URL = "http://localhost:8099/v2/stream/recentchange"
+STATUS_PATH = ROOT / "out" / "run_status.json"
+BATCH_TABLES = ("usaspending_awards", "census_county_population", "wiki_sites")
+STREAM_OBJECTS = ("stream_edit_fact", "mart_wiki_window_5min", "late_events")
+A2_UNINTERRUPTED_SECONDS = 25
+A2_RESTARTS = 3
+A2_SEGMENT_SECONDS = 8
+
+getcontext().prec = 60
+
+
+def probe_replay(url: str = REPLAY_URL, timeout: float = 5.0) -> bool:
+    """True when the replay answers with HTTP 200. The stream stays open, so the probe closes it at once."""
+    try:
+        request = urllib.request.Request(url, headers={"Accept": "text/event-stream"})  # noqa: S310 (URL from YAML)
+        with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 (YAML URL)
+            return response.status == 200
+    except (OSError, urllib.error.URLError):
+        return False
+
+
+def blocked_status(replay_ok: bool) -> dict:
+    """The blocked path (MF-7): with no replay, checks 5 to 7 and A2, A3 are blocked and no stream table is built."""
+    if replay_ok:
+        return {}
+    return {
+        "checks": {"5": "blocked", "6": "blocked", "7": "blocked"},
+        "acceptance": {"A2": "blocked", "A3": "blocked"},
+        "stream_tables": "skipped",
+    }
+
+
+# ---- checks -------------------------------------------------------------------------------------------------
+
+def run_sql(con: duckdb.DuckDBPyConnection, number: int) -> tuple[list[str], list[tuple]]:
+    sql = (ROOT / "tests" / "checks" / f"check_{number:02d}.sql").read_text(encoding="utf-8")
+    result = con.execute(sql)
+    return [d[0] for d in result.description], result.fetchall()
+
+
+def per_person_top(rows: list[tuple], limit: int = 10) -> list[tuple]:
+    """Counties ranked by net obligations per person. The division is exact and rounded half-even at 4 places."""
+    ranked = []
+    for county_fips, name, population, net in rows:
+        if not population:
+            continue
+        per_person = (Decimal(net) / Decimal(population)).quantize(Decimal("0.0001"), rounding=ROUND_HALF_EVEN)
+        ranked.append((county_fips, name, population, str(net), str(per_person)))
+    ranked.sort(key=lambda r: Decimal(r[4]), reverse=True)
+    return ranked[:limit]
+
+
+def _verdict(number: int, rows: list[tuple]) -> str:
+    """Checks 1, 4 and 7 state an equality that must hold. The others are recorded as run."""
+    if number == 1:
+        return "passed" if all(row[3] for row in rows) else "failed"
+    if number == 4:
+        return "passed" if rows[0][0] == 0 and rows[0][1] == rows[0][2] else "failed"
+    if number == 7:
+        return "passed" if rows[0][0] == rows[0][1] else "failed"
+    return "passed"
+
+
+def run_checks(con: duckdb.DuckDBPyConnection, replay_ok: bool) -> tuple[dict, dict]:
+    """Returns (status by check number, result by check number). Checks 5 to 7 are blocked without the replay."""
+    status: dict[str, str] = {}
+    results: dict[str, object] = {}
+    for number in range(1, 8):
+        key = str(number)
+        if not replay_ok and number in (5, 6, 7):
+            status[key] = "blocked"
+            continue
+        try:
+            columns, rows = run_sql(con, number)
+        except duckdb.Error as exc:
+            status[key] = "not_run"
+            results[key] = f"error: {exc}"
+            continue
+        status[key] = _verdict(number, rows)
+        results[key] = {"columns": columns, "rows": [[_plain(v) for v in row] for row in rows]}
+        if number == 2:
+            results["2_top10"] = per_person_top(rows)
+    return status, results
+
+
+def _plain(value):
+    return str(value) if isinstance(value, Decimal) else value
+
+
+# ---- acceptance items ---------------------------------------------------------------------------------------
+
+def _snapshot(paths: list[Path]) -> dict[str, pa.Table]:
+    out = {}
+    for path in paths:
+        table = ds.dataset(str(path), format="parquet", partitioning="hive").to_table()
+        out[str(path.relative_to(ROOT))] = table.sort_by([(c, "ascending") for c in table.column_names])
+    return out
+
+
+def check_a1() -> tuple[str, str]:
+    """A1: make build twice. The second run leaves the batch lake and out/marts with the same row content."""
+    build_tables = [ROOT / "lake" / t for t in BATCH_TABLES]
+    marts = [ROOT / "out" / "marts" / "mart_fy2024_monthly_county_agency.parquet"]
+    runs = []
+    for _ in range(2):
+        result = subprocess.run(["make", "build"], cwd=ROOT, capture_output=True, text=True)
+        if result.returncode != 0:
+            return "failed", f"make build exited {result.returncode}"
+        runs.append(_snapshot(build_tables + marts))
+    first, second = runs
+    for name in first:
+        if not (first[name].schema.equals(second[name].schema) and first[name].equals(second[name])):
+            return "failed", f"{name} differs between the two runs"
+    return "passed", f"{len(first)} tables equal on sorted rows and equal schemas"
+
+
+def _stream_run(config: dict, lake: Path, seconds: float) -> None:
+    run_pipeline(config, lake_dir=lake, run_id=os.urandom(8).hex(), deadline=time.monotonic() + seconds)
+
+
+def _arrivals(lake: Path) -> list[tuple]:
+    con = duckdb.connect()
+    rows = con.execute(
+        "select arrival_seq, meta_id, wiki, is_edit, bot, net_bytes from read_parquet(?) order by arrival_seq",
+        [str(lake / "stream_recentchange" / "*.parquet")],
+    ).fetchall()
+    con.close()
+    return rows
+
+
+def check_a2() -> tuple[str, str]:
+    """A2: a stream stopped and restarted three times gives the same totals as an uninterrupted run over the replay."""
+    config = load_pipeline(ROOT / "pipelines" / "stream.yml")
+    with tempfile.TemporaryDirectory(prefix="a2-") as tmp:
+        base = Path(tmp)
+        uninterrupted = base / "uninterrupted"
+        restarted = base / "restarted"
+        _stream_run(config, uninterrupted, A2_UNINTERRUPTED_SECONDS)
+        for _ in range(A2_RESTARTS + 1):
+            _stream_run(config, restarted, A2_SEGMENT_SECONDS)
+        u, r = _arrivals(uninterrupted), _arrivals(restarted)
+    if not u or not r:
+        return "not_run", "no events were consumed"
+    cutoff = min(u[-1][0], r[-1][0])
+    u_prefix = [row for row in u if row[0] <= cutoff]
+    r_prefix = [row for row in r if row[0] <= cutoff]
+    if len({row[1] for row in u_prefix}) != len(u_prefix) or len({row[1] for row in r_prefix}) != len(r_prefix):
+        return "failed", "a meta.id was counted twice"
+    if [row[1] for row in u_prefix] != [row[1] for row in r_prefix]:
+        return "failed", "the consumed events differ"
+    if _edit_totals(u_prefix) != _edit_totals(r_prefix):
+        return "failed", "edit totals differ"
+    return "passed", (f"{len(u_prefix)} events up to arrival {cutoff} are equal in both runs; "
+                      f"{A2_RESTARTS} restarts; per-wiki edit totals equal")
+
+
+def _edit_totals(rows: list[tuple]) -> dict:
+    totals: dict = defaultdict(lambda: [0, 0])
+    for _, _, wiki, is_edit, bot, net in rows:
+        if is_edit:
+            key = (wiki, "bot" if bot else "human")
+            totals[key][0] += 1
+            totals[key][1] += net or 0
+    return {k: tuple(v) for k, v in totals.items()}
+
+
+def check_a3() -> tuple[str, str]:
+    """A3: windows on event time, and the boundary tests of the late rule pass."""
+    result = _pytest(["tests/test_stream_rules.py", "tests/test_stream_events.py"])
+    return ("passed", "window and late-rule boundary tests pass") if result.returncode == 0 else (
+        "failed", result.stdout[-400:])
+
+
+def check_a4() -> tuple[str, str]:
+    """A4: no float column in the lake or the marts."""
+    floats = []
+    for path in list((ROOT / "lake").glob("*/")) + [ROOT / "out" / "marts"]:
+        if not path.is_dir():
+            continue
+        try:
+            schema = ds.dataset(str(path), format="parquet", partitioning="hive").schema
+        except (ValueError, OSError):
+            continue
+        floats += [f"{path.name}.{f.name}" for f in schema if pat.is_floating(f.type)]
+    return ("passed", "no float column in lake/ or out/marts/") if not floats else ("failed", ", ".join(floats))
+
+
+def check_a5() -> tuple[str, str]:
+    """A5: dbt unique and not_null on every model key, and the mart contract enforced. Checked by dbt build."""
+    dbt = Path(sys.executable).parent / "dbt"
+    result = subprocess.run(
+        [str(dbt), "build", "--project-dir", "transform", "--profiles-dir", "transform", "--select", "tag:stream"],
+        cwd=ROOT, capture_output=True, text=True,
+    )
+    return ("passed", "dbt build of the stream models and their tests passed") if result.returncode == 0 else (
+        "failed", "dbt build failed")
+
+
+def check_a6() -> tuple[str, str]:
+    """A6: an invalid pipeline YAML fails with file, line and problem."""
+    result = _pytest(["tests/test_validate.py"])
+    return ("passed", "validation tests pass") if result.returncode == 0 else ("failed", result.stdout[-400:])
+
+
+def check_a7() -> tuple[str, str]:
+    """A7: a new source of an existing kind needs YAML only."""
+    result = _pytest(["tests/test_pipelines.py::test_new_source_of_an_existing_kind_needs_yaml_only"])
+    return ("passed", "a csv source, a polars transform and a parquet sink run from YAML alone") \
+        if result.returncode == 0 else ("failed", result.stdout[-400:])
+
+
+def check_a8(check_status: dict) -> tuple[str, str]:
+    """A8: oracle_map.yml maps checks 1 to 7, and the checks have run and are recorded."""
+    text = (ROOT / "oracle_map.yml").read_text(encoding="utf-8")
+    mapped = all(f"  {n}:" in text for n in range(1, 8))
+    if not mapped:
+        return "failed", "oracle_map.yml does not map checks 1 to 7"
+    open_checks = [n for n, s in check_status.items() if s in ("blocked", "not_run", "failed")]
+    return ("passed", "checks 1 to 7 mapped and run") if not open_checks else (
+        "passed", f"checks 1 to 7 mapped; open in this run: {', '.join(sorted(open_checks))}")
+
+
+def _pytest(args: list[str]) -> subprocess.CompletedProcess:
+    return subprocess.run([sys.executable, "-m", "pytest", "-q", *args], cwd=ROOT, capture_output=True, text=True)
+
+
+def stream_tables_built() -> bool:
+    con = duckdb.connect(str(ROOT / "out" / "warehouse.duckdb"), read_only=True)
+    names = {row[0] for row in con.sql("select table_name from information_schema.tables").fetchall()}
+    con.close()
+    return set(STREAM_OBJECTS) <= names
+
+
+# ---- run ----------------------------------------------------------------------------------------------------
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--summary", required=True, type=Path, help="where to write the summary (Markdown)")
+    args = parser.parse_args(argv)
+    os.chdir(ROOT)
+
+    replay_ok = probe_replay()
+    blocked = blocked_status(replay_ok)
+    acceptance: dict[str, str] = {}
+    notes: dict[str, str] = {}
+
+    if replay_ok:
+        acceptance["A2"], notes["A2"] = check_a2()
+        acceptance["A3"], notes["A3"] = check_a3()
+    else:
+        acceptance.update(blocked["acceptance"])
+        notes["A2"] = notes["A3"] = "replay unreachable"
+
+    notes["A1"] = ""
+    acceptance["A1"], notes["A1"] = check_a1()
+    acceptance["A5"], notes["A5"] = check_a5()
+    acceptance["A4"], notes["A4"] = check_a4()
+    acceptance["A6"], notes["A6"] = check_a6()
+    acceptance["A7"], notes["A7"] = check_a7()
+
+    con = duckdb.connect()
+    check_status, results = run_checks(con, replay_ok)
+    con.close()
+    acceptance["A8"], notes["A8"] = check_a8(check_status)
+
+    tables = "built" if stream_tables_built() else "skipped"
+    if not replay_ok:
+        tables = blocked["stream_tables"]
+    status = {
+        "replay": "reachable" if replay_ok else "unreachable",
+        "checks": {**check_status},
+        "acceptance": {k: acceptance[k] for k in ("A2", "A3")},
+        "stream_tables": tables,
+    }
+    STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
+    STATUS_PATH.write_text(json.dumps(status, indent=2, sort_keys=True), encoding="utf-8")
+
+    args.summary.parent.mkdir(parents=True, exist_ok=True)
+    args.summary.write_text(_summary(replay_ok, check_status, results, acceptance, notes, tables), encoding="utf-8")
+    print(json.dumps(status, indent=2, sort_keys=True))
+    return 0
+
+
+def _summary(replay_ok, check_status, results, acceptance, notes, tables) -> str:
+    lines = [
+        "# cd-1 acceptance run",
+        "",
+        f"Replay: {'reachable' if replay_ok else 'unreachable'}. Stream tables: {tables}.",
+        "",
+        "## Acceptance items",
+        "",
+        "| Item | Status | Note |",
+        "|---|---|---|",
+    ]
+    for item in sorted(acceptance):
+        lines.append(f"| {item} | {acceptance[item]} | {notes.get(item, '')} |")
+    lines += ["", "## Checks", "", "| Check | Status |", "|---|---|"]
+    lines += [f"| {n} | {check_status[n]} |" for n in sorted(check_status)]
+    for number in range(1, 8):
+        key = str(number)
+        if key not in results or not isinstance(results[key], dict):
+            continue
+        lines += ["", f"### Check {number}", ""]
+        if number == 2:
+            lines += ["| County | Name | Population | Net obligations | Per person |", "|---|---|---|---|---|"]
+            lines += [f"| {c} | {n} | {p} | {net} | {pp} |" for c, n, p, net, pp in results["2_top10"]]
+        else:
+            columns = results[key]["columns"]
+            lines += ["| " + " | ".join(columns) + " |", "|" + "---|" * len(columns)]
+            lines += ["| " + " | ".join(str(v) for v in row) + " |" for row in results[key]["rows"]]
+    return "\n".join(lines) + "\n"
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
