+++ b/tests/helpers.py
@@ -0,0 +1,87 @@
+"""Small fixture inputs and helpers for the engine and dbt tests."""
+
+import io
+import json
+import os
+import subprocess
+import sys
+import zipfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+DBT = Path(sys.executable).parent / "dbt"
+
+
+CONTRACT_HEADER = [
+    "contract_transaction_unique_key", "contract_award_unique_key", "modification_number", "action_date",
+    "action_date_fiscal_year", "awarding_agency_code", "awarding_agency_name",
+    "prime_award_transaction_recipient_state_fips_code", "prime_award_transaction_recipient_county_fips_code",
+    "recipient_county_name", "federal_action_obligation",
+]
+ASSISTANCE_HEADER = [
+    "assistance_transaction_unique_key" if c == "contract_transaction_unique_key"
+    else "assistance_award_unique_key" if c == "contract_award_unique_key" else c
+    for c in CONTRACT_HEADER
+]
+
+
+def _award(prefix, n, amount, county="09001", date="2024-03-01"):
+    return ["t-" + prefix + str(n), prefix + str(n), "0", date, "2024", "417", "NEA", "09", county,
+            "Hartford", amount]
+
+
+def write_fixture_repo(root: Path) -> None:
+    """Write small inputs at the paths that pipelines/build.yml names, relative to the run directory."""
+    usa = root / "data" / "raw" / "usaspending"
+    usa.mkdir(parents=True)
+    contracts = csv_text(CONTRACT_HEADER, [
+        _award("C", 1, "10.00"), _award("C", 2, "-4.25", county=""), _award("C", 3, "0.03", county="01003"),
+    ])
+    assistance = csv_text(ASSISTANCE_HEADER, [_award("A", 1, "20.50", county="09003", date="2024-05-02")])
+    for name, header_text in [("FY2024_417_Contracts_Full.zip", contracts),
+                              ("FY2024_417_Assistance_Full.zip", assistance)]:
+        with zipfile.ZipFile(usa / name, "w") as zf:
+            zf.writestr(name.replace(".zip", ".csv"), header_text.encode("utf-8"))
+    census = root / "data" / "raw" / "census"
+    census.mkdir(parents=True)
+    head = ["SUMLEV", "STATE", "COUNTY", "STNAME", "CTYNAME", "POPESTIMATE2020", "POPESTIMATE2021",
+            "POPESTIMATE2022", "POPESTIMATE2023", "POPESTIMATE2024"]
+    (census / "co-est2024-alldata.csv").write_bytes(("\n".join([
+        ",".join(head),
+        "050,09,110,Connecticut,Capitol,30,31,32,33,34",
+        "050,01,001,Alabama,Autauga,10,11,12,13,14",
+        "050,01,003,Alabama,Baldwin,1,2,3,4,8",
+    ]) + "\n").encode("latin-1"))
+    (census / "co-est2021-alldata.csv").write_bytes(("\n".join([
+        ",".join(head),
+        "050,09,001,Connecticut,Fairfield,40,41,,,",
+    ]) + "\n").encode("latin-1"))
+    (root / "data" / "raw" / "sitematrix.json").write_text(json.dumps({"sitematrix": {
+        "count": 1,
+        "0": {"code": "aa", "name": "Afar", "site": [
+            {"url": "https://aa.wikipedia.org", "dbname": "aawiki", "code": "wiki", "closed": False}]},
+    }}), encoding="utf-8")
+
+
+def csv_text(header, rows) -> str:
+    buf = io.StringIO()
+    buf.write(",".join(header) + "\n")
+    for row in rows:
+        buf.write(",".join(row) + "\n")
+    return buf.getvalue()
+
+
+def run_dbt(lake: Path, marts: Path, warehouse: Path, *, select: str | None = None,
+            exclude: str | None = None, full_refresh: bool = False) -> subprocess.CompletedProcess:
+    """Run `dbt build` on the transform project with the given lake, marts directory and warehouse file."""
+    env = {**os.environ, "WAREHOUSE_PATH": str(warehouse)}
+    variables = json.dumps({"lake_dir": str(lake), "marts_dir": str(marts)})
+    command = [str(DBT), "build", "--project-dir", str(ROOT / "transform"), "--profiles-dir",
+               str(ROOT / "transform"), "--vars", variables]
+    if select:
+        command += ["--select", select]
+    if exclude:
+        command += ["--exclude", exclude]
+    if full_refresh:
+        command.append("--full-refresh")
+    return subprocess.run(command, cwd=ROOT, env=env, capture_output=True, text=True)
