+from engine.registry import RunContext
+from engine.sources.census import census_county_population
+
+HEADER = ["SUMLEV", "STATE", "COUNTY", "STNAME", "CTYNAME", "POPESTIMATE2020", "POPESTIMATE2021",
+          "POPESTIMATE2022", "POPESTIMATE2023", "POPESTIMATE2024"]
+
+
+def _write(path, rows):
+    lines = [",".join(HEADER)] + [",".join(r) for r in rows]
+    path.write_bytes(("\n".join(lines) + "\n").encode("latin-1"))
+    return path
+
+
+def test_long_table_from_2024_and_fallback_only_for_counties_missing_from_2024(tmp_path):
+    f2024 = _write(tmp_path / "co-est2024.csv", [
+        ["040", "01", "000", "Alabama", "Alabama", "1", "2", "3", "4", "5"],
+        ["050", "01", "001", "Alabama", "Autauga", "10", "11", "12", "13", "14"],
+        ["050", "01", "003", "Alabama", "Baldwin", "20", "21", "22", "23", "24"],
+        ["050", "09", "110", "Connecticut", "Capitol PR", "30", "31", "32", "33", "34"],
+    ])
+    f2021 = _write(tmp_path / "co-est2021.csv", [
+        ["050", "01", "001", "Alabama", "Autauga", "10", "11", "", "", ""],
+        ["050", "09", "001", "Connecticut", "Fairfield", "40", "41", "", "", ""],
+    ])
+    entry = {"name": "pop", "kind": "census_county_population", "path": str(f2024), "fallback_path": str(f2021)}
+
+    table = census_county_population(entry, RunContext(lake_dir=tmp_path, run_id="r1"))
+
+    rows = table.to_pylist()
+    fips = {r["county_fips"] for r in rows}
+    assert fips == {"01001", "01003", "09110", "09001"}
+    assert "01000" not in fips
+
+    autauga = sorted((r["year"], r["population"]) for r in rows if r["county_fips"] == "01001")
+    assert autauga == [(2020, 10), (2021, 11), (2022, 12), (2023, 13), (2024, 14)]
+
+    fallback = {r["year"] for r in rows if r["county_fips"] == "09001"}
+    assert fallback == {2020, 2021}
+    names = {r["county_fips"]: (r["state_name"], r["county_name"]) for r in rows}
+    assert names["09110"] == ("Connecticut", "Capitol PR")
+    assert {r["_source_file"] for r in rows if r["county_fips"] == "01001"} == {str(f2024)}
+    assert {r["_source_file"] for r in rows if r["county_fips"] == "09001"} == {str(f2021)}
