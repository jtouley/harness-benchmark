@@ -0,0 +1,99 @@
+import subprocess
+from pathlib import Path
+
+import pyarrow as pa
+import pyarrow.dataset as ds
+import pyarrow.types as pat
+
+from engine.config import load_pipeline, validate_file
+from engine.core import run_pipeline
+from tests.helpers import write_fixture_repo
+
+ROOT = Path(__file__).resolve().parents[1]
+BUILD = ROOT / "pipelines" / "build.yml"
+STREAM = ROOT / "pipelines" / "stream.yml"
+
+def _read_sorted(path: Path) -> pa.Table:
+    table = ds.dataset(str(path), format="parquet", partitioning="hive").to_table()
+    return table.sort_by([(name, "ascending") for name in table.column_names])
+
+
+def _build(lake: Path):
+    return run_pipeline(load_pipeline(BUILD), lake_dir=lake, run_id="r")
+
+
+def test_pipeline_files_validate():
+    assert validate_file(BUILD) == []
+    assert validate_file(STREAM) == []
+
+
+def test_make_stream_without_duration_fails_with_a_message():
+    result = subprocess.run(["make", "stream"], cwd=ROOT, capture_output=True, text=True)
+    assert result.returncode != 0
+    assert "DURATION" in result.stderr
+
+
+def test_make_stream_runs_the_engine_for_the_duration():
+    result = subprocess.run(["make", "-n", "stream", "DURATION=5"], cwd=ROOT, capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
+    assert "python -m engine run pipelines/stream.yml --duration 5" in result.stdout
+
+
+def test_make_build_twice_lake_equal(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    write_fixture_repo(tmp_path)
+    lake = tmp_path / "lake"
+
+    _build(lake)
+    first = {p.name: _read_sorted(p) for p in sorted(lake.iterdir()) if not p.name.startswith(".")}
+    _build(lake)
+    second = {p.name: _read_sorted(p) for p in sorted(lake.iterdir()) if not p.name.startswith(".")}
+
+    assert set(first) == {"usaspending_awards", "census_county_population", "wiki_sites"}
+    assert first.keys() == second.keys()
+    for name in first:
+        assert first[name].schema == second[name].schema, name
+        assert first[name].equals(second[name]), name
+
+
+def test_build_keeps_money_as_decimal_and_dates_as_dates(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    write_fixture_repo(tmp_path)
+    _build(tmp_path / "lake")
+
+    awards = _read_sorted(tmp_path / "lake" / "usaspending_awards")
+    assert awards.schema.field("federal_action_obligation").type == pa.decimal128(18, 2)
+    assert pat.is_date32(awards.schema.field("action_date").type)
+    assert pat.is_int32(awards.schema.field("action_date_fiscal_year").type)
+    assert sorted(awards.column("award_key").to_pylist()) == ["A1", "C1", "C2", "C3"]
+
+
+def test_new_source_of_an_existing_kind_needs_yaml_only(tmp_path, monkeypatch):
+    """A7: a csv source, a polars transform and a parquet sink, all from YAML, run with no Python change."""
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "counties.csv").write_text("fips,amount\n1001,5.25\n", encoding="utf-8")
+    pipeline = tmp_path / "extra.yml"
+    pipeline.write_text(
+        "sources:\n"
+        "  - name: extra_counties\n"
+        "    kind: csv\n"
+        "    path: counties.csv\n"
+        "transforms:\n"
+        "  - name: padded\n"
+        "    engine: polars\n"
+        "    inputs: [extra_counties]\n"
+        "    op: normalize_fips\n"
+        "    columns: [fips]\n"
+        "sinks:\n"
+        "  - name: lake_extra\n"
+        "    kind: parquet_lake\n"
+        "    inputs: [padded]\n"
+        "    table: extra_counties\n",
+        encoding="utf-8",
+    )
+
+    run_pipeline(load_pipeline(pipeline), lake_dir=tmp_path / "lake", run_id="r")
+
+    table = _read_sorted(tmp_path / "lake" / "extra_counties")
+    assert table.column("fips").to_pylist() == ["01001"]
+    assert table.column("amount").to_pylist() == ["5.25"]
