@@ -0,0 +1,53 @@
+import pyarrow as pa
+import pytest
+
+from engine.core import PipelineError, run_pipeline
+
+
+def _config(sink_inputs):
+    return {
+        "sources": [{"name": "raw", "kind": "csv", "path": "x.csv"}],
+        "transforms": [{"name": "clean", "engine": "polars", "inputs": ["raw"], "op": "identity"}],
+        "sinks": [{"name": "lake", "kind": "parquet_lake", "inputs": sink_inputs, "table": "awards"}],
+    }
+
+
+def _table():
+    return pa.table({"id": [1, 2]})
+
+
+def test_steps_run_in_dependency_order(tmp_path):
+    order = []
+
+    def source(entry, ctx):
+        order.append(entry["name"])
+        return _table()
+
+    def transform(entry, inputs):
+        order.append(entry["name"])
+        return inputs[0]
+
+    def sink(entry, table, ctx):
+        order.append(entry["name"])
+
+    run_pipeline(
+        _config(["clean"]),
+        lake_dir=tmp_path / "lake",
+        run_id="r1",
+        sources={"csv": source},
+        transforms={"polars": transform},
+        sinks={"parquet_lake": sink},
+    )
+    assert order == ["raw", "clean", "lake"]
+
+
+def test_unknown_input_is_rejected(tmp_path):
+    with pytest.raises(PipelineError, match="missing"):
+        run_pipeline(
+            _config(["missing"]),
+            lake_dir=tmp_path / "lake",
+            run_id="r1",
+            sources={"csv": lambda entry, ctx: _table()},
+            transforms={"polars": lambda entry, inputs: inputs[0]},
+            sinks={"parquet_lake": lambda entry, table, ctx: None},
+        )
