@@ -0,0 +1,43 @@
+"""Blocked path (MF-7, MF-8): with no replay, checks 5 to 7, A2 and A3 are blocked and no stream table is built."""
+
+import json
+from pathlib import Path
+
+import duckdb
+
+from tests.checks import acceptance
+
+ROOT = Path(__file__).resolve().parents[2]
+STATUS = ROOT / "out" / "run_status.json"
+STREAM_OBJECTS = {"stream_edit_fact", "mart_wiki_window_5min", "late_events"}
+
+
+def test_blocked_status_names_checks_5_to_7_and_a2_a3():
+    blocked = acceptance.blocked_status(replay_ok=False)
+    assert blocked["checks"] == {"5": "blocked", "6": "blocked", "7": "blocked"}
+    assert blocked["acceptance"] == {"A2": "blocked", "A3": "blocked"}
+    assert blocked["stream_tables"] == "skipped"
+
+
+def test_probe_reports_an_unreachable_replay():
+    assert acceptance.probe_replay("http://127.0.0.1:9/v2/stream/recentchange", timeout=1.0) is False
+
+
+def test_blocked_path_status():
+    status = json.loads(STATUS.read_text(encoding="utf-8"))
+    values = set(status["checks"].values()) | set(status["acceptance"].values())
+    assert values <= {"passed", "blocked", "not_run", "failed"}
+
+    warehouse = duckdb.connect(str(ROOT / "out" / "warehouse.duckdb"), read_only=True)
+    names = {row[0] for row in warehouse.sql("select table_name from information_schema.tables").fetchall()}
+    warehouse.close()
+
+    if status["replay"] == "reachable":
+        assert status["stream_tables"] == "built"
+        assert STREAM_OBJECTS <= names
+        assert "passed" in set(status["checks"].values())
+    else:
+        assert status["checks"]["5"] == status["checks"]["6"] == status["checks"]["7"] == "blocked"
+        assert status["acceptance"] == {"A2": "blocked", "A3": "blocked"}
+        assert status["stream_tables"] == "skipped"
+        assert not (STREAM_OBJECTS & names)
