new file mode 100644
index 0000000..97fc6b9
--- /dev/null
+++ b/engine/transforms/datafusion_sql.py
@@ -0,0 +1,25 @@
+"""engine: datafusion. `sql` is the query text in the YAML; each input is a table named after its step."""
+
+from __future__ import annotations
+
+import pyarrow as pa
+from datafusion import SessionContext
+
+from engine.registry import TRANSFORMS
+from engine.transforms.base import TransformError
+
+
+def datafusion_transform(entry: dict, inputs: list[pa.Table]) -> pa.Table:
+    name = entry["name"]
+    if len(entry["inputs"]) != len(inputs):
+        raise TransformError(f"step '{name}': input count does not match its inputs")
+    ctx = SessionContext()
+    for input_name, table in zip(entry["inputs"], inputs, strict=True):
+        ctx.from_arrow(table, input_name)
+    try:
+        return ctx.sql(entry["sql"]).to_arrow_table()
+    except Exception as exc:  # DataFusion raises its own error types; the step name is what the user needs.
+        raise TransformError(f"step '{name}': sql failed: {exc}") from None
+
+
+TRANSFORMS["datafusion"] = datafusion_transform
diff --git a/engine/transforms/polars_ops.py b/engine/transforms/polars_ops.py
new file mode 100644
index 0000000..a233a7b
--- /dev/null
+++ b/engine/transforms/polars_ops.py
@@ -0,0 +1,49 @@
+"""engine: polars. `op` names a registered dataframe step; `columns` lists the columns it works on."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+import polars as pl
+import pyarrow as pa
+
+from engine.registry import TRANSFORMS
+from engine.transforms.base import TransformError, arrow_strings
+
+
+def _blank_to_null(expr: pl.Expr) -> pl.Expr:
+    stripped = expr.str.strip_chars()
+    return pl.when(stripped == "").then(None).otherwise(stripped)
+
+
+def normalize_fips(df: pl.DataFrame, columns: list[str]) -> pl.DataFrame:
+    return df.with_columns([_blank_to_null(pl.col(c)).str.zfill(5).alias(c) for c in columns])
+
+
+def parse_date(df: pl.DataFrame, columns: list[str]) -> pl.DataFrame:
+    return df.with_columns([
+        _blank_to_null(pl.col(c)).str.to_date("%Y-%m-%d", strict=True).alias(c) for c in columns
+    ])
+
+
+OPS: dict[str, Callable[[pl.DataFrame, list[str]], pl.DataFrame]] = {
+    "normalize_fips": normalize_fips,
+    "parse_date": parse_date,
+}
+
+
+def polars_transform(entry: dict, inputs: list[pa.Table]) -> pa.Table:
+    name, op = entry["name"], entry["op"]
+    if op not in OPS:
+        raise TransformError(f"step '{name}': unknown polars op '{op}'")
+    if len(inputs) != 1:
+        raise TransformError(f"step '{name}': polars op takes one input, got {len(inputs)}")
+    columns = entry.get("columns", [])
+    try:
+        out = OPS[op](pl.from_arrow(inputs[0]), columns)
+    except (pl.exceptions.PolarsError, ValueError, TypeError) as exc:
+        raise TransformError(f"step '{name}': {op} failed: {exc}") from None
+    return arrow_strings(out.to_arrow())
+
+
+TRANSFORMS["polars"] = polars_transform
