@@ -0,0 +1,127 @@
+import pyarrow as pa
+import pyarrow.parquet as pq
+import pytest
+
+from engine.lake import Crash
+from engine.registry import RunContext
+from engine.sources.sse import SSE_SCHEMA
+from engine.stream_sink import stream_lake_sink
+from engine.stream_state import newest_manifest
+
+ENTRY = {"name": "stream_recentchange", "kind": "stream_lake", "table": "stream_recentchange", "inputs": []}
+
+
+def event(meta_id, timestamp, type_="edit", old=100, new=120):
+    return {
+        "sse_id": f"id-{meta_id}", "meta_id": meta_id, "timestamp": timestamp, "wiki": "enwiki",
+        "namespace": 0, "bot": False, "type": type_,
+        "length_old": old, "length_new": new,
+    }
+
+
+def batch(events):
+    return pa.RecordBatch.from_pylist(events, schema=SSE_SCHEMA)
+
+
+def sink(lake, batches, checkpoint=None):
+    ctx = RunContext(lake_dir=lake, run_id="r", checkpoint=checkpoint or (lambda point: None))
+    stream_lake_sink(ENTRY, batches, ctx)
+
+
+def raw_rows(lake):
+    rows = []
+    for path in sorted((lake / "stream_recentchange").glob("batch-*.parquet")):
+        rows.extend(pq.read_table(path).to_pylist())
+    return rows
+
+
+def late_rows(lake):
+    rows = []
+    for path in sorted((lake / "late_events").glob("late-*.parquet")):
+        rows.extend(pq.read_table(path).to_pylist())
+    return rows
+
+
+def crash_on(point):
+    def checkpoint(name):
+        if name == point:
+            raise Crash(name)
+    return checkpoint
+
+
+def test_restart_drops_redelivered_committed_event(tmp_path):
+    lake = tmp_path / "lake"
+    sink(lake, [batch([event("A", 1000), event("B", 1010)])])
+    sink(lake, [batch([event("B", 1010), event("C", 1020)])])
+
+    assert sorted(r["meta_id"] for r in raw_rows(lake)) == ["A", "B", "C"]
+    assert newest_manifest(lake, "stream_recentchange")["duplicates_dropped"] == 1
+
+
+def test_restart_keeps_redelivered_uncommitted_event_once(tmp_path):
+    lake = tmp_path / "lake"
+    sink(lake, [batch([event("A", 1000)])])
+    with pytest.raises(Crash):
+        sink(lake, [batch([event("C", 1020)])], checkpoint=crash_on("after_data"))
+    sink(lake, [batch([event("C", 1020), event("D", 1030)])])
+
+    assert sorted(r["meta_id"] for r in raw_rows(lake)) == ["A", "C", "D"]
+
+
+def test_duplicate_does_not_move_the_watermark(tmp_path):
+    lake = tmp_path / "lake"
+    sink(lake, [batch([event("A", 100)])])
+    sink(lake, [batch([event("A", 5000)])])
+
+    assert newest_manifest(lake, "stream_recentchange")["watermark"] == 100
+
+
+def test_arrival_sequence_follows_arrival_order(tmp_path):
+    lake = tmp_path / "lake"
+    sink(lake, [batch([event("A", 1000), event("B", 900), event("C", 1100)])])
+
+    rows = raw_rows(lake)
+    assert [r["arrival_seq"] for r in rows] == [1, 2, 3]
+    assert newest_manifest(lake, "stream_recentchange")["arrival_seq"] == 3
+
+
+def test_event_at_the_late_boundary_is_on_time_and_one_past_it_is_late(tmp_path):
+    # Event B: timestamp 1000, window_end 1200, so the bound is 1800.
+    lake_on = tmp_path / "on"
+    sink(lake_on, [batch([event("A", 1800), event("B", 1000)])])
+    lake_late = tmp_path / "late"
+    sink(lake_late, [batch([event("A", 1801), event("B", 1000)])])
+
+    on_time = {r["meta_id"]: r["is_late"] for r in raw_rows(lake_on)}
+    assert on_time == {"A": False, "B": False}
+    assert late_rows(lake_on) == []
+
+    late = {r["meta_id"]: r["is_late"] for r in raw_rows(lake_late)}
+    assert late == {"A": False, "B": True}
+    assert [r["meta_id"] for r in late_rows(lake_late)] == ["B"]
+
+
+def test_out_of_order_event_within_the_bound_stays_on_time(tmp_path):
+    lake = tmp_path / "lake"
+    sink(lake, [batch([event("A", 1700), event("B", 1000)])])
+
+    assert {r["meta_id"]: r["is_late"] for r in raw_rows(lake)} == {"A": False, "B": False}
+
+
+def test_watermark_is_the_highest_first_arrival_and_survives_a_restart(tmp_path):
+    lake = tmp_path / "lake"
+    sink(lake, [batch([event("A", 1801)])])
+    sink(lake, [batch([event("B", 1000)])])
+
+    assert newest_manifest(lake, "stream_recentchange")["watermark"] == 1801
+    assert [r["is_late"] for r in raw_rows(lake)] == [False, True]
+
+
+def test_edit_fields_are_written_per_row(tmp_path):
+    lake = tmp_path / "lake"
+    sink(lake, [batch([event("E", 1000, "edit", 100, None), event("K", 1000, "categorize", None, None)])])
+
+    rows = {r["meta_id"]: r for r in raw_rows(lake)}
+    assert rows["E"]["is_edit"] is True and rows["E"]["net_bytes"] == -100
+    assert rows["K"]["is_edit"] is False and rows["K"]["net_bytes"] is None
+    assert rows["E"]["window_start"] == 900 and rows["E"]["window_end"] == 1200
diff --git a/tests/test_stream_lake.py b/tests/test_stream_lake.py
new file mode 100644
index 0000000..d73f683
--- /dev/null
+++ b/tests/test_stream_lake.py
@@ -0,0 +1,105 @@
+import time
+
+import pyarrow.parquet as pq
+import pytest
+
+import engine.sources.sse as sse
+from engine.core import run_pipeline
+from engine.lake import Crash
+from engine.stream_state import newest_manifest
+from tests.fake_sse import FakeReplay
+
+
+def _config(url, batch_events=2):
+    return {
+        "sources": [{
+            "name": "stream_recentchange", "kind": "sse", "url": url, "table": "stream_recentchange",
+            "batch_events": batch_events, "batch_seconds": 5,
+        }],
+        "sinks": [{
+            "name": "lake", "kind": "stream_lake", "inputs": ["stream_recentchange"],
+            "table": "stream_recentchange",
+        }],
+    }
+
+
+def _run(lake, url, seconds, checkpoint=None, batch_events=2):
+    return run_pipeline(
+        _config(url, batch_events),
+        lake_dir=lake,
+        run_id="r",
+        deadline=time.monotonic() + seconds,
+        checkpoint=checkpoint,
+    )
+
+
+def _crash_on(point, nth):
+    calls = {"n": 0}
+
+    def checkpoint(name):
+        if name == point:
+            calls["n"] += 1
+            if calls["n"] == nth:
+                raise Crash(name)
+
+    return checkpoint
+
+
+def _lake_ids(lake):
+    files = sorted((lake / "stream_recentchange").glob("batch-*.parquet"))
+    ids = []
+    for path in files:
+        ids.extend(pq.read_table(path, columns=["meta_id"]).column("meta_id").to_pylist())
+    return ids
+
+
+@pytest.fixture(autouse=True)
+def _fast_backoff(monkeypatch):
+    monkeypatch.setattr(sse, "BACKOFF_START", 0.01)
+
+
+def test_crashes_and_restarts_keep_each_event_once(tmp_path):
+    lake = tmp_path / "lake"
+    with FakeReplay(count=12, drop_every=3) as fake:
+        with pytest.raises(Crash):
+            _run(lake, fake.url, 5, checkpoint=_crash_on("after_data", 2))
+        with pytest.raises(Crash):
+            _run(lake, fake.url, 5, checkpoint=_crash_on("after_manifest", 3))
+        _run(lake, fake.url, 2.5)
+
+    assert sorted(_lake_ids(lake)) == sorted(fake.all_ids)
+
+
+def test_restart_resumes_from_the_newest_manifest_position(tmp_path):
+    lake = tmp_path / "lake"
+    with FakeReplay(count=6) as fake:
+        with pytest.raises(Crash):
+            _run(lake, fake.url, 5, checkpoint=_crash_on("after_manifest", 2))
+        position = newest_manifest(lake, "stream_recentchange")["sse_position"]
+        before = len(fake.requests)
+        _run(lake, fake.url, 1.0)
+
+    assert fake.requests[before] == position
+
+
+def test_unlisted_batch_file_is_removed_on_restart(tmp_path):
+    lake = tmp_path / "lake"
+    files = lambda: {p.name for p in (lake / "stream_recentchange").glob("batch-*.parquet")}  # noqa: E731
+    with FakeReplay(count=8) as fake:
+        with pytest.raises(Crash):
+            _run(lake, fake.url, 5, checkpoint=_crash_on("after_data", 2))
+        leftover = files() - set(newest_manifest(lake, "stream_recentchange")["batch_files"])
+        assert leftover, "the crash should leave a batch file that no manifest lists"
+        _run(lake, fake.url, 0.5)
+    assert files() == set(newest_manifest(lake, "stream_recentchange")["batch_files"])
+
+
+def test_manifest_holds_position_watermark_arrival_and_batch_files(tmp_path):
+    lake = tmp_path / "lake"
+    with FakeReplay(count=4, drop_every=2) as fake:
+        _run(lake, fake.url, 1.0)
+    manifest = newest_manifest(lake, "stream_recentchange")
+    assert set(manifest) >= {"seq", "sse_position", "watermark", "arrival_seq", "batch_files", "duplicates_dropped"}
+    assert manifest["arrival_seq"] == 4
+    assert manifest["watermark"] == max(e["timestamp"] for _, e in fake.events)
+    assert manifest["duplicates_dropped"] > 0
