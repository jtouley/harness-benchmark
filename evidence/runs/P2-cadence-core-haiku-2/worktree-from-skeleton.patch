+-- One row per county. Population is the July 1, 2024 estimate; a county without a 2024 value
+-- uses its latest earlier value (decision cd-1-population-vintage). The sentinel row takes the
+-- awards with a blank or unmatched county (decision cd-1-geography-basis).
+with ranked as (
+    select
+        county_fips,
+        year,
+        population,
+        state_name,
+        county_name,
+        row_number() over (partition by county_fips order by year desc) as rn
+    from {{ ref('stg_census_county_population') }}
+    where population is not null
+      and year <= 2024
+)
+select
+    county_fips as place_key,
+    substr(county_fips, 1, 2) as state_fips,
+    state_name,
+    county_fips,
+    county_name,
+    population,
+    year as population_year
+from ranked
+where rn = 1
+union all
+select
+    '00000' as place_key,
+    'UNK' as state_fips,
+    'Unknown' as state_name,
+    '00000' as county_fips,
+    'Unknown county' as county_name,
+    cast(null as bigint) as population,
+    cast(null as integer) as population_year
