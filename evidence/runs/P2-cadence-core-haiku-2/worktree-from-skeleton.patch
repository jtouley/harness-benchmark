+    any_value(county_name) as county_name,
+    max(population) as population,
+    sum(net_obligations) as net_obligations
+from read_parquet('out/marts/mart_fy2024_monthly_county_agency.parquet')
+where county_fips <> '00000'
+group by county_fips
