diff --git a/engine/sources/sse.py b/engine/sources/sse.py
new file mode 100644
index 0000000..01e927f
--- /dev/null
+++ b/engine/sources/sse.py
@@ -0,0 +1,196 @@
+"""sse: reads a Server-Sent Events stream, reconnects with Last-Event-ID, and yields Arrow record batches.
+
+The replay redelivers the event that carries Last-Event-ID (inclusive resume), so the sink dedupes on meta.id.
+A batch closes at batch_events rows or batch_seconds, whichever comes first.
+"""
+
+from __future__ import annotations
+
+import http.client
+import json
+import queue
+import sys
+import threading
+import time
+import urllib.request
+from collections.abc import Iterable, Iterator
+from dataclasses import dataclass
+
+import pyarrow as pa
+
+from engine.registry import SOURCES, RunContext
+from engine.stream_state import newest_manifest
+
+DEFAULT_URL = "http://localhost:8099/v2/stream/recentchange"
+BACKOFF_START = 0.5
+BACKOFF_CAP = 10.0
+IDLE_TIMEOUT = 30.0
+TICK = 0.2
+
+SSE_SCHEMA = pa.schema([
+    ("sse_id", pa.string()),
+    ("meta_id", pa.string()),
+    ("timestamp", pa.int64()),
+    ("wiki", pa.string()),
+    ("namespace", pa.int32()),
+    ("bot", pa.bool_()),
+    ("type", pa.string()),
+    ("length_old", pa.int64()),
+    ("length_new", pa.int64()),
+])
+
+
+@dataclass(frozen=True)
+class SseEvent:
+    id: str | None
+    data: str
+
+
+def parse_events(lines: Iterable[str]) -> Iterator[SseEvent]:
+    """Parse SSE lines. A blank line ends an event. Comments are skipped. An event without data is not dispatched."""
+    event_id: str | None = None
+    data: list[str] = []
+    for raw in lines:
+        line = raw.rstrip("\r\n")
+        if line == "":
+            if data:
+                yield SseEvent(id=event_id, data="\n".join(data))
+            data = []
+            continue
+        if line.startswith(":"):
+            continue
+        field, _, value = line.partition(":")
+        if value.startswith(" "):
+            value = value[1:]
+        if field == "id":
+            event_id = value
+        elif field == "data":
+            data.append(value)
+
+
+def event_row(event: SseEvent) -> dict | None:
+    """One lake row for an event. Canary events (meta.domain = canary) are monitoring traffic and give None."""
+    payload = json.loads(event.data, strict=False)  # the replay sends raw control characters inside strings
+    if payload.get("meta", {}).get("domain") == "canary":
+        return None
+    length = payload.get("length") or {}
+    return {
+        "sse_id": event.id,
+        "meta_id": payload["meta"]["id"],
+        "timestamp": payload["timestamp"],
+        "wiki": payload["wiki"],
+        "namespace": payload["namespace"],
+        "bot": payload["bot"],
+        "type": payload["type"],
+        "length_old": length.get("old"),
+        "length_new": length.get("new"),
+    }
+
+
+def next_delay(delay: float) -> float:
+    return min(delay * 2, BACKOFF_CAP)
+
+
+class SseStream:
+    """Reads the stream on a thread and hands events over a queue. Yields None on idle ticks."""
+
+    def __init__(self, url: str, resume_from: str | None, deadline: float | None):
+        self.url = url
+        self.last_event_id = resume_from
+        self.deadline = deadline
+        self._queue: queue.Queue[SseEvent] = queue.Queue()
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._pump, daemon=True)
+
+    def events(self) -> Iterator[SseEvent | None]:
+        self._thread.start()
+        try:
+            while self.deadline is None or time.monotonic() < self.deadline:
+                try:
+                    yield self._queue.get(timeout=TICK)
+                except queue.Empty:
+                    yield None
+        finally:
+            self.stop()
+
+    def stop(self) -> None:
+        self._stop.set()
+
+    def _pump(self) -> None:
+        delay = BACKOFF_START
+        while not self._stop.is_set():
+            headers = {"Accept": "text/event-stream"}
+            if self.last_event_id is not None:
+                headers["Last-Event-ID"] = self.last_event_id
+            try:
+                request = urllib.request.Request(self.url, headers=headers)  # noqa: S310 (URL from the pipeline YAML)
+                with urllib.request.urlopen(request, timeout=IDLE_TIMEOUT) as response:  # noqa: S310 (YAML URL)
+                    for event in parse_events(line.decode("utf-8") for line in response):
+                        if self._stop.is_set():
+                            return
+                        self.last_event_id = event.id
+                        delay = BACKOFF_START
+                        self._queue.put(event)
+            except (OSError, http.client.HTTPException):
+                pass
+            if self._stop.wait(delay):
+                return
+            delay = next_delay(delay)
+
+
+class SseBatches:
+    """The output of an sse source: a schema and an iterator of batches. close() stops the reader thread."""
+
+    def __init__(self, batches: Iterator[pa.RecordBatch], stream: SseStream):
+        self.schema = SSE_SCHEMA
+        self._batches = batches
+        self._stream = stream
+
+    def __iter__(self) -> Iterator[pa.RecordBatch]:
+        return self._batches
+
+    def close(self) -> None:
+        self._stream.stop()
+        self._batches.close()
+
+
+def _batch_rows(entry: dict, stream: SseStream) -> Iterator[pa.RecordBatch]:
+    batch_events = entry.get("batch_events", 500)
+    batch_seconds = entry.get("batch_seconds", 30)
+    rows: list[dict] = []
+    started = time.monotonic()
+    for item in stream.events():
+        row = _row_or_none(item) if item is not None else None
+        if row is not None:
+            rows.append(row)
+        if rows and (len(rows) >= batch_events or time.monotonic() - started >= batch_seconds):
+            yield _to_batch(rows)
+            rows = []
+            started = time.monotonic()
+    if rows:
+        yield _to_batch(rows)
+
+
+def _row_or_none(event: SseEvent) -> dict | None:
+    """A malformed event (bad JSON or a missing field) is skipped with a message, so the stream goes on."""
+    try:
+        return event_row(event)
+    except (ValueError, KeyError, TypeError) as exc:
+        sys.stderr.write(f"sse: skipped malformed event {event.id!r}: {exc}\n")
+        return None
+
+
+def _to_batch(rows: list[dict]) -> pa.RecordBatch:
+    return pa.RecordBatch.from_pylist(rows, schema=SSE_SCHEMA)
+
+
+def sse(entry: dict, ctx: RunContext) -> SseBatches:
+    resume = None
+    manifest = newest_manifest(ctx.lake_dir, entry["table"]) if entry.get("table") else None
+    if manifest is not None:
+        resume = manifest["sse_position"]
+    stream = SseStream(entry.get("url", DEFAULT_URL), resume_from=resume, deadline=ctx.deadline)
+    return SseBatches(_batch_rows(entry, stream), stream)
+
+
+SOURCES["sse"] = sse
diff --git a/engine/sources/usaspending.py b/engine/sources/usaspending.py
new file mode 100644
index 0000000..877c48f
--- /dev/null
+++ b/engine/sources/usaspending.py
@@ -0,0 +1,59 @@
+"""usaspending_zip_csv: reads each CSV in each zip, maps both layouts to one schema (column_map in YAML)."""
+
+from __future__ import annotations
+
+import glob
+import io
+import zipfile
+
+import pyarrow as pa
+import pyarrow.csv as pacsv
+
+from engine.registry import SOURCES, RunContext
+from engine.sources.base import SourceError, cast_integer, cast_money, read_csv_strings
+
+
+def usaspending_zip_csv(entry: dict, ctx: RunContext) -> pa.Table:
+    paths = sorted(glob.glob(entry["path"]))
+    if not paths:
+        raise SourceError(f"{entry['path']}: no zip files match")
+    tables = []
+    for zip_path in paths:
+        with zipfile.ZipFile(zip_path) as archive:
+            for member in sorted(n for n in archive.namelist() if n.lower().endswith(".csv")):
+                tables.append(_read_member(entry, f"{zip_path}!{member}", archive.read(member)))
+    return pa.concat_tables(tables)
+
+
+def _read_member(entry: dict, file: str, data: bytes) -> pa.Table:
+    header = pacsv.open_csv(io.BytesIO(data), parse_options=pacsv.ParseOptions(newlines_in_values=True)).schema.names
+    mapping = _resolve(entry["column_map"], header, file)
+    table = read_csv_strings(data, list(mapping.values()))
+    money = set(entry.get("money_columns", []))
+    integers = set(entry.get("integer_columns", []))
+    columns: dict[str, pa.Array] = {}
+    for common, source in mapping.items():
+        values = table.column(source)
+        if common in money:
+            columns[common] = cast_money(values, file, common)
+        elif common in integers:
+            columns[common] = cast_integer(values, file, common)
+        else:
+            columns[common] = values
+    rows = table.num_rows
+    columns["_source_file"] = pa.array([file] * rows, pa.string())
+    columns["_source_row"] = pa.array(range(1, rows + 1), pa.int64())
+    return pa.table(columns)
+
+
+def _resolve(column_map: dict[str, list[str]], header: list[str], file: str) -> dict[str, str]:
+    mapping = {}
+    for common, candidates in column_map.items():
+        found = next((c for c in candidates if c in header), None)
+        if found is None:
+            raise SourceError(f"{file}: no column for {common} (tried {', '.join(candidates)})")
+        mapping[common] = found
+    return mapping
+
+
+SOURCES["usaspending_zip_csv"] = usaspending_zip_csv
diff --git a/engine/stream_rules.py b/engine/stream_rules.py
new file mode 100644
index 0000000..51bcb73
--- /dev/null
+++ b/engine/stream_rules.py
@@ -0,0 +1,31 @@
+"""Stream rules: edit rule, 5-minute windows and the late rule (decisions cd-1-event-identity, cd-1-late-events)."""
+
+from __future__ import annotations
+
+WINDOW_SECONDS = 300
+LATE_GRACE_SECONDS = 600
+EDIT_TYPES = frozenset({"edit", "new"})
+
+
+def window_start(timestamp: int) -> int:
+    return timestamp - timestamp % WINDOW_SECONDS
+
+
+def window_end(timestamp: int) -> int:
+    return window_start(timestamp) + WINDOW_SECONDS
+
+
+def is_late(event_window_end: int, watermark_before: int | None) -> bool:
+    """Late when the highest earlier first-arrival timestamp is past window_end + 600 seconds (strictly)."""
+    return watermark_before is not None and watermark_before > event_window_end + LATE_GRACE_SECONDS
+
+
+def is_edit(event_type: str) -> bool:
+    return event_type in EDIT_TYPES
+
+
+def net_bytes(event_type: str, length_old: int | None, length_new: int | None) -> int | None:
+    """Bytes added by an edit. A null length.new counts as 0. Other types have no net bytes."""
+    if not is_edit(event_type):
+        return None
+    return (length_new or 0) - (length_old or 0)
diff --git a/engine/stream_sink.py b/engine/stream_sink.py
new file mode 100644
index 0000000..d304c83
--- /dev/null
+++ b/engine/stream_sink.py
@@ -0,0 +1,118 @@
+"""stream_lake: micro-batch sink with a commit per batch, meta.id dedupe, arrival order and the late rule.
+
+Per incoming batch, in arrival order: an event whose meta.id is already committed is dropped and counted.
+Each other event gets arrival_seq, its 5-minute window, is_late (decided against the watermark before it)
+and the edit fields. The kept rows go to a batch file; late rows also go to lake/late_events/. Then the manifest
+is written. A crash after the data write and before the manifest leaves unlisted files, which the next start
+deletes. The events are then read again and kept once.
+"""
+
+from __future__ import annotations
+
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+from engine import stream_rules
+from engine.registry import SINKS, RunContext
+from engine.sources.sse import SSE_SCHEMA
+from engine.stream_state import LATE_TABLE, batch_dir, newest_manifest, remove_uncommitted, write_manifest
+
+RAW_SCHEMA = pa.schema(
+    list(SSE_SCHEMA)
+    + [
+        pa.field("arrival_seq", pa.int64()),
+        pa.field("window_start", pa.int64()),
+        pa.field("window_end", pa.int64()),
+        pa.field("is_late", pa.bool_()),
+        pa.field("is_edit", pa.bool_()),
+        pa.field("net_bytes", pa.int64()),
+    ]
+)
+_EMPTY_STATE = {
+    "seq": 0, "sse_position": None, "watermark": None, "arrival_seq": 0,
+    "batch_files": [], "late_files": [], "duplicates_dropped": 0,
+}
+
+
+def stream_lake_sink(entry: dict, data, ctx: RunContext) -> None:
+    table, lake = entry["table"], ctx.lake_dir
+    previous = newest_manifest(lake, table)
+    remove_uncommitted(lake, table, previous)
+    state = previous or dict(_EMPTY_STATE)
+    seen = _committed_ids(lake, table, state["batch_files"])
+    try:
+        for batch in _batches(data):
+            raw, late, dropped, arrival, watermark = _ingest(batch.to_pylist(), seen, state)
+            seq = state["seq"] + 1
+            files, late_files = list(state["batch_files"]), list(state.get("late_files", []))
+            if raw:
+                name = f"batch-{seq:08d}.parquet"
+                _write(raw, batch_dir(lake, table) / name)
+                files.append(name)
+            name = f"late-{seq:08d}.parquet"  # written for every commit, so the dbt view always finds a file
+            _write(late, lake / LATE_TABLE / name)
+            late_files.append(name)
+            ctx.checkpoint("after_data")
+            state = {
+                "seq": seq,
+                "sse_position": batch.column("sse_id")[-1].as_py(),
+                "watermark": watermark,
+                "arrival_seq": arrival,
+                "batch_files": files,
+                "late_files": late_files,
+                "duplicates_dropped": state["duplicates_dropped"] + dropped,
+            }
+            write_manifest(lake, table, state)
+            ctx.checkpoint("after_manifest")
+    finally:
+        close = getattr(data, "close", None)
+        if close is not None:
+            close()
+
+
+def _batches(data):
+    if isinstance(data, pa.Table):
+        return data.to_batches()
+    return data
+
+
+def _ingest(events: list[dict], seen: set[str], state: dict):
+    raw, late = [], []
+    arrival, watermark = state["arrival_seq"], state["watermark"]
+    dropped = 0
+    for event in events:
+        if event["meta_id"] in seen:
+            dropped += 1
+            continue
+        seen.add(event["meta_id"])
+        arrival += 1
+        end = stream_rules.window_end(event["timestamp"])
+        row = dict(event)
+        row.update(
+            arrival_seq=arrival,
+            window_start=stream_rules.window_start(event["timestamp"]),
+            window_end=end,
+            is_late=stream_rules.is_late(end, watermark),
+            is_edit=stream_rules.is_edit(event["type"]),
+            net_bytes=stream_rules.net_bytes(event["type"], event["length_old"], event["length_new"]),
+        )
+        raw.append(row)
+        if row["is_late"]:
+            late.append(row)
+        watermark = event["timestamp"] if watermark is None else max(watermark, event["timestamp"])
+    return raw, late, dropped, arrival, watermark
+
+
+def _write(rows: list[dict], path) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    pq.write_table(pa.Table.from_pylist(rows, schema=RAW_SCHEMA), path)
+
+
+def _committed_ids(lake, table: str, files: list[str]) -> set[str]:
+    ids: set[str] = set()
+    for name in files:
+        ids.update(pq.read_table(batch_dir(lake, table) / name, columns=["meta_id"]).column("meta_id").to_pylist())
+    return ids
+
+
+SINKS["stream_lake"] = stream_lake_sink
diff --git a/engine/stream_state.py b/engine/stream_state.py
new file mode 100644
index 0000000..0f86c07
--- /dev/null
+++ b/engine/stream_state.py
@@ -0,0 +1,61 @@
+"""Commit manifests for stream tables (decision cd-1-stream-commit).
+
+A commit is one manifest file, lake/_commits/<table>/<seq>.json, written to a temp name and renamed.
+The rename is the commit. The newest manifest names the SSE position, the watermark, the arrival
+sequence, the batch files and the duplicate count.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+BATCH_GLOB = "batch-*.parquet"
+LATE_TABLE = "late_events"
+LATE_GLOB = "late-*.parquet"
+
+
+def batch_dir(lake_dir: Path, table: str) -> Path:
+    return Path(lake_dir) / table
+
+
+def commits_dir(lake_dir: Path, table: str) -> Path:
+    return Path(lake_dir) / "_commits" / table
+
+
+def newest_manifest(lake_dir: Path, table: str) -> dict | None:
+    directory = commits_dir(lake_dir, table)
+    if not directory.is_dir():
+        return None
+    committed = sorted(p for p in directory.glob("*.json") if p.stem.isdigit())
+    if not committed:
+        return None
+    return json.loads(committed[-1].read_text(encoding="utf-8"))
+
+
+def write_manifest(lake_dir: Path, table: str, manifest: dict) -> None:
+    directory = commits_dir(lake_dir, table)
+    directory.mkdir(parents=True, exist_ok=True)
+    seq = manifest["seq"]
+    temp = directory / f".tmp-{seq:08d}.json"
+    temp.write_text(json.dumps(manifest, sort_keys=True), encoding="utf-8")
+    os.replace(temp, directory / f"{seq:08d}.json")
+
+
+def remove_uncommitted(lake_dir: Path, table: str, manifest: dict | None) -> None:
+    """Delete batch and late-event files that no manifest lists, and temp manifests left by a crash."""
+    listed = set(manifest["batch_files"]) if manifest else set()
+    for path in batch_dir(lake_dir, table).glob(BATCH_GLOB):
+        if path.name not in listed:
+            path.unlink()
+    listed_late = set(manifest.get("late_files", [])) if manifest else set()
+    late = Path(lake_dir) / LATE_TABLE
+    if late.is_dir():
+        for path in late.glob(LATE_GLOB):
+            if path.name not in listed_late:
+                path.unlink()
+    directory = commits_dir(lake_dir, table)
+    if directory.is_dir():
+        for path in directory.glob(".tmp-*.json"):
+            path.unlink()
