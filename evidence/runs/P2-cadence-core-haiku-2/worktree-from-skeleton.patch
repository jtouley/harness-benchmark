+-- Check 1: FY2024 net obligations per awarding agency. The mart total must equal the lake total for each agency.
+with mart as (
+    select agency_key, sum(net_obligations) as mart_net
+    from read_parquet('out/marts/mart_fy2024_monthly_county_agency.parquet')
+    group by agency_key
+),
+lake as (
+    select awarding_agency_code as agency_key, sum(federal_action_obligation) as lake_net
+    from read_parquet('lake/usaspending_awards/*.parquet')
+    where action_date_fiscal_year = 2024
+    group by awarding_agency_code
+)
+select l.agency_key, l.lake_net, m.mart_net, l.lake_net = m.mart_net as equal
+from lake l
+left join mart m using (agency_key)
+order by l.agency_key;
