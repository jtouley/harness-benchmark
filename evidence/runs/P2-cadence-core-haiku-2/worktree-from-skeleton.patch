@@ -0,0 +1,94 @@
+"""Parquet lake sink with an atomic table swap (decisions cd-1-lake-layout, MF-1)."""
+
+from __future__ import annotations
+
+import re
+import shutil
+from collections.abc import Callable, Sequence
+from pathlib import Path
+
+import pyarrow as pa
+import pyarrow.dataset as ds
+import pyarrow.parquet as pq
+
+from engine.registry import SINKS, RunContext, as_table
+
+_OLD = re.compile(r"^\.old-(?P<table>[A-Za-z_][A-Za-z0-9_]*)-(?P<run>[0-9A-Za-z_]+)$")
+
+
+class Crash(RuntimeError):
+    """Raised by a checkpoint in tests to simulate a crash at a named point."""
+
+
+def write_table(
+    lake_dir: Path,
+    table_name: str,
+    table: pa.Table,
+    partition_by: Sequence[str],
+    run_id: str,
+    checkpoint: Callable[[str], None] = lambda point: None,
+) -> None:
+    """Write `table` to lake/<table_name>/. Checkpoints: after_write, after_old_moved, after_swap."""
+    lake_dir = Path(lake_dir)
+    lake_dir.mkdir(parents=True, exist_ok=True)
+    tmp = lake_dir / f".tmp-{table_name}-{run_id}"
+    final = lake_dir / table_name
+    old = lake_dir / f".old-{table_name}-{run_id}"
+    if tmp.exists():
+        shutil.rmtree(tmp)
+    _write_parquet(table, tmp, partition_by)
+    checkpoint("after_write")
+    if final.exists():
+        final.rename(old)
+    checkpoint("after_old_moved")
+    tmp.rename(final)
+    checkpoint("after_swap")
+    if old.exists():
+        shutil.rmtree(old)
+
+
+def recover_lake(lake_dir: Path) -> None:
+    """Run at the start of every engine run, before any read or write of a table."""
+    lake_dir = Path(lake_dir)
+    if not lake_dir.is_dir():
+        return
+    for path in sorted(lake_dir.glob(".tmp-*")):
+        if path.is_dir():
+            shutil.rmtree(path)
+    for path in sorted(lake_dir.glob(".old-*")):
+        match = _OLD.match(path.name)
+        if match is None or not path.is_dir():
+            continue
+        final = lake_dir / match["table"]
+        if final.exists():
+            shutil.rmtree(path)
+        else:
+            path.rename(final)
+
+
+def _write_parquet(table: pa.Table, dest: Path, partition_by: Sequence[str]) -> None:
+    dest.mkdir(parents=True)
+    if partition_by:
+        ds.write_dataset(
+            table,
+            base_dir=str(dest),
+            format="parquet",
+            partitioning=list(partition_by),
+            partitioning_flavor="hive",
+        )
+    else:
+        pq.write_table(table, dest / "part-0.parquet")
+
+
+def parquet_lake_sink(entry: dict, data: pa.Table | pa.RecordBatchReader, ctx: RunContext) -> None:
+    write_table(
+        ctx.lake_dir,
+        entry["table"],
+        as_table(data),
+        entry.get("partition_by", []),
+        ctx.run_id,
+        ctx.checkpoint,
+    )
+
+
+SINKS["parquet_lake"] = parquet_lake_sink
