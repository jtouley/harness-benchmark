@@ -0,0 +1,16 @@
+from __future__ import annotations
+
+import pyarrow as pa
+
+
+class TransformError(ValueError):
+    """A transform step cannot run or fails on its input. The message names the step."""
+
+
+def arrow_strings(table: pa.Table) -> pa.Table:
+    """Polars returns large_string columns. Cast them back to string so schemas stay the same."""
+    fields = [
+        pa.field(f.name, pa.string() if f.type == pa.large_string() else f.type, f.nullable)
+        for f in table.schema
+    ]
+    return table.cast(pa.schema(fields))
