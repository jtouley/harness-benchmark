@@ -0,0 +1,43 @@
+import pytest
+
+from engine.stream_rules import is_edit, is_late, net_bytes, window_end, window_start
+
+
+@pytest.mark.parametrize(("timestamp", "start", "end"), [
+    (600, 600, 900),
+    (899, 600, 900),
+    (900, 900, 1200),
+    (1792021611, 1792021500, 1792021800),
+])
+def test_windows_are_five_minutes_starting_on_multiples_of_300(timestamp, start, end):
+    assert window_start(timestamp) == start
+    assert window_end(timestamp) == end
+
+
+def test_late_boundary_is_strict_at_window_end_plus_600():
+    end = 1200
+    assert is_late(end, watermark_before=1800) is False  # equals window_end + 600: on time
+    assert is_late(end, watermark_before=1801) is True   # window_end + 601: late
+
+
+def test_out_of_order_event_within_the_bound_is_on_time():
+    assert is_late(1200, watermark_before=1700) is False
+
+
+def test_no_watermark_yet_means_on_time():
+    assert is_late(1200, watermark_before=None) is False
+
+
+@pytest.mark.parametrize(("event_type", "edit"), [("edit", True), ("new", True), ("categorize", False), ("log", False)])
+def test_only_edit_and_new_are_edits(event_type, edit):
+    assert is_edit(event_type) is edit
+
+
+def test_net_bytes_counts_a_null_new_length_as_zero():
+    assert net_bytes("edit", length_old=10165, length_new=10133) == -32
+    assert net_bytes("edit", length_old=100, length_new=None) == -100
+    assert net_bytes("new", length_old=None, length_new=250) == 250
+
+
+def test_net_bytes_is_null_for_non_edits():
+    assert net_bytes("categorize", length_old=None, length_new=None) is None
