@@ -0,0 +1,47 @@
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+FIXTURES = Path(__file__).resolve().parent / "fixtures" / "yaml"
+LOCATION = re.compile(r"^(?P<file>.+?):(?P<line>\d+):(?P<col>\d+): (?P<problem>.+)$")
+
+
+def run_validate(path: Path) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        [sys.executable, "-m", "engine", "validate", str(path)],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+    )
+
+
+def test_valid_pipeline_exits_zero():
+    result = run_validate(FIXTURES / "valid.yml")
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+@pytest.mark.parametrize(
+    ("fixture", "line", "col", "fragment"),
+    [
+        ("syntax_error.yml", 4, 9, "expected"),
+        ("unknown_kind.yml", 3, 11, "csv_file"),
+        ("missing_engine.yml", 2, 5, "'engine' is a required property"),
+        ("unknown_key.yml", 5, 5, "'pth'"),
+        ("partition_by_wrong_type.yml", 6, 19, "'year' is not of type 'array'"),
+    ],
+)
+def test_problem_is_reported_with_file_line_and_column(fixture, line, col, fragment):
+    path = FIXTURES / fixture
+    result = run_validate(path)
+    assert result.returncode == 1
+    problems = [m for m in map(LOCATION.match, result.stdout.splitlines()) if m]
+    located = [
+        m for m in problems
+        if m["file"] == str(path) and int(m["line"]) == line and int(m["col"]) == col
+    ]
+    assert located, result.stdout
+    assert fragment in located[0]["problem"]
