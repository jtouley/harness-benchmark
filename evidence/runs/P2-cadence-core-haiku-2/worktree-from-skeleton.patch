diff --git a/transform/models/marts/mart_fy2024_monthly_county_agency.sql b/transform/models/marts/mart_fy2024_monthly_county_agency.sql
new file mode 100644
index 0000000..1c35780
--- /dev/null
+++ b/transform/models/marts/mart_fy2024_monthly_county_agency.sql
@@ -0,0 +1,65 @@
+{{ config(
+    materialized='external',
+    location=var('marts_dir') ~ '/mart_fy2024_monthly_county_agency.parquet'
+) }}
+
+-- Grain: month x state x county x awarding agency (FY2024).
+-- obligations_per_person = net_obligations / population, rounded half-even once, at the last step.
+-- The division is integer arithmetic on cents, because DuckDB divides decimals as DOUBLE.
+with grouped as (
+    select
+        d.month_key,
+        p.state_fips,
+        p.county_fips,
+        p.county_name,
+        p.population,
+        p.population_year,
+        a.agency_key,
+        a.agency_name,
+        sum(f.federal_action_obligation) as net_exact
+    from {{ ref('fact_award_transaction') }} f
+    join {{ ref('dim_date') }} d on d.date_key = f.date_key
+    join {{ ref('dim_place') }} p on p.place_key = f.place_key
+    join {{ ref('dim_agency') }} a on a.agency_key = f.agency_key
+    where d.fiscal_year = 2024
+    group by 1, 2, 3, 4, 5, 6, 7, 8
+),
+cents as (
+    select
+        *,
+        cast(cast(net_exact as decimal(18,2)) * 100 as hugeint) as net_cents
+    from grouped
+),
+units as (
+    select
+        *,
+        case
+            when population is null or population = 0 then null
+            else sign(net_cents) * (
+                abs(net_cents * 100) // population
+                + case
+                    when 2 * (abs(net_cents * 100) % population) > population then 1
+                    when 2 * (abs(net_cents * 100) % population) = population
+                         and (abs(net_cents * 100) // population) % 2 = 1 then 1
+                    else 0
+                  end
+            )
+        end as per_person_units
+    from cents
+)
+select
+    md5(month_key || '|' || county_fips || '|' || agency_key) as mart_key,
+    month_key,
+    state_fips,
+    county_fips,
+    county_name,
+    agency_key,
+    agency_name,
+    cast(net_exact as decimal(18,2)) as net_obligations,
+    population,
+    population_year,
+    cast(
+        cast(per_person_units as decimal(18,4)) * cast(0.0001 as decimal(18,4))
+        as decimal(18,4)
+    ) as obligations_per_person
+from units
