+import json
+import time
+
+import engine.sources.sse as sse
+from engine.sources.sse import SseStream, next_delay
+from tests.fake_sse import FakeReplay
+
+
+def test_backoff_starts_at_half_a_second_and_caps_at_ten():
+    delays = [0.5]
+    for _ in range(6):
+        delays.append(next_delay(delays[-1]))
+    assert delays == [0.5, 1.0, 2.0, 4.0, 8.0, 10.0, 10.0]
+
+
+def test_client_gets_every_event_across_dropped_connections(monkeypatch):
+    monkeypatch.setattr(sse, "BACKOFF_START", 0.01)
+    with FakeReplay(count=7, drop_every=2) as fake:
+        stream = SseStream(fake.url, resume_from=None, deadline=time.monotonic() + 2.0)
+        seen = [e.data for e in stream.events() if e is not None]
+        stream.stop()
+
+    ids = [json.loads(d)["meta"]["id"] for d in seen]
+    assert set(ids) == set(fake.all_ids)
+    assert fake.requests[0] is None
+    assert fake.requests[1] == "000001"
+
+
+def test_resume_position_is_sent_as_last_event_id(monkeypatch):
+    monkeypatch.setattr(sse, "BACKOFF_START", 0.01)
+    with FakeReplay(count=3) as fake:
+        stream = SseStream(fake.url, resume_from="000001", deadline=time.monotonic() + 0.5)
+        list(stream.events())
+        stream.stop()
+
+    assert fake.requests[0] == "000001"
