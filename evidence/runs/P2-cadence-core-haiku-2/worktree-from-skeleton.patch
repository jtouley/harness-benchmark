+from pathlib import Path
+
+from engine.sources.sse import SseEvent, event_row, parse_events
+
+FIXTURE = Path(__file__).resolve().parent / "fixtures" / "sse" / "recentchange_first5.txt"
+
+
+def test_sse_fixture_fields_match_decisions():
+    lines = FIXTURE.read_text(encoding="utf-8").splitlines(keepends=True)
+    events = list(parse_events(lines))
+    assert len(events) == 5
+
+    edit = event_row(events[1])
+    assert edit == {
+        "sse_id": events[1].id,
+        "meta_id": "69fd058a-588d-4f9e-826e-4d1af59c66b6",
+        "timestamp": 1792021611,
+        "wiki": "enwiki",
+        "namespace": 0,
+        "bot": False,
+        "type": "edit",
+        "length_old": 10165,
+        "length_new": 10133,
+    }
+    categorize = event_row(events[0])
+    assert categorize["type"] == "categorize"
+    assert categorize["length_old"] is None and categorize["length_new"] is None
+
+
+def test_comments_and_multi_line_data_are_joined():
+    lines = [": keep-alive\n", "id: 7\n", "data: {\"a\":\n", "data: 1}\n", "\n"]
+    events = list(parse_events(lines))
+    assert len(events) == 1
+    assert events[0].id == "7"
+    assert events[0].data == '{"a":\n1}'
+
+
+def test_event_without_data_is_not_dispatched():
+    assert list(parse_events(["id: 1\n", "\n"])) == []
+
+
+def test_canary_events_are_not_rows():
+    canary = SseEvent(id="1", data='{"meta": {"id": "c-1", "domain": "canary"}}')
+    assert event_row(canary) is None
+
+
+def test_control_characters_inside_a_string_are_accepted():
+    raw = '{"meta": {"id": "e-1"}, "timestamp": 5, "wiki": "enwiki", "namespace": 0, "bot": false, ' \
+          '"type": "edit", "length": {"old": 1, "new": 2}, "comment": "tab\there"}'
+    row = event_row(SseEvent(id="2", data=raw))
+    assert row["meta_id"] == "e-1" and row["length_new"] == 2
+
+
+def test_malformed_event_is_skipped_with_a_message(capsys):
+    from engine.sources.sse import _row_or_none
+
+    assert _row_or_none(SseEvent(id="9", data='{"meta": {"id": "x"')) is None
+    assert "malformed event '9'" in capsys.readouterr().err
