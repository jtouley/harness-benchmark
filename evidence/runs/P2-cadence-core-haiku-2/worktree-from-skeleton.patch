@@ -0,0 +1,33 @@
+-- Check 4: one month (June 2024). County totals roll up to the state totals in the mart, and the state totals
+-- add up to the source total of the lake for the same month.
+with mart as (
+    select state_fips, county_fips, net_obligations
+    from read_parquet('out/marts/mart_fy2024_monthly_county_agency.parquet')
+    where month_key = '2024-06'
+),
+county_totals as (
+    select state_fips, county_fips, sum(net_obligations) as county_net
+    from mart
+    group by state_fips, county_fips
+),
+state_totals as (
+    select state_fips, sum(net_obligations) as state_net
+    from mart
+    group by state_fips
+),
+rollup as (
+    select state_fips, sum(county_net) as counties_net
+    from county_totals
+    group by state_fips
+),
+source_total as (
+    select sum(federal_action_obligation) as lake_net
+    from read_parquet('lake/usaspending_awards/*.parquet')
+    where action_date_fiscal_year = 2024
+      and strftime(action_date, '%Y-%m') = '2024-06'
+)
+select
+    (select count(*) from state_totals s join rollup r using (state_fips) where s.state_net <> r.counties_net)
+        as states_where_counties_differ,
+    (select sum(state_net) from state_totals) as mart_total,
+    (select lake_net from source_total) as lake_total;
