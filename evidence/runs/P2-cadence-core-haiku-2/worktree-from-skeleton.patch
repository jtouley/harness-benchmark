@@ -0,0 +1,93 @@
+"""Run loop: builds the step graph from `inputs:` names and runs steps in dependency order."""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from pathlib import Path
+from typing import Any
+
+import pyarrow as pa
+
+from engine import lake, registry, stream_sink  # noqa: F401  (registers the parquet and stream sinks)
+import engine.sources  # noqa: F401  registers the source kinds
+import engine.transforms  # noqa: F401  registers the transform engines
+from engine.registry import RunContext, as_table
+
+SECTIONS = ("sources", "transforms", "sinks")
+
+
+class PipelineError(ValueError):
+    pass
+
+
+def run_pipeline(
+    config: Mapping[str, Any],
+    *,
+    lake_dir: Path,
+    run_id: str,
+    sources: Mapping[str, Callable] | None = None,
+    transforms: Mapping[str, Callable] | None = None,
+    sinks: Mapping[str, Callable] | None = None,
+    deadline: float | None = None,
+    checkpoint: Callable[[str], None] | None = None,
+) -> dict[str, pa.Table | pa.RecordBatchReader | None]:
+    lake_dir = Path(lake_dir)
+    lake.recover_lake(lake_dir)
+    registries = {
+        "sources": sources if sources is not None else registry.SOURCES,
+        "transforms": transforms if transforms is not None else registry.TRANSFORMS,
+        "sinks": sinks if sinks is not None else registry.SINKS,
+    }
+    steps = _steps(config)
+    ctx = RunContext(lake_dir=lake_dir, run_id=run_id, deadline=deadline)
+    if checkpoint is not None:
+        ctx.checkpoint = checkpoint
+    tables: dict[str, Any] = {}
+    for name in _order(steps):
+        section, entry, inputs = steps[name]
+        if section == "sources":
+            tables[name] = _lookup(registries, section, entry["kind"], name)(entry, ctx)
+        elif section == "transforms":
+            fn = _lookup(registries, section, entry["engine"], name)
+            tables[name] = fn(entry, [as_table(tables[i]) for i in inputs])
+        else:
+            if len(inputs) != 1:
+                raise PipelineError(f"sink '{name}' takes one input, got {len(inputs)}")
+            fn = _lookup(registries, section, entry["kind"], name)
+            fn(entry, tables[inputs[0]], ctx)
+            tables[name] = None
+    return tables
+
+
+def _steps(config: Mapping[str, Any]) -> dict[str, tuple[str, dict[str, Any], list[str]]]:
+    steps: dict[str, tuple[str, dict[str, Any], list[str]]] = {}
+    for section in SECTIONS:
+        for entry in config.get(section, []):
+            name = entry["name"]
+            if name in steps:
+                raise PipelineError(f"duplicate step name '{name}'")
+            steps[name] = (section, entry, list(entry.get("inputs", [])))
+    for name, (_, _, inputs) in steps.items():
+        for given in inputs:
+            if given not in steps:
+                raise PipelineError(f"step '{name}' reads unknown input '{given}'")
+    return steps
+
+
+def _order(steps: Mapping[str, tuple[str, dict[str, Any], list[str]]]) -> list[str]:
+    done: list[str] = []
+    pending = list(steps)
+    while pending:
+        ready = next((n for n in pending if all(i in done for i in steps[n][2])), None)
+        if ready is None:
+            raise PipelineError(f"cycle among steps: {', '.join(pending)}")
+        done.append(ready)
+        pending.remove(ready)
+    return done
+
+
+def _lookup(registries: Mapping[str, Mapping[str, Callable]], section: str, kind: str, step: str) -> Callable:
+    try:
+        return registries[section][kind]
+    except KeyError:
+        raise PipelineError(f"no {section[:-1]} registered for '{kind}' (step '{step}')") from None
