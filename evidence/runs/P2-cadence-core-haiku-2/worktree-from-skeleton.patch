+import datetime
+
+import pyarrow as pa
+import pytest
+
+from engine.core import run_pipeline
+from engine.transforms.base import TransformError
+from engine.transforms.polars_ops import polars_transform
+
+
+def _polars_entry(op, columns):
+    return {"name": "step", "engine": "polars", "inputs": ["raw"], "op": op, "columns": columns}
+
+
+def test_normalize_fips_pads_to_five_and_blank_is_null():
+    table = pa.table({"fips": ["1001", " 09001 ", "", None]})
+
+    out = polars_transform(_polars_entry("normalize_fips", ["fips"]), [table])
+
+    assert out.column("fips").to_pylist() == ["01001", "09001", None, None]
+    assert out.schema.field("fips").type == pa.string()
+
+
+def test_parse_date_reads_iso_dates_and_blank_is_null():
+    table = pa.table({"action_date": ["2024-03-01", "", None]})
+
+    out = polars_transform(_polars_entry("parse_date", ["action_date"]), [table])
+
+    assert out.column("action_date").to_pylist() == [datetime.date(2024, 3, 1), None, None]
+    assert out.schema.field("action_date").type == pa.date32()
+
+
+def test_parse_date_rejects_a_bad_value_with_the_step_name():
+    table = pa.table({"action_date": ["03/01/2024"]})
+
+    with pytest.raises(TransformError, match="step"):
+        polars_transform(_polars_entry("parse_date", ["action_date"]), [table])
+
+
+def test_unknown_polars_op_is_an_error():
+    with pytest.raises(TransformError, match="unknown_op"):
+        polars_transform(_polars_entry("unknown_op", ["x"]), [pa.table({"x": ["1"]})])
+
+
+def test_engine_key_selects_the_runner(tmp_path):
+    raw = pa.table({"fips": ["1001", "2002"], "action_date_fiscal_year": pa.array([2024, 2023], pa.int32())})
+    config = {
+        "sources": [{"name": "raw", "kind": "csv", "path": "x.csv"}],
+        "transforms": [
+            {"name": "padded", "engine": "polars", "inputs": ["raw"], "op": "normalize_fips",
+             "columns": ["fips"]},
+            {"name": "fy2024", "engine": "datafusion", "inputs": ["padded"],
+             "sql": "SELECT fips FROM padded WHERE action_date_fiscal_year = 2024"},
+        ],
+        "sinks": [{"name": "lake", "kind": "parquet_lake", "inputs": ["fy2024"], "table": "t"}],
+    }
+
+    tables = run_pipeline(
+        config,
+        lake_dir=tmp_path / "lake",
+        run_id="r1",
+        sources={"csv": lambda entry, ctx: raw},
+        sinks={"parquet_lake": lambda entry, table, ctx: None},
+    )
+
+    assert tables["fy2024"].column("fips").to_pylist() == ["01001"]
+
+
+def test_datafusion_sql_joins_named_inputs(tmp_path):
+    left = pa.table({"id": [1, 2], "name": ["a", "b"]})
+    right = pa.table({"id": [2, 3], "amount": ["10", "20"]})
+    config = {
+        "sources": [
+            {"name": "left", "kind": "csv", "path": "l.csv"},
+            {"name": "right", "kind": "csv", "path": "r.csv"},
+        ],
+        "transforms": [{
+            "name": "joined", "engine": "datafusion", "inputs": ["left", "right"],
+            "sql": "SELECT l.id, l.name, r.amount FROM left l JOIN right r ON l.id = r.id",
+        }],
+        "sinks": [{"name": "lake", "kind": "parquet_lake", "inputs": ["joined"], "table": "t"}],
+    }
+    frames = {"l.csv": left, "r.csv": right}
+
+    tables = run_pipeline(
+        config,
+        lake_dir=tmp_path / "lake",
+        run_id="r1",
+        sources={"csv": lambda entry, ctx: frames[entry["path"]]},
+        sinks={"parquet_lake": lambda entry, table, ctx: None},
+    )
+
+    assert tables["joined"].to_pylist() == [{"id": 2, "name": "b", "amount": "10"}]
