+from decimal import Decimal
+
+import pyarrow as pa
+import pytest
+
+from engine.registry import RunContext
+from engine.sources.base import SourceError
+from engine.sources.usaspending import usaspending_zip_csv
+from tests.helpers import csv_text
+
+COLUMN_MAP = {
+    "award_key": ["contract_award_unique_key", "assistance_award_unique_key"],
+    "transaction_key": ["contract_transaction_unique_key", "assistance_transaction_unique_key"],
+    "action_date": ["action_date"],
+    "action_date_fiscal_year": ["action_date_fiscal_year"],
+    "awarding_agency_code": ["awarding_agency_code"],
+    "awarding_agency_name": ["awarding_agency_name"],
+    "recipient_state_fips": ["prime_award_transaction_recipient_state_fips_code"],
+    "recipient_county_fips": ["prime_award_transaction_recipient_county_fips_code"],
+    "recipient_county_name": ["recipient_county_name"],
+    "federal_action_obligation": ["federal_action_obligation"],
+    "modification_number": ["modification_number"],
+}
+CONTRACT_HEADER = [
+    "contract_transaction_unique_key", "contract_award_unique_key", "modification_number", "action_date",
+    "action_date_fiscal_year", "awarding_agency_code", "awarding_agency_name",
+    "prime_award_transaction_recipient_state_fips_code", "prime_award_transaction_recipient_county_fips_code",
+    "recipient_county_name", "federal_action_obligation", "unrelated_column",
+]
+ASSISTANCE_HEADER = [
+    "assistance_transaction_unique_key" if c == "contract_transaction_unique_key"
+    else "assistance_award_unique_key" if c == "contract_award_unique_key" else c
+    for c in CONTRACT_HEADER
+]
+
+
+def _entry(path_glob):
+    return {
+        "name": "awards",
+        "kind": "usaspending_zip_csv",
+        "path": str(path_glob),
+        "column_map": COLUMN_MAP,
+        "money_columns": ["federal_action_obligation"],
+        "integer_columns": ["action_date_fiscal_year"],
+    }
+
+
+def _ctx(tmp_path):
+    return RunContext(lake_dir=tmp_path / "lake", run_id="r1")
+
+
+def _row(award, amount, fiscal_year="2024"):
+    return ["t-" + award, award, "0", "2024-03-01", fiscal_year, "417", "NEA", "09", "09001", "Hartford",
+            amount, "x"]
+
+
+def test_both_layouts_map_to_one_schema(tmp_path, make_zip):
+    make_zip("FY2024_417_Contracts_Full.zip", "c.csv",
+             csv_text(CONTRACT_HEADER, [_row("C-1", "10.00")]))
+    make_zip("FY2024_417_Assistance_Full.zip", "a.csv",
+             csv_text(ASSISTANCE_HEADER, [_row("A-1", "20.00")]))
+
+    table = usaspending_zip_csv(_entry(tmp_path / "*.zip"), _ctx(tmp_path))
+
+    assert "unrelated_column" not in table.column_names
+    assert {"award_key", "transaction_key", "_source_file", "_source_row"} <= set(table.column_names)
+    assert sorted(table.column("award_key").to_pylist()) == ["A-1", "C-1"]
+
+
+def test_money_column_is_decimal_with_two_places_and_blank_is_null(tmp_path, make_zip):
+    make_zip("FY2024_417_Contracts_Full.zip", "c.csv",
+             csv_text(CONTRACT_HEADER, [_row("C-1", "12.50"), _row("C-2", ""), _row("C-3", "-3")]))
+
+    table = usaspending_zip_csv(_entry(tmp_path / "*.zip"), _ctx(tmp_path))
+
+    assert table.schema.field("federal_action_obligation").type == pa.decimal128(18, 2)
+    assert table.column("federal_action_obligation").to_pylist() == [
+        Decimal("12.50"), None, Decimal("-3.00"),
+    ]
+
+
+def test_integer_column_is_int32(tmp_path, make_zip):
+    make_zip("FY2024_417_Contracts_Full.zip", "c.csv", csv_text(CONTRACT_HEADER, [_row("C-1", "1.00")]))
+
+    table = usaspending_zip_csv(_entry(tmp_path / "*.zip"), _ctx(tmp_path))
+
+    assert table.schema.field("action_date_fiscal_year").type == pa.int32()
+
+
+def test_source_row_is_one_based_data_row(tmp_path, make_zip):
+    make_zip("FY2024_417_Contracts_Full.zip", "c.csv",
+             csv_text(CONTRACT_HEADER, [_row("C-1", "1.00"), _row("C-2", "2.00")]))
+
+    table = usaspending_zip_csv(_entry(tmp_path / "*.zip"), _ctx(tmp_path))
+
+    assert table.column("_source_row").to_pylist() == [1, 2]
+    assert table.column("_source_file").to_pylist()[0].endswith("FY2024_417_Contracts_Full.zip!c.csv")
+
+
+@pytest.mark.parametrize("bad_amount", ["12.345", "abc"])
+def test_bad_money_cell_fails_with_file_and_row(tmp_path, make_zip, bad_amount):
+    make_zip("FY2024_417_Contracts_Full.zip", "c.csv",
+             csv_text(CONTRACT_HEADER, [_row("C-1", "1.00"), _row("C-2", bad_amount)]))
+
+    with pytest.raises(SourceError, match=r"FY2024_417_Contracts_Full\.zip.*row 2"):
+        usaspending_zip_csv(_entry(tmp_path / "*.zip"), _ctx(tmp_path))
