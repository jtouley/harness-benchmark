+"""Shared reading helpers for sources: all-string CSV reads and money and integer casts."""
+
+from __future__ import annotations
+
+import io
+from decimal import Decimal, InvalidOperation
+
+import pyarrow as pa
+import pyarrow.compute as pc
+import pyarrow.csv as pacsv
+
+
+class SourceError(ValueError):
+    """A source file or cell cannot be read. The message names the file and the row."""
+
+
+def read_csv_strings(data: bytes, columns: list[str] | None = None) -> pa.Table:
+    """Read a CSV as string columns. Blank cells stay empty strings; casts decide what blank means."""
+    parse = pacsv.ParseOptions(newlines_in_values=True)
+    header = pacsv.open_csv(io.BytesIO(data), parse_options=parse).schema.names
+    wanted = header if columns is None else columns
+    convert = pacsv.ConvertOptions(
+        column_types={name: pa.string() for name in wanted},
+        include_columns=wanted,
+    )
+    return pacsv.read_csv(io.BytesIO(data), parse_options=parse, convert_options=convert)
+
+
+def cast_money(values, file: str, column: str) -> pa.Array:
+    """Cast to decimal128(18,2). A blank cell is null. More than 2 decimal places is an error."""
+    return _cast(values, pa.decimal128(18, 2), _money_problem, file, column)
+
+
+def cast_integer(values, file: str, column: str) -> pa.Array:
+    return _cast(values, pa.int32(), _integer_problem, file, column)
+
+
+def _cast(values, target: pa.DataType, problem, file: str, column: str) -> pa.Array:
+    """Cast a string column. When the cast fails, name the first cell that `problem` rejects."""
+    trimmed = pc.utf8_trim_whitespace(values)
+    cleaned = pc.if_else(pc.equal(trimmed, ""), pa.scalar(None, pa.string()), trimmed)
+    try:
+        return pc.cast(cleaned, target)
+    except pa.ArrowInvalid:
+        pass
+    for row, value in enumerate(cleaned.to_pylist(), start=1):
+        reason = problem(value) if value is not None else None
+        if reason:
+            raise SourceError(f"{file}: row {row}: column {column}: {value!r} {reason}")
+    raise SourceError(f"{file}: column {column}: values cannot be cast to {target}")
+
+
+def _money_problem(value: str) -> str | None:
+    try:
+        amount = Decimal(value)
+    except InvalidOperation:
+        return "is not an amount"
+    if amount != amount.quantize(Decimal("0.01")):
+        return "has more than 2 decimal places"
+    return None
+
+
+def _integer_problem(value: str) -> str | None:
+    try:
+        int(value)
+    except ValueError:
+        return "is not an integer"
+    return None
