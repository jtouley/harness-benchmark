+def test_flattens_groups_and_specials_to_one_row_per_wiki(tmp_path):
+    doc = {
+        "sitematrix": {
+            "count": 3,
+            "0": {"code": "aa", "name": "Afar", "site": [
+                {"url": "https://aa.wikipedia.org", "dbname": "aawiki", "code": "wiki", "closed": True},
+                {"url": "https://aa.wiktionary.org", "dbname": "aawiktionary", "code": "wiktionary"},
+            ]},
+            "specials": [
+                {"url": "https://wikidata.org", "dbname": "wikidatawiki", "code": "wikidata", "lang": "en",
+                 "private": False},
+            ],
+        }
