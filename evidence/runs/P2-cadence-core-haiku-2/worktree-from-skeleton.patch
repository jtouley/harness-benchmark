index 0000000..e0a8092
--- /dev/null
+++ b/tests/fake_sse.py
@@ -0,0 +1,87 @@
+"""A local SSE server for tests. It behaves like the replay: a resumed connection starts at the event whose
+id is Last-Event-ID (inclusive). Each connection can be dropped after `drop_every` events."""
+
+from __future__ import annotations
+
+import json
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+FIXTURE = Path(__file__).resolve().parent / "fixtures" / "sse" / "recentchange_first5.txt"
+
+
+def fixture_payloads() -> list[dict]:
+    payloads = []
+    for line in FIXTURE.read_text(encoding="utf-8").splitlines():
+        if line.startswith("data:"):
+            payloads.append(json.loads(line[len("data:"):]))
+    return payloads
+
+
+def make_events(count: int) -> list[tuple[str, dict]]:
+    base = fixture_payloads()
+    events = []
+    for i in range(count):
+        data = json.loads(json.dumps(base[i % len(base)]))
+        data["meta"]["id"] = f"evt-{i:04d}"
+        events.append((f"{i:06d}", data))
+    return events
+
+
+class _Handler(BaseHTTPRequestHandler):
+    def do_GET(self):  # noqa: N802 (http.server naming)
+        fake = self.server.fake
+        fake.requests.append(self.headers.get("Last-Event-ID"))
+        self.send_response(200)
+        self.send_header("Content-Type", "text/event-stream")
+        self.send_header("Cache-Control", "no-cache")
+        self.end_headers()
+        last = self.headers.get("Last-Event-ID")
+        start = 0
+        if last is not None:
+            start = next((i for i, (eid, _) in enumerate(fake.events) if eid == last), 0)
+        sent = 0
+        for eid, data in fake.events[start:]:
+            block = f"id: {eid}\nevent: message\ndata: {json.dumps(data)}\n\n"
+            self.wfile.write(block.encode("utf-8"))
+            self.wfile.flush()
+            sent += 1
+            if fake.drop_every and sent % fake.drop_every == 0:
+                return
+        while not fake.closing:
+            time.sleep(0.02)
+
+    def log_message(self, format, *args):  # keep test output quiet
+        return
+
+
+class FakeReplay:
+    def __init__(self, count: int, drop_every: int = 0):
+        self.events = make_events(count)
+        self.drop_every = drop_every
+        self.requests: list[str | None] = []
+        self.closing = False
+        self._server = None
+
+    def __enter__(self) -> "FakeReplay":
+        self._server = ThreadingHTTPServer(("127.0.0.1", 0), _Handler)
+        self._server.daemon_threads = True
+        self._server.fake = self
+        threading.Thread(target=self._server.serve_forever, daemon=True).start()
+        return self
+
+    def __exit__(self, *exc) -> None:
+        self.closing = True
+        self._server.shutdown()
+        self._server.server_close()
+
+    @property
+    def url(self) -> str:
+        host, port = self._server.server_address[:2]
+        return f"http://{host}:{port}/v2/stream/recentchange"
+
+    @property
+    def all_ids(self) -> list[str]:
+        return [data["meta"]["id"] for _, data in self.events]
