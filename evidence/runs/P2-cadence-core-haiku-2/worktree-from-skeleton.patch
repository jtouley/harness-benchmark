new file mode 100644
index 0000000..b6d889d
--- /dev/null
+++ b/engine/config.py
@@ -0,0 +1,96 @@
+"""Pipeline YAML validation: JSON Schema (Draft 2020-12) with PyYAML node marks (decision cd-1-yaml-validation)."""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import jsonschema
+import yaml
+
+SCHEMA_PATH = Path(__file__).resolve().parent / "schema" / "pipeline.schema.json"
+_UNEVALUATED = re.compile(r"\((.*) (?:was|were) unexpected\)")
+_QUOTED = re.compile(r"'([^']*)'")
+
+
+@dataclass(frozen=True, order=True)
+class Problem:
+    path: str
+    line: int
+    col: int
+    message: str
+
+    def __str__(self) -> str:
+        return f"{self.path}:{self.line}:{self.col}: {self.message}"
+
+
+@lru_cache(maxsize=1)
+def _schema() -> dict:
+    return json.loads(SCHEMA_PATH.read_text(encoding="utf-8"))
+
+
+def validate_text(text: str, display_path: str) -> list[Problem]:
+    """Return every problem in a pipeline document, sorted by position. An empty list means valid."""
+    try:
+        root = yaml.compose(text, Loader=yaml.SafeLoader)
+    except yaml.YAMLError as exc:
+        mark = getattr(exc, "problem_mark", None)
+        line, col = (mark.line + 1, mark.column + 1) if mark else (1, 1)
+        return [Problem(display_path, line, col, f"YAML syntax error: {getattr(exc, 'problem', exc)}")]
+    if root is None:
+        return [Problem(display_path, 1, 1, "pipeline file is empty")]
+
+    data = yaml.safe_load(text)
+    found: set[Problem] = set()
+    for error in jsonschema.Draft202012Validator(_schema()).iter_errors(data):
+        for node, message in _locations(root, error):
+            found.add(Problem(display_path, node.start_mark.line + 1, node.start_mark.column + 1, message))
+    return sorted(found)
+
+
+def validate_file(path: Path) -> list[Problem]:
+    return validate_text(Path(path).read_text(encoding="utf-8"), str(path))
+
+
+class PipelineInvalid(ValueError):
+    def __init__(self, problems: list[Problem]):
+        self.problems = problems
+        super().__init__("; ".join(str(p) for p in problems))
+
+
+def load_pipeline(path: Path) -> dict:
+    """Validate a pipeline file and return its parsed content. Raises PipelineInvalid with every problem."""
+    path = Path(path)
+    problems = validate_file(path)
+    if problems:
+        raise PipelineInvalid(problems)
+    return yaml.safe_load(path.read_text(encoding="utf-8"))
+
+
+def _locations(root: yaml.Node, error: jsonschema.ValidationError) -> list[tuple[yaml.Node, str]]:
+    node = _walk(root, list(error.absolute_path))
+    unexpected = _UNEVALUATED.search(error.message) if error.validator == "unevaluatedProperties" else None
+    if unexpected is None:
+        return [(node, error.message)]
+    out = []
+    for name in _QUOTED.findall(unexpected.group(1)):
+        out.append((_key_node(node, name) or node, f"unknown key '{name}'"))
+    return out
+
+
+def _walk(node: yaml.Node, path: list) -> yaml.Node:
+    for step in path:
+        if isinstance(node, yaml.MappingNode):
+            node = next((value for key, value in node.value if key.value == step), node)
+        elif isinstance(node, yaml.SequenceNode) and isinstance(step, int) and step < len(node.value):
+            node = node.value[step]
+    return node
+
+
+def _key_node(node: yaml.Node, name: str) -> yaml.Node | None:
+    if isinstance(node, yaml.MappingNode):
+        return next((key for key, _ in node.value if key.value == name), None)
+    return None
