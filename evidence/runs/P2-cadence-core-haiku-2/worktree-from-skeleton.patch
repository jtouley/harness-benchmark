@@ -0,0 +1,64 @@
+"""census_county_population: long table of county FIPS, year and population (co-est2024, decision cd-1-population-vintage).
+
+The 2021 file (fallback_path) contributes rows only for a county that the 2024 file does not list.
+A blank cell gives no row, so the latest earlier value of the county wins in the dbt staging model.
+"""
+
+from __future__ import annotations
+
+import csv
+from pathlib import Path
+
+import pyarrow as pa
+
+from engine.registry import SOURCES, RunContext
+from engine.sources.base import SourceError
+
+_POP_PREFIX = "POPESTIMATE"
+_SUMMARY_LEVEL_COUNTY = "050"
+
+
+def census_county_population(entry: dict, ctx: RunContext) -> pa.Table:
+    current = _county_rows(Path(entry["path"]))
+    listed = {row[0] for row in current}
+    rows = list(current)
+    if entry.get("fallback_path"):
+        fallback = _county_rows(Path(entry["fallback_path"]))
+        rows.extend(row for row in fallback if row[0] not in listed)
+    return pa.table({
+        "county_fips": pa.array([r[0] for r in rows], pa.string()),
+        "year": pa.array([r[1] for r in rows], pa.int32()),
+        "population": pa.array([r[2] for r in rows], pa.int64()),
+        "state_name": pa.array([r[5] for r in rows], pa.string()),
+        "county_name": pa.array([r[6] for r in rows], pa.string()),
+        "_source_file": pa.array([r[3] for r in rows], pa.string()),
+        "_source_row": pa.array([r[4] for r in rows], pa.int64()),
+    })
+
+
+def _county_rows(path: Path) -> list[tuple]:
+    if not path.is_file():
+        raise SourceError(f"{path}: census file not found")
+    rows = []
+    # The Census files are Latin-1 (names with accents). Read them as text, not bytes.
+    with path.open(encoding="latin-1", newline="") as handle:
+        reader = csv.DictReader(handle)
+        year_columns = [c for c in reader.fieldnames or [] if c.startswith(_POP_PREFIX)]
+        for number, record in enumerate(reader, start=1):
+            if record["SUMLEV"] != _SUMMARY_LEVEL_COUNTY:
+                continue
+            fips = record["STATE"].zfill(2) + record["COUNTY"].zfill(3)
+            for column in year_columns:
+                cell = record[column].strip()
+                if not cell:
+                    continue
+                try:
+                    population = int(cell)
+                except ValueError:
+                    raise SourceError(f"{path}: row {number}: column {column}: {cell!r} is not an integer") from None
+                rows.append((fips, int(column[len(_POP_PREFIX):]), population, str(path), number,
+                             record["STNAME"], record["CTYNAME"]))
+    return rows
+
+
+SOURCES["census_county_population"] = census_county_population
