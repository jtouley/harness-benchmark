+++ b/tests/test_dbt_batch.py
@@ -0,0 +1,80 @@
+from decimal import Decimal
+from pathlib import Path
+
+import pyarrow as pa
+import pyarrow.dataset as ds
+import pyarrow.types as pat
+import pytest
+
+from engine.config import load_pipeline
+from engine.core import run_pipeline
+from tests.helpers import run_dbt, write_fixture_repo
+
+BUILD = Path(__file__).resolve().parents[1] / "pipelines" / "build.yml"
+MART = "mart_fy2024_monthly_county_agency.parquet"
+
+
+def _mart(marts: Path) -> pa.Table:
+    return ds.dataset(str(marts / MART), format="parquet").to_table()
+
+
+@pytest.fixture
+def fixture_lake(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    write_fixture_repo(tmp_path)
+    run_pipeline(load_pipeline(BUILD), lake_dir=tmp_path / "lake", run_id="r")
+    return tmp_path / "lake"
+
+
+@pytest.fixture
+def built(tmp_path, fixture_lake):
+    marts = tmp_path / "out" / "marts"
+    marts.mkdir(parents=True)
+    result = run_dbt(fixture_lake, marts, tmp_path / "warehouse.duckdb", exclude="tag:stream")
+    assert result.returncode == 0, result.stdout[-4000:]
+    return marts
+
+
+def test_mart_is_published_under_the_marts_dir(built):
+    assert (built / MART).is_file()
+
+
+def test_mart_totals_match_the_source_and_the_sentinel_takes_blank_or_unmatched_counties(built):
+    rows = _mart(built).to_pylist()
+    assert sum(r["net_obligations"] for r in rows) == Decimal("26.28")
+    sentinel = [r for r in rows if r["county_fips"] == "00000"]
+    assert sum(r["net_obligations"] for r in sentinel) == Decimal("16.25")  # -4.25 blank + 20.50 unmatched
+    assert all(r["obligations_per_person"] is None for r in sentinel)
+
+
+def test_fallback_population_is_the_latest_earlier_value_and_is_labelled(built):
+    rows = {r["county_fips"]: r for r in _mart(built).to_pylist()}
+    assert rows["09001"]["population"] == 41
+    assert rows["09001"]["population_year"] == 2021
+    assert rows["01003"]["population_year"] == 2024
+
+
+def test_per_person_is_rounded_half_even_once_at_four_places(built):
+    rows = {r["county_fips"]: r for r in _mart(built).to_pylist()}
+    # 0.03 / 8 = 0.00375 exactly; the fourth place is a tie and 7 is odd, so it rounds up to 0.0038.
+    assert rows["01003"]["obligations_per_person"] == Decimal("0.0038")
+
+
+def test_marts_have_no_float_columns(built):
+    schema = _mart(built).schema
+    floats = [f.name for f in schema if pat.is_floating(f.type)]
+    assert floats == []
+    assert schema.field("net_obligations").type == pa.decimal128(18, 2)
+    assert schema.field("obligations_per_person").type == pa.decimal128(18, 4)
+
+
+def test_make_build_twice_marts_equal(tmp_path, fixture_lake):
+    marts = tmp_path / "out" / "marts"
+    marts.mkdir(parents=True)
+    warehouse = tmp_path / "warehouse.duckdb"
+    assert run_dbt(fixture_lake, marts, warehouse, exclude="tag:stream").returncode == 0
+    first = _mart(marts).sort_by("mart_key")
+    assert run_dbt(fixture_lake, marts, warehouse, exclude="tag:stream").returncode == 0
+    second = _mart(marts).sort_by("mart_key")
+    assert first.schema == second.schema
+    assert first.equals(second)
diff --git a/tests/test_dbt_stream.py b/tests/test_dbt_stream.py
new file mode 100644
index 0000000..83313ea
--- /dev/null
+++ b/tests/test_dbt_stream.py
@@ -0,0 +1,116 @@
+import pyarrow as pa
+import pyarrow.dataset as ds
+import pyarrow.parquet as pq
+import pytest
+
+from engine.registry import RunContext
+from engine.sources.sse import SSE_SCHEMA
+from engine.stream_sink import stream_lake_sink
+from tests.helpers import run_dbt
+
+MART = "mart_wiki_window_5min.parquet"
+STREAM = {"name": "stream_recentchange", "kind": "stream_lake", "table": "stream_recentchange", "inputs": []}
+
+
+def ev(meta_id, timestamp, type_="edit", wiki="enwiki", namespace=0, bot=False, old=100, new=120):
+    return {
+        "sse_id": f"id-{meta_id}", "meta_id": meta_id, "timestamp": timestamp, "wiki": wiki,
+        "namespace": namespace, "bot": bot, "type": type_, "length_old": old, "length_new": new,
+    }
+
+
+def batch(events):
+    return pa.RecordBatch.from_pylist(events, schema=SSE_SCHEMA)
+
+
+BATCH_1 = [
+    ev("A1", 1000, old=100, new=150),
+    ev("A2", 1010, old=150, new=120),
+    ev("A3", 1900, old=100, new=130),                                  # window 1800
+    ev("A4", 2300, type_="new", wiki="dewiki", old=None, new=80),     # watermark 2300
+    ev("A5", 1020, type_="categorize", namespace=14, old=None, new=None),
+]
+BATCH_2 = [
+    ev("A2", 1010, old=150, new=120),                                 # redelivery, dropped
+    ev("B1", 2000, old=130, new=140),                                 # window 1800, on time
+]
+BATCH_3_LATE = [ev("C1", 900, old=1, new=2)]                         # window 900, 2300 > 1200 + 600: late
+
+
+class Lake:
+    def __init__(self, root):
+        self.lake = root / "lake"
+        self.marts = root / "out" / "marts"
+        self.warehouse = root / "warehouse.duckdb"
+        self.marts.mkdir(parents=True)
+
+    def ingest(self, events):
+        stream_lake_sink(STREAM, [batch(events)], RunContext(lake_dir=self.lake, run_id="r"))
+
+    def dbt(self, **kwargs):
+        result = run_dbt(self.lake, self.marts, self.warehouse, select="tag:stream", **kwargs)
+        assert result.returncode == 0, result.stdout[-4000:]
+
+    def run(self, events=None):
+        """Ingest one batch when given, run the stream models, and return the mart."""
+        if events is not None:
+            self.ingest(events)
+        self.dbt()
+        return self.mart()
+
+    def assert_matches_full_rebuild(self, incremental):
+        self.dbt(full_refresh=True)
+        assert incremental.equals(self.mart())
+
+    def mart(self):
+        table = ds.dataset(str(self.marts / MART), format="parquet").to_table()
+        return table.sort_by("window_key")
+
+    def fact(self):
+        return pq.read_table(self.lake / "stream_recentchange").num_rows
+
+
+@pytest.fixture
+def lake(tmp_path):
+    return Lake(tmp_path)
+
+
+def _by_key(table):
+    return {(r["window_start"], r["wiki"], r["namespace"], r["actor_type"]): r for r in table.to_pylist()}
+
+
+def test_first_run_matches_a_full_rebuild(lake):
+    incremental = lake.run(BATCH_1)
+    lake.assert_matches_full_rebuild(incremental)
+    rows = _by_key(incremental)
+    assert rows[(900, "enwiki", 0, "human")]["edit_count"] == 2  # A1 and A2 share the window
+    assert rows[(2100, "dewiki", 0, "human")]["net_bytes_added"] == 80
+
+
+def test_batch_two_equals_a_full_rebuild_and_a_key_touched_by_both_batches_has_one_row(lake):
+    lake.run(BATCH_1)
+    incremental = lake.run(BATCH_2)
+    lake.assert_matches_full_rebuild(incremental)
+
+    rows = _by_key(incremental)
+    touched = [r for r in incremental.to_pylist() if r["window_start"] == 1800 and r["wiki"] == "enwiki"]
+    assert len(touched) == 1
+    assert touched[0]["edit_count"] == 2
+    assert touched[0]["net_bytes_added"] == 40
+    assert touched[0]["last_arrival_seq"] == 6
+    assert rows[(900, "enwiki", 0, "human")]["net_bytes_added"] == 20
+
+
+def test_increment_without_new_on_time_rows_changes_nothing(lake):
+    lake.run(BATCH_1)
+    before = lake.run(BATCH_2)
+    assert lake.run().equals(before)
+
+
+def test_late_only_batch_leaves_the_mart_unchanged(lake):
+    before = lake.run(BATCH_1)
+    assert lake.run(BATCH_3_LATE).equals(before)
+    late = [r for f in (lake.lake / "late_events").glob("late-*.parquet") for r in pq.read_table(f).to_pylist()]
+    # The late rule applies to every event. A5 (categorize, after A4 raised the watermark) is late too; it is not an edit.
+    assert sorted(r["meta_id"] for r in late) == ["A5", "C1"]
+    assert all(r["is_late"] for r in late)
diff --git a/tests/test_lake.py b/tests/test_lake.py
new file mode 100644
index 0000000..f99dc88
--- /dev/null
+++ b/tests/test_lake.py
@@ -0,0 +1,115 @@
+from pathlib import Path
+
+import pyarrow as pa
+import pyarrow.dataset as ds
+import pytest
+
+from engine.core import run_pipeline
+from engine.lake import Crash, recover_lake, write_table
+
+
+def _table(values):
+    return pa.table({
+        "id": pa.array(values, pa.int64()),
+        "wiki": pa.array(["enwiki" if v % 2 else "dewiki" for v in values]),
+        "_source_file": pa.array(["data.csv"] * len(values)),
+        "_source_row": pa.array(list(range(len(values))), pa.int64()),
+    })
+
+
+def _read(path: Path) -> pa.Table:
+    return ds.dataset(str(path), format="parquet", partitioning="hive").to_table().sort_by("id")
+
+
+def _config(partition_by=None):
+    sink = {"name": "lake", "kind": "parquet_lake", "inputs": ["raw"], "table": "awards"}
+    if partition_by:
+        sink["partition_by"] = partition_by
+    return {
+        "sources": [{"name": "raw", "kind": "csv", "path": "x.csv"}],
+        "sinks": [sink],
+    }
+
+
+def _source(values):
+    return lambda entry, ctx: _table(values)
+
+
+def _run(lake, run_id, values, partition_by=None):
+    return run_pipeline(
+        _config(partition_by),
+        lake_dir=lake,
+        run_id=run_id,
+        sources={"csv": _source(values)},
+    )
+
+
+def test_two_runs_over_same_input_give_equal_content(tmp_path):
+    lake = tmp_path / "lake"
+    _run(lake, "r1", [1, 2, 3])
+    first = _read(lake / "awards")
+    _run(lake, "r2", [1, 2, 3])
+    second = _read(lake / "awards")
+    assert first.schema == second.schema
+    assert first.equals(second)
+
+
+def test_lake_has_load_metadata_and_no_wall_clock_column(tmp_path):
+    lake = tmp_path / "lake"
+    _run(lake, "r1", [1, 2])
+    names = _read(lake / "awards").column_names
+    assert "_source_file" in names and "_source_row" in names
+    assert not any(pa.types.is_timestamp(f.type) for f in _read(lake / "awards").schema)
+
+
+def test_partition_by_writes_hive_folders(tmp_path):
+    lake = tmp_path / "lake"
+    _run(lake, "r1", [1, 2, 3], partition_by=["wiki"])
+    folders = sorted(p.name for p in (lake / "awards").iterdir() if p.is_dir())
+    assert folders == ["wiki=dewiki", "wiki=enwiki"]
+
+
+def _crash_at(lake, point, values, run_id):
+    def crash(name):
+        if name == point:
+            raise Crash(name)
+
+    with pytest.raises(Crash):
+        write_table(lake, "awards", _table(values), [], run_id, checkpoint=crash)
+
+
+def test_failure_after_write_keeps_old_table_and_next_run_removes_temp(tmp_path):
+    lake = tmp_path / "lake"
+    write_table(lake, "awards", _table([1]), [], "r1")
+    before = _read(lake / "awards")
+
+    _crash_at(lake, "after_write", [1, 2], "r2")
+    assert (lake / ".tmp-awards-r2").exists()
+
+    recover_lake(lake)
+    assert not (lake / ".tmp-awards-r2").exists()
+    assert _read(lake / "awards").equals(before)
+
+
+def test_crash_between_renames_is_restored_by_next_run(tmp_path):
+    lake = tmp_path / "lake"
+    write_table(lake, "awards", _table([1]), [], "r1")
+    before = _read(lake / "awards")
+
+    _crash_at(lake, "after_old_moved", [1, 2], "r2")
+    assert not (lake / "awards").exists()
+
+    recover_lake(lake)
+    assert _read(lake / "awards").equals(before)
+    assert not any(p.name.startswith(".old-") for p in lake.iterdir())
+
+
+def test_crash_after_swap_keeps_new_table_and_next_run_removes_old(tmp_path):
+    lake = tmp_path / "lake"
+    write_table(lake, "awards", _table([1]), [], "r1")
+
+    _crash_at(lake, "after_swap", [1, 2], "r2")
+
+    recover_lake(lake)
+    assert _read(lake / "awards").column("id").to_pylist() == [1, 2]
+    assert not any(p.name.startswith(".old-") for p in lake.iterdir())
