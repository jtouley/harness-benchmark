diff --git a/engine/tests/test_validate.py b/engine/tests/test_validate.py
new file mode 100644
index 0000000..3af7e8f
--- /dev/null
+++ b/engine/tests/test_validate.py
@@ -0,0 +1,133 @@
+"""Pipeline YAML validation: each error names file, line and problem (cd-1-engine-schema)."""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+import textwrap
+from pathlib import Path
+
+from engine.config import Problem, validate_file
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+
+VALID = textwrap.dedent(
+    """\
+    name: batch
+    sources:
+      - id: census
+        kind: file
+        format: csv
+        path: data/raw/census/co-est2024-alldata.csv
+    transforms:
+      - id: census_clean
+        engine: polars
+        input: census
+        steps:
+          - op: filter_equals
+            column: SUMLEV
+            value: "050"
+    sinks:
+      - id: census_lake
+        kind: parquet_lake
+        input: census_clean
+        path: lake/census
+        key: [STATE, COUNTY]
+    """
+)
+
+
+def _write(tmp_path: Path, text: str) -> Path:
+    path = tmp_path / "pipeline.yml"
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def _line_of(text: str, needle: str) -> int:
+    for number, line in enumerate(text.splitlines(), start=1):
+        if needle in line:
+            return number
+    raise AssertionError(f"{needle!r} not in fixture")
+
+
+def _only_problem(tmp_path: Path, text: str) -> Problem:
+    problems = validate_file(_write(tmp_path, text))
+    assert len(problems) == 1, problems
+    return problems[0]
+
+
+def test_valid_pipeline_has_no_problems(tmp_path: Path) -> None:
+    assert validate_file(_write(tmp_path, VALID)) == []
+
+
+def test_unknown_engine_reports_file_line_problem(tmp_path: Path) -> None:
+    text = VALID.replace("engine: polars", "engine: pandas")
+
+    problem = _only_problem(tmp_path, text)
+
+    assert problem.file == tmp_path / "pipeline.yml"
+    assert problem.line == _line_of(text, "engine: pandas")
+    assert "'pandas' is not one of ['polars', 'datafusion']" in problem.message
+
+
+def test_missing_sink_reports_root_problem(tmp_path: Path) -> None:
+    problem = _only_problem(tmp_path, VALID.split("sinks:")[0])
+
+    assert problem.line == 1
+    assert "'sinks' is a required property" in problem.message
+
+
+def test_bad_type_reports_line_of_the_value(tmp_path: Path) -> None:
+    text = VALID.replace("path: lake/census", "path: 5")
+
+    problem = _only_problem(tmp_path, text)
+
+    assert problem.line == _line_of(text, "path: 5")
+    assert "5 is not of type 'string'" in problem.message
+
+
+def test_yaml_syntax_error_reports_line(tmp_path: Path) -> None:
+    text = VALID.replace("    input: census\n", "    input: [census\n")
+
+    problem = _only_problem(tmp_path, text)
+
+    # PyYAML reports the token where the flow sequence breaks, the line of "steps:".
+    assert problem.line == _line_of(text, "steps:")
+
+
+
+def _run_validate(path: Path) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [sys.executable, "-m", "engine", "validate", str(path)],
+        cwd=REPO_ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+
+def test_cli_validate_bad_file_prints_file_line_and_exits_nonzero(tmp_path: Path) -> None:
+    text = VALID.replace("engine: polars", "engine: pandas")
+    path = _write(tmp_path, text)
+
+    result = _run_validate(path)
+
+    expected_line = _line_of(text, "engine: pandas")
+    assert result.returncode != 0
+    assert f"{path}:{expected_line}: " in result.stderr
+    assert "'pandas' is not one of" in result.stderr
+
+
+def test_cli_validate_good_file_exits_zero(tmp_path: Path) -> None:
+    result = _run_validate(_write(tmp_path, VALID))
+
+    assert result.returncode == 0, result.stderr
+
+
+def test_cli_validate_missing_file_reports_file_and_exits_nonzero(tmp_path: Path) -> None:
+    missing = tmp_path / "absent.yml"
+
+    result = _run_validate(missing)
+
+    assert result.returncode != 0
+    assert f"{missing}:1: cannot read file" in result.stderr
