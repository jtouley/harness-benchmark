+"""Command line: `python -m engine validate <pipeline.yml> ...`."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+from engine.config import validate_file
+
+
+def _validate(files: list[str]) -> int:
+    failed = False
+    for name in files:
+        try:
+            problems = validate_file(Path(name))
+        except OSError as exc:
+            print(f"{name}:1: cannot read file: {exc.strerror}", file=sys.stderr)
+            failed = True
+            continue
+        for problem in problems:
+            print(problem, file=sys.stderr)
+        failed = failed or bool(problems)
+    return 1 if failed else 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="engine")
+    commands = parser.add_subparsers(dest="command", required=True)
+    validate = commands.add_parser("validate", help="check pipeline YAML files against the schema")
+    validate.add_argument("files", nargs="+")
+    args = parser.parse_args(argv)
+    if args.command == "validate":
+        return _validate(args.files)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
