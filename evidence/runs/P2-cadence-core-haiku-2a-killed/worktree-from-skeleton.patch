@@ -0,0 +1,70 @@
+"""The `stream_commit` sink: one micro-batch is one commit (D6).
+
+The batch is written to `_staging/<seq>/`. Renaming that folder to `commits/<seq>/` is the
+commit. Anything left in `_staging/` before a run is a crash leftover and is deleted.
+"""
+
+import json
+import os
+import shutil
+from pathlib import Path
+from typing import Any, Mapping
+
+import pyarrow as pa
+import pyarrow.compute as pc
+import pyarrow.parquet as pq
+
+from engine.stream.state import COUNT_KEYS, ConsumerState
+
+EDIT_COLUMNS = [
+    "event_id", "event_type", "wiki_host", "wiki", "namespace", "title", "user",
+    "actor_type", "timestamp", "window_start", "window_end", "byte_delta", "is_late",
+]
+
+
+def commit_micro_batch(
+    table: pa.Table,
+    options: Mapping[str, Any],
+    *,
+    lake_root: str | Path,
+    state: ConsumerState,
+    position: str | None,
+    duplicates: int,
+    malformed: int,
+) -> ConsumerState:
+    base = Path(lake_root) / options["table"]
+    commits = base / "commits"
+    commits.mkdir(parents=True, exist_ok=True)
+    seq = state.seq + 1
+    staging = base / "_staging" / f"{seq:06d}"
+    if staging.exists():
+        shutil.rmtree(staging)
+    staging.mkdir(parents=True)
+
+    in_scope = table["in_scope"]
+    late = table["is_late"]
+    on_time = table.filter(pc.and_(in_scope, pc.invert(late)))
+    late_rows = table.filter(pc.and_(in_scope, late))
+    other = table.num_rows - on_time.num_rows - late_rows.num_rows
+    counts = {
+        "edits": state.counts["edits"] + on_time.num_rows,
+        "late": state.counts["late"] + late_rows.num_rows,
+        "other": state.counts["other"] + other,
+        "duplicates": state.counts["duplicates"] + duplicates,
+        "malformed": state.counts["malformed"] + malformed,
+    }
+    watermark = max([state.watermark] + table["timestamp"].to_pylist())
+    new_position = position if position is not None else state.position
+    meta = {"seq": seq, "position": new_position, "watermark": watermark,
+            "counts": {key: counts[key] for key in COUNT_KEYS}}
+
+    pq.write_table(on_time.select(EDIT_COLUMNS), staging / "edits.parquet")
+    pq.write_table(late_rows.select(EDIT_COLUMNS), staging / "late_events.parquet")
+    pq.write_table(table.select(["event_id"]), staging / "ids.parquet")
+    (staging / "_consumer.json").write_text(json.dumps(meta), encoding="utf-8")
+    os.chmod(staging, 0o755)
+    os.rename(staging, commits / f"{seq:06d}")
+
+    seen = state.seen | set(table["event_id"].to_pylist())
+    return ConsumerState(seq=seq, position=new_position, watermark=watermark,
+                         counts=counts, seen=seen)
