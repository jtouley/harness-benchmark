+import pyarrow as pa
+import pyarrow.parquet as pq
+import pytest
+
+from engine.sinks import lake
+from engine.sinks.lake import write_lake
+
+
+def _table(ids):
+    return pa.table({"id": pa.array(ids, pa.int64()), "amount": [str(i) for i in ids]})
+
+
+def _read(root, name):
+    return pq.read_table(root / name / "part-0.parquet").sort_by("id").to_pylist()
+
+
+def test_two_writes_of_the_same_input_give_equal_rows(tmp_path):
+    write_lake(_table([3, 1, 2]), {"table": "t"}, lake_root=tmp_path)
+    first = _read(tmp_path, "t")
+
+    write_lake(_table([3, 1, 2]), {"table": "t"}, lake_root=tmp_path)
+
+    assert _read(tmp_path, "t") == first
+
+
+def test_failed_write_keeps_the_previous_table(tmp_path, monkeypatch):
+    write_lake(_table([1, 2]), {"table": "t"}, lake_root=tmp_path)
+    previous = _read(tmp_path, "t")
+
+    def disk_full(*args, **kwargs):
+        raise OSError("disk full")
+
+    monkeypatch.setattr(lake.pq, "write_table", disk_full)
+    with pytest.raises(OSError):
+        write_lake(_table([9]), {"table": "t"}, lake_root=tmp_path)
+
+    assert _read(tmp_path, "t") == previous
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["t"]
