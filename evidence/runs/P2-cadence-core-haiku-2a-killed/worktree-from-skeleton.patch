+
+transforms:
+  - name: classify
+    engine: python
+    input: recentchange
+    function: engine.stream.classify:classify_batch
+
+sinks:
+  - name: stream
+    kind: stream_commit
+    input: classify
+    table: stream
+    batch_size: 500
+    batch_seconds: 10
