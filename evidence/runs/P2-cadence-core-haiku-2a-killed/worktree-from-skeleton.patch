+"""The `lake` sink: one Parquet folder per table, `lake/<table>/part-0.parquet` (D2).
+
+The write goes to a staging folder first. Only when it is complete does the old table
+folder move aside and the staging folder take its place. A failure leaves the old table.
+"""
+
+import os
+import shutil
+import tempfile
+import uuid
+from pathlib import Path
+from typing import Any, Mapping
+
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+
+def write_lake(table: pa.Table, options: Mapping[str, Any], *, lake_root: str | Path) -> None:
+    root = Path(lake_root)
+    root.mkdir(parents=True, exist_ok=True)
+    target = root / options["table"]
+    staging = Path(tempfile.mkdtemp(prefix=f".{options['table']}.staging-", dir=root))
+    try:
+        os.chmod(staging, 0o755)  # mkdtemp creates 0700; readers such as dbt need to read it
+        pq.write_table(table, staging / "part-0.parquet")
+        _swap_in(staging, target)
+    except BaseException:
+        shutil.rmtree(staging, ignore_errors=True)
+        raise
+
+
+def _swap_in(staging: Path, target: Path) -> None:
+    previous = target.with_name(f"{target.name}.previous-{uuid.uuid4().hex}")
+    had_previous = target.exists()
+    if had_previous:
+        os.rename(target, previous)
+    try:
+        os.rename(staging, target)
+    except BaseException:
+        if had_previous:
+            os.rename(previous, target)
+        raise
+    if had_previous:
+        shutil.rmtree(previous)
