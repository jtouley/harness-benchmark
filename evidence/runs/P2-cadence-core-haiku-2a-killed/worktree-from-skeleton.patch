diff --git a/transform/models/batch/dim_date.sql b/transform/models/batch/dim_date.sql
new file mode 100644
index 0000000..c28ef69
--- /dev/null
+++ b/transform/models/batch/dim_date.sql
@@ -0,0 +1,11 @@
+-- Grain: one calendar month that has a transaction. The date key is the first day of the month.
+-- Fiscal years start on 1 October, so FY = calendar year + 1 from October on.
+with months as (
+    select distinct date_trunc('month', action_date)::date as month_start
+    from {{ ref('stg_usaspending_transactions') }}
+)
+select
+    month_start as date_key,
+    month_start,
+    cast(extract(year from month_start) + case when extract(month from month_start) >= 10 then 1 else 0 end as integer) as fiscal_year
+from months
diff --git a/transform/models/batch/dim_place.sql b/transform/models/batch/dim_place.sql
new file mode 100644
index 0000000..ed5a851
--- /dev/null
+++ b/transform/models/batch/dim_place.sql
@@ -0,0 +1,34 @@
+-- Grain: one place of performance county, plus one UNKNOWN county per state (D4).
+-- A row with no county maps to its state's UNKNOWN member, so state and source totals reconcile.
+-- A county without a 2024 population (Connecticut's old county codes, territories) has a null population.
+with usa_states as (
+    select distinct coalesce(state_fips, 'UNKNOWN') as state_fips
+    from {{ ref('stg_usaspending_transactions') }}
+),
+usa_counties as (
+    select distinct state_fips, county_fips
+    from {{ ref('stg_usaspending_transactions') }}
+    where state_fips is not null and county_fips is not null
+),
+counties as (
+    select state_fips, county_fips from {{ ref('stg_census_county_population') }}
+    union
+    select state_fips, county_fips from usa_counties
+),
+members as (
+    select state_fips, county_fips, false as is_unknown_county from counties
+    union all
+    select state_fips, 'UNKNOWN' as county_fips, true as is_unknown_county from usa_states
+)
+select
+    m.state_fips || '-' || m.county_fips as place_key,
+    m.state_fips,
+    m.county_fips,
+    m.is_unknown_county,
+    c.county_name,
+    c.population,
+    c.population_source_year,
+    c.population_vintage
+from members m
+left join {{ ref('stg_census_county_population') }} c
+    on c.state_fips = m.state_fips and c.county_fips = m.county_fips
diff --git a/transform/models/batch/fct_award_transactions.sql b/transform/models/batch/fct_award_transactions.sql
