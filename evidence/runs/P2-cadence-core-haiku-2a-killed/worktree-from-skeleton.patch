@@ -0,0 +1,91 @@
+"""File source: CSV, JSON lines, and CSV members of zip files, read in memory.
+
+Every row gets `_source_file` (the file name, or `zip/member`) and `_source_sha256` (the
+SHA-256 of the file on disk). There is no timestamp, so a re-run gives the same rows (D2).
+Zip archives are never extracted.
+"""
+
+import csv
+import fnmatch
+import glob
+import hashlib
+import io
+import os
+import zipfile
+from typing import Any, Mapping
+
+import pyarrow as pa
+import pyarrow.csv as pacsv
+import pyarrow.json as pajson
+
+_BOM = b"\xef\xbb\xbf"
+
+
+def read_file(options: Mapping[str, Any]) -> pa.Table:
+    pattern = options["path"]
+    paths = sorted(glob.glob(pattern))
+    if not paths:
+        raise FileNotFoundError(f"{pattern}: no files match")
+    encoding = options.get("encoding", "utf-8")
+    tables = []
+    for path in paths:
+        if path.lower().endswith(".zip"):
+            tables.extend(_read_zip(path, options.get("member", "*.csv"), encoding))
+        else:
+            with open(path, "rb") as fh:
+                data = fh.read()
+            tables.append(_table(data, _format(options, path), encoding,
+                                 os.path.basename(path), hashlib.sha256(data).hexdigest()))
+    table = pa.concat_tables(tables, promote_options="permissive")
+    for name, value in options.get("constants", {}).items():
+        table = table.append_column(name, pa.array([value] * table.num_rows))
+    return table
+
+
+def _read_zip(path: str, member_pattern: str, encoding: str) -> list[pa.Table]:
+    with open(path, "rb") as fh:
+        archive_bytes = fh.read()
+    digest = hashlib.sha256(archive_bytes).hexdigest()
+    base = os.path.basename(path)
+    tables = []
+    with zipfile.ZipFile(io.BytesIO(archive_bytes)) as archive:
+        for member in sorted(archive.namelist()):
+            if member.endswith("/") or not fnmatch.fnmatch(member, member_pattern):
+                continue
+            data = archive.read(member)
+            tables.append(_table(data, "csv", encoding, f"{base}/{member}", digest))
+    return tables
+
+
+def _format(options: Mapping[str, Any], path: str) -> str:
+    if "format" in options:
+        return options["format"]
+    return "json" if path.lower().endswith((".json", ".jsonl", ".ndjson")) else "csv"
+
+
+def _table(data: bytes, fmt: str, encoding: str, source: str, digest: str) -> pa.Table:
+    if data.startswith(_BOM):
+        data = data[len(_BOM):]
+    if encoding.lower().replace("_", "-") not in ("utf-8", "utf8"):
+        data = data.decode(encoding).encode("utf-8")
+    if fmt == "csv":
+        table = _read_csv(data)
+    elif fmt == "json":
+        table = pajson.read_json(io.BytesIO(data))
+    elif fmt == "json_document":
+        table = pa.table({"document": [data.decode("utf-8")]})
+    else:
+        raise ValueError(f"{source}: unknown format {fmt!r}")
+    rows = table.num_rows
+    table = table.append_column("_source_file", pa.array([source] * rows, pa.string()))
+    return table.append_column("_source_sha256", pa.array([digest] * rows, pa.string()))
+
+
+def _read_csv(data: bytes) -> pa.Table:
+    first_line = data.split(b"\n", 1)[0].decode("utf-8").rstrip("\r")
+    header = next(csv.reader([first_line]), [])
+    # Every column is read as text. The transforms cast what they need, so money is never a float.
+    types = {name: pa.string() for name in header}
+    options = pacsv.ConvertOptions(column_types=types)
+    parse = pacsv.ParseOptions(newlines_in_values=True)
+    return pacsv.read_csv(io.BytesIO(data), parse_options=parse, convert_options=options)
