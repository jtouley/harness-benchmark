+import pyarrow as pa
+
+from engine.stream.classify import classify_batch, is_late, window_start
+
+
+def test_windows_are_aligned_to_multiples_of_300_seconds():
+    assert window_start(0) == 0
+    assert window_start(299) == 0
+    assert window_start(300) == 300
+
+
+def test_event_exactly_ten_minutes_after_window_end_is_on_time():
+    window_end = 600
+    assert is_late(watermark_before=1200, window_end=window_end) is False
+    assert is_late(watermark_before=1201, window_end=window_end) is True
+
+
+def test_watermark_before_each_row_includes_earlier_rows_of_the_batch():
+    batch = pa.table({
+        "event_id": ["a", "b"],
+        "event_type": ["edit", "edit"],
+        "timestamp": [2000, 1000],
+        "_watermark_before": [0, 0],
+    })
+
+    out = classify_batch(batch)
+
+    assert out["is_late"].to_pylist() == [False, True]
+    assert out["window_start"].to_pylist() == [1800, 900]
+    assert out["window_end"].to_pylist() == [2100, 1200]
+
+
+def test_only_edit_and_new_are_in_scope():
+    batch = pa.table({
+        "event_id": ["a", "b", "c"],
+        "event_type": ["edit", "new", "log"],
+        "timestamp": [1000, 1000, 1000],
+        "_watermark_before": [0, 0, 0],
+    })
+
+    assert classify_batch(batch)["in_scope"].to_pylist() == [True, True, False]
diff --git a/tests/test_stream_consumer.py b/tests/test_stream_consumer.py
new file mode 100644
index 0000000..d3786e5
--- /dev/null
+++ b/tests/test_stream_consumer.py
@@ -0,0 +1,166 @@
+import hashlib
+import json
+from pathlib import Path
+
+import pyarrow.parquet as pq
+import pytest
+
+from engine.config import load
+from engine.sources.sse import SseParser
+from engine.stream.runner import run_stream
+from tests.conftest import recentchange
+
+SAMPLE = Path(__file__).parent / "fixtures" / "stream" / "replay_sample.sse"
+
+STREAM_YAML = """\
+sources:
+  - name: recentchange
+    kind: sse
+    url: ${STREAM_URL:-http://localhost:8099/v2/stream/recentchange}
+transforms:
+  - name: classify
+    engine: python
+    input: recentchange
+    function: engine.stream.classify:classify_batch
+sinks:
+  - name: stream
+    kind: stream_commit
+    input: classify
+    table: stream
+    batch_size: 3
+    batch_seconds: 60
+"""
+
+
+def _run(tmp_path: Path, url: str, lake: Path, duration: float = 20) -> None:
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    cfg_path = tmp_path / "stream.yml"
+    cfg_path.write_text(STREAM_YAML, encoding="utf-8")
+    cfg = load(str(cfg_path), env={"STREAM_URL": url})
+    run_stream(cfg, lake_root=lake, duration=duration)
+
+
+def _commit_rows(lake: Path, name: str) -> list[dict]:
+    rows: list[dict] = []
+    for commit in sorted((lake / "stream" / "commits").iterdir()):
+        rows.extend(pq.read_table(commit / f"{name}.parquet").to_pylist())
+    return rows
+
+
+def _consumer(lake: Path) -> dict:
+    last = sorted((lake / "stream" / "commits").iterdir())[-1]
+    return json.loads((last / "_consumer.json").read_text(encoding="utf-8"))
+
+
+def _edit_events(n: int, start: int = 0):
+    return [(f"id-{i}", recentchange(f"m{i}", 1_000_000 + i * 7)) for i in range(start, start + n)]
+
+
+def test_duplicate_meta_id_is_counted_once(tmp_path, serve_sse):
+    events = [
+        ("id-0", recentchange("m0", 1_000_000)),
+        ("id-1", recentchange("m1", 1_000_010)),
+        ("id-2", recentchange("m0", 1_000_000)),  # the same event again, later in the stream
+        ("id-3", recentchange("m2", 1_000_020)),
+    ]
+    script = serve_sse(events)
+    lake = tmp_path / "lake"
+
+    _run(tmp_path, script.url, lake)
+
+    assert sorted(r["event_id"] for r in _commit_rows(lake, "edits")) == ["m0", "m1", "m2"]
+    assert _consumer(lake)["counts"]["duplicates"] == 1
+
+
+def test_disconnect_neither_loses_nor_doubles_an_event(tmp_path, serve_sse):
+    events = _edit_events(120)
+    script = serve_sse(events, drop_first_after=50)
+    lake = tmp_path / "lake"
+
+    _run(tmp_path, script.url, lake)
+
+    assert len(_commit_rows(lake, "edits")) == 120
+    assert _consumer(lake)["counts"]["edits"] == 120
+
+
+def test_restart_gives_the_same_commits_as_one_uninterrupted_run(tmp_path, serve_sse):
+    late_tail = [("id-late", recentchange("late", 1_000_000 - 5_000))]
+    events = _edit_events(60) + late_tail
+
+    whole = serve_sse(events)
+    _run(tmp_path / "a", whole.url, tmp_path / "a" / "lake")
+
+    first = serve_sse(events[:30])
+    _run(tmp_path / "b", first.url, tmp_path / "b" / "lake")
+    second = serve_sse(events)
+    _run(tmp_path / "b", second.url, tmp_path / "b" / "lake")
+
+    a, b = tmp_path / "a" / "lake", tmp_path / "b" / "lake"
+    assert _commit_rows(a, "late_events") == _commit_rows(b, "late_events")
+    assert sorted(map(str, _commit_rows(a, "edits"))) == sorted(map(str, _commit_rows(b, "edits")))
+    assert _consumer(a)["counts"] == _consumer(b)["counts"]
+    assert _consumer(a)["watermark"] == _consumer(b)["watermark"]
+    assert _consumer(a)["counts"]["late"] == 1
+
+
+def test_a_staging_folder_left_by_a_crash_is_ignored(tmp_path, serve_sse):
+    events = _edit_events(60)
+    lake = tmp_path / "lake"
+    first = serve_sse(events[:30])
+    _run(tmp_path, first.url, lake)
+    next_seq = len(list((lake / "stream" / "commits").iterdir())) + 1
+    crashed = lake / "stream" / "_staging" / f"{next_seq:06d}"
+    crashed.mkdir(parents=True)
+    (crashed / "edits.parquet").write_bytes(b"partial")
+
+    second = serve_sse(events)
+    _run(tmp_path, second.url, lake)
+
+    assert not crashed.exists() or not any(crashed.iterdir())
+    assert sorted(r["event_id"] for r in _commit_rows(lake, "edits")) == sorted(
+        f"m{i}" for i in range(60))
+
+
+def test_replay_sample_has_no_late_events(tmp_path, serve_sse):
+    parser = SseParser()
+    sample = []
+    for line in SAMPLE.read_bytes().splitlines(keepends=True):
+        event = parser.feed(line)
+        if event is not None:
+            sample.append((event.id, event.data))
+    assert len(sample) == 200
+    script = serve_sse(sample)
+    lake = tmp_path / "lake"
+
+    _run(tmp_path, script.url, lake)
+
+    assert _consumer(lake)["counts"]["late"] == 0
+
+
+def test_canary_event_without_a_timestamp_is_counted_as_other(tmp_path, serve_sse):
+    canary = json.dumps({
+        "$schema": "/mediawiki/recentchange/1.0.1",
+        "meta": {"id": "canary-1", "dt": "2026-10-15T00:15:00.000Z", "domain": "canary"},
+    })
+    events = [("id-0", recentchange("m0", 1_000_000)), ("id-1", canary)]
+    script = serve_sse(events)
+    lake = tmp_path / "lake"
+
+    _run(tmp_path, script.url, lake)
+
+    assert _consumer(lake)["counts"]["other"] == 1
+    assert _consumer(lake)["counts"]["edits"] == 1
+
+
+def test_malformed_event_is_counted_and_skipped_without_stopping_the_run(tmp_path, serve_sse):
+    truncated = '{"meta": {"id": "cut"}, "type": "edit", "title": "User:X",'
+    events = [("id-0", recentchange("m0", 1_000_000)), ("id-1", truncated),
+              ("id-2", recentchange("m1", 1_000_010))]
+    script = serve_sse(events)
+    lake = tmp_path / "lake"
+
+    _run(tmp_path, script.url, lake)
+
+    assert _consumer(lake)["counts"]["malformed"] == 1
+    assert sorted(r["event_id"] for r in _commit_rows(lake, "edits")) == ["m0", "m1"]
+    assert _consumer(lake)["position"] == "id-2"
