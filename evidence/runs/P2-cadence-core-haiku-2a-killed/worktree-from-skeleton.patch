new file mode 100644
index 0000000..a866df0
--- /dev/null
+++ b/engine/stream/classify.py
@@ -0,0 +1,39 @@
+"""Window and lateness for stream events (D7). Pure: the watermark comes in with each batch.
+
+A window is 300 seconds, aligned to UTC multiples of 300. An event is late when, at its
+first arrival, the watermark (the highest event time seen before it) is more than 600
+seconds past the end of its window. The comparison is strict.
+"""
+
+import pyarrow as pa
+
+WINDOW_SECONDS = 300
+LATE_AFTER_SECONDS = 600
+SCOPE_TYPES = ("edit", "new")
+
+
+def window_start(timestamp: int) -> int:
+    return (timestamp // WINDOW_SECONDS) * WINDOW_SECONDS
+
+
+def is_late(watermark_before: int, window_end: int) -> bool:
+    return watermark_before > window_end + LATE_AFTER_SECONDS
+
+
+def classify_batch(table: pa.Table) -> pa.Table:
+    """Add window_start, window_end, in_scope and is_late. Rows are first arrivals, in order."""
+    timestamps = table["timestamp"].to_pylist()
+    watermark = table["_watermark_before"][0].as_py() if table.num_rows else 0
+    starts, ends, late = [], [], []
+    for ts in timestamps:
+        start = window_start(ts)
+        end = start + WINDOW_SECONDS
+        starts.append(start)
+        ends.append(end)
+        late.append(is_late(watermark, end))
+        watermark = max(watermark, ts)
+    in_scope = [kind in SCOPE_TYPES for kind in table["event_type"].to_pylist()]
+    table = table.append_column("window_start", pa.array(starts, pa.int64()))
+    table = table.append_column("window_end", pa.array(ends, pa.int64()))
+    table = table.append_column("in_scope", pa.array(in_scope, pa.bool_()))
+    return table.append_column("is_late", pa.array(late, pa.bool_()))
diff --git a/engine/stream/runner.py b/engine/stream/runner.py
new file mode 100644
index 0000000..db6b75f
--- /dev/null
+++ b/engine/stream/runner.py
@@ -0,0 +1,132 @@
+"""The stream run loop: read SSE events, batch them, classify, and commit each batch.
+
+Dedupe on `meta.id` happens here, against the committed ids and earlier events of the same
+batch. A duplicate does not move the watermark (D7). A batch closes when it holds
+`batch_size` events or `batch_seconds` have passed since it opened.
+"""
+
+import json
+import shutil
+import time
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+import pyarrow as pa
+
+from engine import builtins  # noqa: F401  registers the built-in kinds
+from engine.registry import SINKS, SOURCES, TRANSFORMS
+from engine.stream.state import ConsumerState, load_state
+
+ROW_SCHEMA = pa.schema([
+    ("event_id", pa.string()),
+    ("sse_id", pa.string()),
+    ("event_type", pa.string()),
+    ("wiki_host", pa.string()),
+    ("wiki", pa.string()),
+    ("namespace", pa.int64()),
+    ("title", pa.string()),
+    ("user", pa.string()),
+    ("actor_type", pa.string()),
+    ("timestamp", pa.int64()),
+    ("byte_delta", pa.int64()),
+    ("_watermark_before", pa.int64()),
+])
+
+
+def run_stream(config: Mapping[str, Any], *, lake_root: str | Path, duration: float,
+               clock: Callable[[], float] = time.monotonic) -> None:
+    source = _single(config, "sources", "sse")
+    sink = _single(config, "sinks", "stream_commit")
+    transforms = config.get("transforms", [])
+    table_dir = Path(lake_root) / sink["table"]
+    shutil.rmtree(table_dir / "_staging", ignore_errors=True)
+
+    state = load_state(table_dir)
+    deadline = clock() + duration
+    events = SOURCES[source["kind"]].run({
+        **_options(source), "deadline": deadline, "last_event_id": state.position,
+    })
+    sink_options = _options(sink)
+    batch_size = sink_options.get("batch_size", 500)
+    batch_seconds = sink_options.get("batch_seconds", 10)
+
+    batch: list[tuple[str | None, dict | None]] = []
+    opened = clock()
+    for item in events:
+        if item is not None:
+            batch.append((item.id, _parse(item.data)))
+        if batch and (len(batch) >= batch_size or clock() - opened >= batch_seconds):
+            state = _commit(batch, state, transforms, sink_options, lake_root)
+            batch, opened = [], clock()
+    if batch:
+        _commit(batch, state, transforms, sink_options, lake_root)
+
+
+def _parse(text: str) -> dict | None:
+    """None for an event whose JSON is damaged. The replay server has sent such events."""
+    try:
+        return json.loads(text)
+    except ValueError:
+        return None
+
+
+def _commit(batch, state: ConsumerState, transforms, sink_options, lake_root) -> ConsumerState:
+    rows, duplicates, malformed, position, in_batch = [], 0, 0, None, set()
+    for sse_id, data in batch:
+        position = sse_id if sse_id is not None else position
+        if data is None:
+            malformed += 1
+            continue
+        event_id = data["meta"]["id"]
+        if event_id in state.seen or event_id in in_batch:
+            duplicates += 1
+            continue
+        in_batch.add(event_id)
+        rows.append(_row(sse_id, data, state.watermark))
+    table = pa.Table.from_pylist(rows, schema=ROW_SCHEMA)
+    for transform in transforms:
+        table = TRANSFORMS[transform["engine"]].run(_options(transform), table)
+    return SINKS["stream_commit"].run(
+        table, sink_options, lake_root=lake_root,
+        state=state, position=position, duplicates=duplicates, malformed=malformed,
+    )
+
+
+def _row(sse_id: str | None, data: Mapping[str, Any], watermark: int) -> dict[str, Any]:
+    length = data.get("length") or {}
+    old, new = length.get("old"), length.get("new")
+    byte_delta = None if old is None and new is None else (new or 0) - (old or 0)
+    return {
+        "event_id": data["meta"]["id"],
+        "sse_id": sse_id,
+        "event_type": data.get("type"),
+        "wiki_host": data.get("server_name"),
+        "wiki": data.get("wiki"),
+        "namespace": data.get("namespace"),
+        "title": data.get("title"),
+        "user": data.get("user"),
+        "actor_type": "bot" if data.get("bot") else "human",
+        "timestamp": _event_seconds(data),
+        "byte_delta": byte_delta,
+        "_watermark_before": watermark,
+    }
+
+
+def _event_seconds(data: Mapping[str, Any]) -> int:
+    """Event time in seconds. Canary and other non-edit events may lack `timestamp`, so `meta.dt` is the fallback."""
+    if data.get("timestamp") is not None:
+        return int(data["timestamp"])
+    moment = datetime.fromisoformat(data["meta"]["dt"].replace("Z", "+00:00"))
+    return int(moment.timestamp())
+
+
+def _single(config: Mapping[str, Any], section: str, kind: str) -> Mapping[str, Any]:
+    matches = [node for node in config.get(section, []) if node["kind"] == kind]
+    if len(matches) != 1:
+        raise ValueError(f"a stream run needs exactly one {section[:-1]} of kind {kind!r}")
+    return matches[0]
+
+
+def _options(node: Mapping[str, Any]) -> dict[str, Any]:
+    return {key: value for key, value in node.items() if key not in {"name", "kind", "engine", "input"}}
diff --git a/engine/stream/state.py b/engine/stream/state.py
new file mode 100644
index 0000000..b13c3ae
--- /dev/null
+++ b/engine/stream/state.py
@@ -0,0 +1,48 @@
+"""Consumer state, persisted with the data (D6). The state of a run is its last commit.
+
+A commit is `<table>/commits/<seq>/`. It holds the committed rows and `_consumer.json`:
+the sequence number, the SSE position, the watermark and the counts. Restart reads the
+highest sequence number and every committed `ids.parquet`, so no event is counted twice.
+"""
+
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import pyarrow.parquet as pq
+
+COUNT_KEYS = ("edits", "late", "other", "duplicates", "malformed")
+
+
+@dataclass
+class ConsumerState:
+    seq: int = 0
+    position: str | None = None
+    watermark: int = 0
+    counts: dict[str, int] = field(default_factory=lambda: {key: 0 for key in COUNT_KEYS})
+    seen: set[str] = field(default_factory=set)
+
+
+def commit_dirs(table_dir: Path) -> list[Path]:
+    commits = table_dir / "commits"
+    if not commits.is_dir():
+        return []
+    return sorted(path for path in commits.iterdir() if path.name.isdigit())
+
+
+def load_state(table_dir: Path) -> ConsumerState:
+    commits = commit_dirs(table_dir)
+    if not commits:
+        return ConsumerState()
+    meta = json.loads((commits[-1] / "_consumer.json").read_text(encoding="utf-8"))
+    seen: set[str] = set()
+    for commit in commits:
+        seen.update(pq.read_table(commit / "ids.parquet")["event_id"].to_pylist())
+    counts = {key: meta["counts"].get(key, 0) for key in COUNT_KEYS}  # older commits lack new keys
+    return ConsumerState(
+        seq=meta["seq"],
+        position=meta["position"],
+        watermark=meta["watermark"],
+        counts=counts,
+        seen=seen,
+    )
