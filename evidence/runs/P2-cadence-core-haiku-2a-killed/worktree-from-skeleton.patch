+"""Command line entry point: `python -m engine validate <file>` and `run <file>`."""
+
+import argparse
+import sys
+from typing import Sequence
+
+from engine.config import load
+from engine.errors import ConfigError
+from engine.runtime import run
+from engine.stream.runner import run_stream
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="python -m engine")
+    commands = parser.add_subparsers(dest="command", required=True)
+    commands.add_parser("validate").add_argument("file")
+    run_cmd = commands.add_parser("run")
+    run_cmd.add_argument("file")
+    run_cmd.add_argument("--duration", type=float, help="seconds to consume a stream")
+    args = parser.parse_args(argv)
+
+    try:
+        cfg = load(args.file)
+        if args.command == "run":
+            if any(source["kind"] == "sse" for source in cfg.get("sources", [])):
+                if args.duration is None:
+                    print("a stream run needs --duration SECONDS", file=sys.stderr)
+                    return 2
+                run_stream(cfg, lake_root="lake", duration=args.duration)
+            else:
+                run(cfg)
+    except ConfigError as err:
+        print(err, file=sys.stderr)
+        return 2
+    except OSError as err:
+        print(f"{args.file}: {err.strerror or err}", file=sys.stderr)
+        return 2
+
+    if args.command == "validate":
+        print(f"OK {args.file}")
+    return 0
diff --git a/engine/config.py b/engine/config.py
new file mode 100644
index 0000000..fd94f19
--- /dev/null
+++ b/engine/config.py
@@ -0,0 +1,202 @@
+"""Load a pipeline YAML file and validate it. Every error carries the line it came from.
+
+`yaml.compose` keeps the line of each node, so the loader builds a tree of `_Node`
+values that remember their line. Validation reads that tree. Kinds come from the registries.
+"""
+
+import os
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Mapping
+
+import yaml
+from yaml.nodes import MappingNode, Node, ScalarNode, SequenceNode
+
+import engine.builtins  # noqa: F401  registers the built-in kinds
+from engine.errors import ConfigError
+from engine.registry import SINKS, SOURCES, TRANSFORMS, Kind, Registry
+
+_ENV_REF = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?::-([^}]*))?\}")
+
+
+@dataclass
+class _Node:
+    value: Any
+    line: int
+    key_lines: dict[str, int] = field(default_factory=dict)
+
+
+def load(path: str, env: Mapping[str, str] | None = None) -> dict[str, Any]:
+    """Return the validated config as plain Python data. Raise ConfigError on the first problem."""
+    env = os.environ if env is None else env
+    text = Path(path).read_text(encoding="utf-8")
+    try:
+        root = yaml.compose(text, Loader=yaml.SafeLoader)
+    except yaml.YAMLError as exc:
+        mark = getattr(exc, "problem_mark", None)
+        line = mark.line + 1 if mark is not None else 1
+        raise ConfigError(path, line, "$", f"invalid YAML: {getattr(exc, 'problem', exc)}") from exc
+    if root is None:
+        raise ConfigError(path, 1, "$", "expected a mapping")
+
+    constructor = yaml.SafeLoader("")
+    tree = _wrap(root, "$", path, env, constructor)
+    _validate(tree, path)
+    return _plain(tree)
+
+
+def _join(path: str, key: str) -> str:
+    return key if path == "$" else f"{path}.{key}"
+
+
+def _wrap(node: Node, path: str, file: str, env: Mapping[str, str], loader: yaml.SafeLoader) -> _Node:
+    line = node.start_mark.line + 1
+    if isinstance(node, MappingNode):
+        value: dict[str, _Node] = {}
+        key_lines: dict[str, int] = {}
+        for key_node, value_node in node.value:
+            key = str(loader.construct_object(key_node, deep=True))
+            if key in value:
+                raise ConfigError(file, key_node.start_mark.line + 1, _join(path, key), "duplicate key")
+            key_lines[key] = key_node.start_mark.line + 1
+            value[key] = _wrap(value_node, _join(path, key), file, env, loader)
+        return _Node(value, line, key_lines)
+    if isinstance(node, SequenceNode):
+        items = [_wrap(item, f"{path}[{i}]", file, env, loader) for i, item in enumerate(node.value)]
+        return _Node(items, line)
+    if isinstance(node, ScalarNode):
+        value = loader.construct_object(node, deep=True)
+        if isinstance(value, str):
+            value = _expand(value, file, line, path, env)
+        return _Node(value, line)
+    raise ConfigError(file, line, path, "unsupported YAML construct")
+
+
+def _expand(text: str, file: str, line: int, path: str, env: Mapping[str, str]) -> str:
+    def replace(match: re.Match[str]) -> str:
+        name, default = match.group(1), match.group(2)
+        if name in env:
+            return env[name]
+        if default is not None:
+            return default
+        raise ConfigError(
+            file, line, path, f"environment variable {name} is not set and has no default"
+        )
+
+    return _ENV_REF.sub(replace, text)
+
+
+def _plain(node: _Node) -> Any:
+    if isinstance(node.value, dict):
+        return {key: _plain(child) for key, child in node.value.items()}
+    if isinstance(node.value, list):
+        return [_plain(child) for child in node.value]
+    return node.value
+
+
+def _fail(node: _Node, file: str, path: str, problem: str) -> ConfigError:
+    return ConfigError(file, node.line, path, problem)
+
+
+def _expect_map(node: _Node, file: str, path: str) -> None:
+    if not isinstance(node.value, dict):
+        raise _fail(node, file, path, "expected a mapping")
+
+
+def _expect_list(node: _Node, file: str, path: str) -> list[_Node]:
+    if not isinstance(node.value, list):
+        raise _fail(node, file, path, "expected a list")
+    return node.value
+
+
+def _expect_str(node: _Node, file: str, path: str) -> str:
+    if not isinstance(node.value, str):
+        raise _fail(node, file, path, "expected a string")
+    return node.value
+
+
+def _check_fields(node: _Node, file: str, path: str, required: set[str], optional: set[str]) -> None:
+    allowed = required | optional
+    for key in node.value:
+        if key not in allowed:
+            raise ConfigError(file, node.key_lines[key], _join(path, key), "unknown key")
+    for key in sorted(required):
+        if key not in node.value:
+            raise _fail(node, file, path, f"missing required key '{key}'")
+
+
+def _entries(root: _Node, file: str, section: str) -> list[tuple[str, _Node]]:
+    if section not in root.value:
+        return []
+    out = []
+    for i, item in enumerate(_expect_list(root.value[section], file, section)):
+        path = f"{section}[{i}]"
+        _expect_map(item, file, path)
+        out.append((path, item))
+    return out
+
+
+def _kind_entry(item: _Node, file: str, path: str, *, key: str, registry: Registry,
+                label: str, base: set[str]) -> None:
+    """Check one entry against its registry kind: the kind name, then the keys it allows."""
+    if key not in item.value:
+        raise _fail(item, file, path, f"missing required key '{key}'")
+    kind_node = item.value[key]
+    name = _expect_str(kind_node, file, _join(path, key))
+    if name not in registry:
+        options = ", ".join(registry.names())
+        raise _fail(kind_node, file, _join(path, key), f"unknown {label} '{name}' (expected one of {options})")
+    kind: Kind = registry[name]
+    _check_fields(item, file, path, base | set(kind.required), set(kind.optional))
+
+
+def _validate(root: _Node, file: str) -> None:
+    _expect_map(root, file, "$")
+    _check_fields(root, file, "$", set(), {"sources", "transforms", "sinks"})
+
+    names: dict[str, _Node] = {}
+    sources = _entries(root, file, "sources")
+    for path, item in sources:
+        _kind_entry(item, file, path, key="kind", registry=SOURCES, label="kind", base={"name", "kind"})
+        _claim(names, item.value["name"], file, _join(path, "name"))
+
+    transforms = _entries(root, file, "transforms")
+    for path, item in transforms:
+        _kind_entry(item, file, path, key="engine", registry=TRANSFORMS, label="engine",
+                    base={"name", "engine", "input"})
+        _claim(names, item.value["name"], file, _join(path, "name"))
+    for path, item in transforms:
+        _check_inputs(item.value["input"], names, file, _join(path, "input"), "unknown input")
+
+    sink_names: dict[str, _Node] = {}
+    transform_names = {item.value["name"].value for _, item in transforms}
+    for path, item in _entries(root, file, "sinks"):
+        _kind_entry(item, file, path, key="kind", registry=SINKS, label="kind",
+                    base={"name", "kind", "input"})
+        _claim(sink_names, item.value["name"], file, _join(path, "name"))
+        _check_input(item.value["input"], transform_names, file, _join(path, "input"), "unknown transform")
+
+
+def _claim(seen: dict[str, _Node], name_node: _Node, file: str, path: str) -> None:
+    name = _expect_str(name_node, file, path)
+    if name in seen:
+        raise _fail(name_node, file, path, f"duplicate name '{name}'")
+    seen[name] = name_node
+
+
+def _check_inputs(node: _Node, names: Mapping[str, Any], file: str, path: str, label: str) -> None:
+    """A transform may read one input or a list of inputs that are concatenated."""
+    if not isinstance(node.value, list):
+        _check_input(node, names, file, path, label)
+        return
+    if not node.value:
+        raise _fail(node, file, path, "expected at least one input")
+    for i, item in enumerate(node.value):
+        _check_input(item, names, file, f"{path}[{i}]", label)
+
+
+def _check_input(node: _Node, names: Mapping[str, Any], file: str, path: str, label: str) -> None:
+    value = _expect_str(node, file, path)
+    if value not in names:
+        raise _fail(node, file, path, f"{label} '{value}'")
