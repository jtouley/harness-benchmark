new file mode 100644
index 0000000..b2898d4
--- /dev/null
+++ b/engine/sources/sse.py
@@ -0,0 +1,129 @@
+"""Server-Sent Events client on the standard library (D1).
+
+`stream_events` yields parsed events, and None on an idle timeout so that the caller can
+flush a micro-batch. It reconnects with backoff and sends `Last-Event-ID` so the server
+resumes from the last event it sent. A 204 answer, or the deadline, ends the stream.
+"""
+
+import http.client
+import queue
+import threading
+import time
+import urllib.error
+import urllib.request
+from dataclasses import dataclass
+from typing import Any, Callable, Iterator, Mapping
+
+
+@dataclass(frozen=True)
+class SseEvent:
+    id: str | None
+    event: str
+    data: str
+
+
+class SseParser:
+    """Parses SSE lines one at a time. `feed` returns an event when a blank line ends one."""
+
+    def __init__(self) -> None:
+        self.last_id: str | None = None
+        self.retry_seconds: float | None = None
+        self._event = "message"
+        self._data: list[str] = []
+
+    def feed(self, raw: bytes) -> SseEvent | None:
+        line = raw.decode("utf-8").rstrip("\r\n")
+        if line == "":
+            if not self._data:
+                self._event = "message"
+                return None
+            event = SseEvent(self.last_id, self._event, "\n".join(self._data))
+            self._event = "message"
+            self._data = []
+            return event
+        if line.startswith(":"):
+            return None
+        field, _, value = line.partition(":")
+        if value.startswith(" "):
+            value = value[1:]
+        if field == "id" and "\x00" not in value:
+            self.last_id = value
+        elif field == "event":
+            self._event = value
+        elif field == "data":
+            self._data.append(value)
+        elif field == "retry" and value.isdigit():
+            self.retry_seconds = int(value) / 1000
+        return None
+
+
+def stream_events(
+    url: str,
+    *,
+    deadline: float,
+    last_event_id: str | None = None,
+    heartbeat_seconds: float = 1.0,
+    read_timeout: float = 30.0,
+    opener: Callable[..., Any] = urllib.request.urlopen,
+    clock: Callable[[], float] = time.monotonic,
+    sleep: Callable[[float], None] = time.sleep,
+) -> Iterator[SseEvent | None]:
+    last = last_event_id
+    backoff = 0.2
+    while clock() < deadline:
+        headers = {"Accept": "text/event-stream", "Cache-Control": "no-cache"}
+        if last is not None:
+            headers["Last-Event-ID"] = last
+        try:
+            response = opener(urllib.request.Request(url, headers=headers), timeout=read_timeout)
+        except (urllib.error.URLError, OSError):
+            sleep(min(backoff, max(0.0, deadline - clock())))
+            backoff = min(backoff * 2, 10.0)
+            continue
+        if response.status == 204:
+            response.close()
+            return
+        backoff = 0.2
+        parser = SseParser()
+        lines: queue.Queue[bytes] = queue.Queue()
+        # The reader thread owns the response and closes it. This generator never closes it
+        # while the thread may still be blocked in a read.
+        threading.Thread(target=_read_lines, args=(response, lines), daemon=True).start()
+        while clock() < deadline:
+            try:
+                raw = lines.get(timeout=heartbeat_seconds)
+            except queue.Empty:
+                yield None
+                continue
+            if not raw:
+                break
+            event = parser.feed(raw)
+            if event is not None:
+                last = event.id if event.id is not None else last
+                yield event
+        sleep(min(backoff, max(0.0, deadline - clock())))
+
+
+def _read_lines(response: Any, lines: "queue.Queue[bytes]") -> None:
+    """Read complete lines in a thread. A partial line (EOF or a timeout mid-line) ends the connection."""
+    try:
+        while True:
+            try:
+                raw = response.readline()
+            except (OSError, ValueError, http.client.HTTPException):
+                raw = b""
+            if not raw.endswith(b"\n"):
+                lines.put(b"")
+                return
+            lines.put(raw)
+    finally:
+        response.close()
+
+
+def read_sse(options: Mapping[str, Any]) -> Iterator[SseEvent | None]:
+    """Registry entry for the `sse` source kind. The runner supplies `deadline` and `last_event_id`."""
+    return stream_events(
+        options["url"],
+        deadline=options["deadline"],
+        last_event_id=options.get("last_event_id"),
+    )
