+    s.obligation_amount
+from {{ ref('stg_usaspending_transactions') }} s
diff --git a/transform/models/batch/mart_obligations_monthly.sql b/transform/models/batch/mart_obligations_monthly.sql
new file mode 100644
index 0000000..661c8a9
--- /dev/null
+++ b/transform/models/batch/mart_obligations_monthly.sql
@@ -0,0 +1,25 @@
+-- Grain: state, county, agency and month (one row per combination with transactions).
+-- net_obligations is the exact sum of the transactions. obligations_per_person divides that
+-- row's own net obligations by the county population, so it is never summed (C1).
+-- It is null when the county has no population (D5).
+{{ config(
+    materialized='external',
+    location='out/marts/mart_obligations_monthly/mart_obligations_monthly.parquet',
+    contract={'enforced': true}
+) }}
+select
+    p.state_fips,
+    p.county_fips,
+    f.agency_key as agency_code,
+    d.month_start,
+    cast(sum(f.obligation_amount) as decimal(18, 2)) as net_obligations,
+    p.population,
+    cast(
+        case when p.population > 0
+            then round(cast(sum(f.obligation_amount) as double) / p.population, 4)
+        end
+    as decimal(18, 4)) as obligations_per_person
+from {{ ref('fct_award_transactions') }} f
+join {{ ref('dim_place') }} p on p.place_key = f.place_key
+join {{ ref('dim_date') }} d on d.date_key = f.date_key
+group by p.state_fips, p.county_fips, f.agency_key, d.month_start, p.population
