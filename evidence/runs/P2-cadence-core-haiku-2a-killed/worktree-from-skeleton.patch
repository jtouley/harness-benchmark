@@ -0,0 +1,60 @@
+import random
+from decimal import Decimal
+
+import pyarrow as pa
+import pyarrow.compute as pc
+import pytest
+
+from engine.money import MONEY_TYPE, MoneyError, parse_money
+
+
+def test_money_type_is_decimal_18_2():
+    assert MONEY_TYPE == pa.decimal128(18, 2)
+
+
+def test_edge_values_sum_to_the_exact_decimal_sum():
+    values = ["-0.10", "1234567890123.45"]
+
+    arr = parse_money(values, sources=["a.csv", "a.csv"], rows=[2, 3])
+
+    assert arr.type == MONEY_TYPE
+    assert pc.sum(arr).as_py() == sum(Decimal(v) for v in values)
+
+
+def test_ten_thousand_random_values_sum_to_the_exact_decimal_sum():
+    rng = random.Random(20241)
+    values = []
+    for _ in range(10_000):
+        cents = rng.randint(-(10**15), 10**15)
+        sign = "-" if cents < 0 else ""
+        values.append(f"{sign}{abs(cents) // 100}.{abs(cents) % 100:02d}")
+
+    arr = parse_money(values, sources=["r.csv"] * len(values), rows=list(range(2, len(values) + 2)))
+
+    assert pc.sum(arr).as_py() == sum(Decimal(v) for v in values)
+
+
+def test_third_decimal_place_is_rejected_with_file_and_row():
+    with pytest.raises(MoneyError) as info:
+        parse_money(["5.00", "1.234"], sources=["a.csv", "b.csv"], rows=[2, 9])
+
+    assert str(info.value) == "b.csv: row 9: more than 2 decimal places: '1.234'"
+
+
+def test_non_numeric_value_is_rejected_with_file_and_row():
+    with pytest.raises(MoneyError) as info:
+        parse_money(["12a"], sources=["a.csv"], rows=[2])
+
+    assert str(info.value) == "a.csv: row 2: not a decimal number: '12a'"
+
+
+def test_trailing_zero_is_not_a_third_decimal_place():
+    arr = parse_money(["1.230"], sources=["a.csv"], rows=[2])
+
+    assert arr.to_pylist() == [Decimal("1.23")]
+
+
+def test_null_stays_null():
+    arr = parse_money(["1.00", None], sources=["a.csv", "a.csv"], rows=[2, 3])
+
+    assert arr.to_pylist() == [Decimal("1.00"), None]
