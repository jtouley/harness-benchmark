+++ b/engine/money.py
@@ -0,0 +1,47 @@
+"""Exact money parsing: source text to decimal128(18,2), with the file and row in every error.
+
+pyarrow 26 rejects a third decimal place in a decimal cast, so this module only adds the
+plain-number check in front of the cast and names the first bad row when the cast fails.
+"""
+
+import re
+from decimal import Decimal
+from typing import Sequence
+
+import pyarrow as pa
+
+MONEY_TYPE = pa.decimal128(18, 2)
+_CENT = Decimal("0.01")
+_PLAIN_NUMBER = re.compile(r"-?\d+(\.\d+)?")
+_LIMIT = Decimal(10) ** 16  # decimal(18,2) holds 16 digits before the point
+
+
+class MoneyError(ValueError):
+    def __init__(self, source: str, row: int, problem: str) -> None:
+        super().__init__(f"{source}: row {row}: {problem}")
+
+
+def parse_money(values: Sequence[str | None], *, sources: Sequence[str], rows: Sequence[int]) -> pa.Array:
+    """Return `values` as decimal128(18,2). `sources[i]` and `rows[i]` locate value i in its file."""
+    for value, source, row in zip(values, sources, rows):
+        if value is not None and not _PLAIN_NUMBER.fullmatch(value):
+            raise MoneyError(source, row, f"not a decimal number: {value!r}")
+    try:
+        return pa.array(values, type=pa.string()).cast(MONEY_TYPE)
+    except pa.ArrowInvalid as exc:
+        for value, source, row in zip(values, sources, rows):
+            problem = _problem(value)
+            if problem is not None:
+                raise MoneyError(source, row, f"{problem}: {value!r}") from exc
+        raise MoneyError(sources[0], rows[0], f"does not convert to decimal(18,2): {exc}") from exc
+
+
+def _problem(value: str | None) -> str | None:
+    if value is None:
+        return None
+    number = Decimal(value)
+    if number != number.quantize(_CENT):
+        return "more than 2 decimal places"
+    if abs(number) >= _LIMIT:
+        return "does not fit decimal(18,2)"
+    return None
diff --git a/engine/registry.py b/engine/registry.py
new file mode 100644
index 0000000..fecf66d
--- /dev/null
+++ b/engine/registry.py
@@ -0,0 +1,51 @@
+"""Registries for source kinds, transform engines and sink kinds (D10).
+
+A new kind is one `Kind` entry in one registry. The config validator and the runner read
+the registries, so neither names a kind. `run` takes these arguments:
+
+- sources: `run(options) -> pa.Table`
+- transforms: `run(options, table) -> pa.Table`
+- sinks: `run(table, options, *, lake_root) -> None`. The stream sink also takes keyword
+  arguments for the consumer state.
+- the `sse` source returns an iterator of events (None on an idle timeout), not a table.
+"""
+
+from collections.abc import Callable, Iterable
+from dataclasses import dataclass
+from typing import Any
+
+
+@dataclass(frozen=True)
+class Kind:
+    name: str
+    required: frozenset[str]
+    optional: frozenset[str]
+    run: Callable[..., Any]
+
+
+class Registry:
+    def __init__(self, label: str) -> None:
+        self.label = label
+        self._kinds: dict[str, Kind] = {}
+
+    def register(self, kind: Kind) -> None:
+        if kind.name in self._kinds:
+            raise ValueError(f"{self.label} '{kind.name}' is already registered")
+        self._kinds[kind.name] = kind
+
+    def unregister(self, name: str) -> None:
+        del self._kinds[name]
+
+    def __contains__(self, name: object) -> bool:
+        return name in self._kinds
+
+    def __getitem__(self, name: str) -> Kind:
+        return self._kinds[name]
+
+    def names(self) -> Iterable[str]:
+        return sorted(self._kinds)
+
+
+SOURCES = Registry("source kind")
+TRANSFORMS = Registry("transform engine")
+SINKS = Registry("sink kind")
