new file mode 100644
index 0000000..ed68722
--- /dev/null
+++ b/tests/test_build_idempotent.py
@@ -0,0 +1,37 @@
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+import pyarrow.parquet as pq
+
+REPO = Path(__file__).resolve().parents[1]
+PARQUET_FILES = {
+    "lake/usaspending_transactions": "lake/usaspending_transactions/part-0.parquet",
+    "lake/census_county_population": "lake/census_county_population/part-0.parquet",
+    "lake/wiki_sites": "lake/wiki_sites/part-0.parquet",
+    "mart/mart_obligations_monthly": "out/marts/mart_obligations_monthly/mart_obligations_monthly.parquet",
+}
+
+
+def _make_build() -> None:
+    subprocess.run(["make", "build"], cwd=REPO, check=True, timeout=1800)
+
+
+def _content_hash(path: Path) -> str:
+    rows = pq.read_table(path).to_pylist()
+    lines = sorted(json.dumps(row, sort_keys=True, default=str) for row in rows)
+    return hashlib.sha256("\n".join(lines).encode("utf-8")).hexdigest()
+
+
+def _hashes() -> dict[str, str]:
+    return {name: _content_hash(REPO / rel) for name, rel in PARQUET_FILES.items()}
+
+
+def test_two_make_build_runs_give_the_same_content_for_every_table_and_mart():
+    _make_build()
+    first = _hashes()
+
+    _make_build()
+
+    assert _hashes() == first
diff --git a/tests/test_config.py b/tests/test_config.py
new file mode 100644
index 0000000..08cf62d
--- /dev/null
+++ b/tests/test_config.py
@@ -0,0 +1,109 @@
+from pathlib import Path
+
+import pytest
+
+from engine.config import load
+from engine.errors import ConfigError
+
+FIXTURES = Path(__file__).parent / "fixtures" / "config"
+
+
+def _fixture(name: str) -> str:
+    return str(FIXTURES / name)
+
+
+def _load_error(name: str, env: dict[str, str] | None = None) -> ConfigError:
+    with pytest.raises(ConfigError) as info:
+        load(_fixture(name), env={} if env is None else env)
+    return info.value
+
+
+def test_valid_fixture_loads_and_expands_default():
+    cfg = load(_fixture("valid.yml"), env={})
+
+    assert cfg["sources"][0]["path"] == "data/raw/usa.csv"
+    assert cfg["transforms"][0]["engine"] == "polars"
+    assert cfg["sinks"][0]["table"] == "usaspending_transactions"
+
+
+def test_env_variable_overrides_default():
+    cfg = load(_fixture("valid.yml"), env={"PIPE_TEST_DIR": "lake"})
+
+    assert cfg["sources"][0]["path"] == "lake/usa.csv"
+
+
+def test_bad_yaml_syntax_reports_the_line():
+    err = _load_error("bad_syntax.yml")
+
+    assert err.line == 3
+    assert err.path == "$"
+
+
+def test_unknown_key_reports_the_line_of_the_key():
+    err = _load_error("unknown_key.yml")
+
+    assert err.line == 5
+    assert err.path == "sources[0].formt"
+    assert err.problem == "unknown key"
+
+
+def test_missing_required_key_reports_the_line_of_its_parent_mapping():
+    err = _load_error("missing_required.yml")
+
+    assert err.line == 2
+    assert err.path == "sources[0]"
+    assert err.problem == "missing required key 'path'"
+
+
+def test_wrong_type_reports_the_line_of_the_value():
+    err = _load_error("wrong_type.yml")
+
+    assert err.line == 1
+    assert err.path == "sources"
+    assert err.problem == "expected a list"
+
+
+def test_unknown_engine_reports_the_line_of_the_engine_key():
+    err = _load_error("unknown_engine.yml")
+
+    assert err.line == 3
+    assert err.path == "transforms[0].engine"
+    assert err.problem.startswith("unknown engine 'pandas'")
+
+
+def test_dangling_input_reports_the_line_of_the_input_value():
+    err = _load_error("dangling_input.yml")
+
+    assert err.line == 8
+    assert err.path == "transforms[0].input"
+    assert err.problem == "unknown input 'nope'"
+
+
+def test_unset_variable_without_default_reports_the_line():
+    err = _load_error("unset_env.yml")
+
+    assert err.line == 4
+    assert err.path == "sources[0].path"
+    assert err.problem == (
+        "environment variable PIPE_TEST_UNSET_PATH is not set and has no default"
+    )
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "bad_syntax.yml",
+        "unknown_key.yml",
+        "missing_required.yml",
+        "wrong_type.yml",
+        "unknown_engine.yml",
+        "dangling_input.yml",
+        "unset_env.yml",
+    ],
+)
+def test_each_bad_fixture_gives_one_error_line(name):
+    err = _load_error(name)
+
+    text = str(err)
+    assert text.startswith(f"{_fixture(name)}:{err.line}: ")
+    assert "\n" not in text
