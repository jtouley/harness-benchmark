@@ -0,0 +1,42 @@
+"""The `polars` transform: select, drop, rename and cast over Arrow in and Arrow out."""
+
+from typing import Any, Mapping
+
+import polars as pl
+import pyarrow as pa
+
+from engine.money import parse_money
+
+_INPUT = "<input>"
+
+
+def apply_polars(options: Mapping[str, Any], table: pa.Table) -> pa.Table:
+    """Select, drop and rename first. Casts then name the output columns."""
+    frame = pl.from_arrow(table)
+    if "select" in options:
+        frame = frame.select(options["select"])
+    if "drop" in options:
+        frame = frame.drop(options["drop"])
+    if "rename" in options:
+        frame = frame.rename(options["rename"])
+    out = frame.to_arrow()
+    for column, target in options.get("cast", {}).items():
+        if target != "money":
+            raise ValueError(f"cast to {target!r} is not supported")
+        out = _money_column(out, column)
+    return out
+
+
+def _money_column(table: pa.Table, column: str) -> pa.Table:
+    values = table[column].to_pylist()
+    if "_source_file" in table.column_names:
+        sources = table["_source_file"].to_pylist()
+    else:
+        sources = [_INPUT] * len(values)
+    seen: dict[str, int] = {}
+    rows = []
+    for source in sources:
+        seen[source] = seen.get(source, 0) + 1
+        rows.append(seen[source] + 1)  # line 1 is the header
+    money = parse_money(values, sources=sources, rows=rows)
+    return table.set_column(table.schema.get_field_index(column), column, money)
