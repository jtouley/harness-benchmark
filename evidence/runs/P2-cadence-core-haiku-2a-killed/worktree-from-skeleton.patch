+import time
+
+from engine.sources.sse import SseParser, stream_events
+
+from tests.conftest import recentchange
+
+
+def test_parser_joins_data_lines_and_keeps_the_last_id():
+    parser = SseParser()
+    lines = [b"id: 7\n", b"event: message\n", b"data: a\n", b"data: b\n", b"\n",
+             b"data: c\n", b"\n"]
+
+    events = [event for event in map(parser.feed, lines) if event is not None]
+
+    assert [(event.id, event.data) for event in events] == [("7", "a\nb"), ("7", "c")]
+
+
+def test_comment_and_retry_lines_dispatch_nothing():
+    parser = SseParser()
+
+    events = [parser.feed(line) for line in [b":ok\n", b"retry: 1000\n", b"\n"]]
+
+    assert events == [None, None, None]
+
+
+def test_reconnect_after_a_drop_resumes_with_last_event_id(serve_sse):
+    events = [(f"id-{i}", recentchange(f"m{i}", 1_000_000 + i)) for i in range(120)]
+    script = serve_sse(events, drop_first_after=50)
+
+    received = [e for e in stream_events(script.url, deadline=time.monotonic() + 20)
+                if e is not None]
+
+    assert [e.id for e in received] == [event_id for event_id, _ in events]
+    assert script.last_event_ids == [None, "id-49", "id-119"]
