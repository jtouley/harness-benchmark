diff --git a/transform/models/batch/stg_census_county_population.sql b/transform/models/batch/stg_census_county_population.sql
new file mode 100644
index 0000000..651c5d7
--- /dev/null
+++ b/transform/models/batch/stg_census_county_population.sql
@@ -0,0 +1,25 @@
+-- Grain: one county in the Census 2024 estimates (D5, MF-10).
+-- Only the 2024 file is used. The state summary row (COUNTY 000) and the nine Connecticut
+-- planning regions are dropped, so they never carry a population (proposal cd-1-population).
+-- A missing 2024 value falls back to the newest earlier year in the same file.
+select
+    STATE as state_fips,
+    STATE || COUNTY as county_fips,
+    CTYNAME as county_name,
+    population_vintage,
+    case
+        when nullif(POPESTIMATE2024, '') is not null then 2024
+        when nullif(POPESTIMATE2023, '') is not null then 2023
+        when nullif(POPESTIMATE2022, '') is not null then 2022
+        when nullif(POPESTIMATE2021, '') is not null then 2021
+        when nullif(POPESTIMATE2020, '') is not null then 2020
+    end as population_source_year,
+    cast(coalesce(
+        nullif(POPESTIMATE2024, ''), nullif(POPESTIMATE2023, ''), nullif(POPESTIMATE2022, ''),
+        nullif(POPESTIMATE2021, ''), nullif(POPESTIMATE2020, '')
+    ) as integer) as population
+from {{ source('lake', 'census_county_population') }}
+where population_vintage = 2024
+  and SUMLEV = '050'
+  and COUNTY <> '000'
+  and not (STATE = '09' and COUNTY between '110' and '190')
