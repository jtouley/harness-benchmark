+import json
+
+import pyarrow as pa
+
+from engine.transforms.sitematrix import flatten_sites
+
+DOCUMENT = {
+    "sitematrix": {
+        "count": 3,
+        "0": {
+            "code": "aa",
+            "name": "Afar",
+            "site": [
+                {"url": "https://aa.wikipedia.org", "dbname": "aawiki", "code": "wiki",
+                 "sitename": "Wikipedia", "closed": True},
+            ],
+        },
+        "specials": [
+            {"url": "https://meta.wikimedia.org", "dbname": "metawiki", "code": "meta",
+             "lang": "en", "sitename": "Meta-Wiki"},
+            {"url": "https://advisors.wikimedia.org", "dbname": "advisorswiki", "code": "advisors",
+             "lang": "en", "sitename": "Advisors", "private": True},
+        ],
+    }
+}
+
+
+def _table():
+    return pa.table({
+        "document": [json.dumps(DOCUMENT)],
+        "_source_file": ["sitematrix.json"],
+        "_source_sha256": ["abc"],
+    })
+
+
+def test_one_row_per_site_from_numbered_groups_and_specials():
+    out = flatten_sites(_table()).to_pylist()
+
+    assert [row["dbname"] for row in out] == ["aawiki", "metawiki", "advisorswiki"]
+
+
+def test_numbered_group_takes_its_language_from_the_group_code():
+    row = flatten_sites(_table()).to_pylist()[0]
+
+    assert row["language_code"] == "aa"
+    assert row["host"] == "aa.wikipedia.org"
+    assert row["is_closed"] is True
+    assert row["is_private"] is False
+
+
+def test_specials_take_language_from_lang_and_keep_load_metadata():
+    rows = flatten_sites(_table()).to_pylist()
+
+    assert rows[1]["language_code"] == "en"
+    assert rows[2]["is_private"] is True
+    assert rows[2]["_source_file"] == "sitematrix.json"
+    assert rows[2]["_source_sha256"] == "abc"
