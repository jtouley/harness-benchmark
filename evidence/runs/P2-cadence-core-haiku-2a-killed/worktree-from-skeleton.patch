@@ -0,0 +1,77 @@
+# Batch ingestion: USAspending FY2024 awards, Census county populations and the wiki site matrix.
+# Every path is relative to the repository root, where `make build` runs.
+
+sources:
+  - name: usaspending_raw
+    kind: file
+    path: data/raw/usaspending/*.zip
+    member: "*.csv"
+
+  - name: census_2024
+    kind: file
+    path: data/raw/census/co-est2024-alldata.csv
+    encoding: latin-1
+    constants:
+      population_vintage: 2024
+
+  - name: census_2021
+    kind: file
+    path: data/raw/census/co-est2021-alldata.csv
+    encoding: latin-1
+    constants:
+      population_vintage: 2021
+
+  - name: sitematrix_raw
+    kind: file
+    path: data/raw/sitematrix.json
+    format: json_document
+
+transforms:
+  - name: usaspending_normalized
+    engine: datafusion
+    input: usaspending_raw
+    sql: >-
+      SELECT
+        coalesce(contract_transaction_unique_key, assistance_transaction_unique_key) AS transaction_key,
+        coalesce(contract_award_unique_key, assistance_award_unique_key) AS award_key,
+        CASE WHEN contract_transaction_unique_key IS NOT NULL THEN 'contract' ELSE 'assistance' END AS award_kind,
+        action_date,
+        awarding_agency_code,
+        awarding_agency_name,
+        NULLIF(prime_award_transaction_place_of_performance_state_fips_code, '') AS state_fips,
