+"""The `datafusion` transform: one SQL statement over its input, registered as `input`."""
+
+from typing import Any, Mapping
+
+import datafusion
+import pyarrow as pa
+
+
+def apply_datafusion(options: Mapping[str, Any], table: pa.Table) -> pa.Table:
+    ctx = datafusion.SessionContext()
+    ctx.register_record_batches("input", [table.to_batches()])
+    return ctx.sql(options["sql"]).to_arrow_table()
