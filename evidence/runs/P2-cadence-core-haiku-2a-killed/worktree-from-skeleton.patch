@@ -0,0 +1,222 @@
+import hashlib
+import io
+import zipfile
+from pathlib import Path
+
+import pyarrow as pa
+import pyarrow.parquet as pq
+import pytest
+
+from engine import runtime
+from engine.config import load
+from engine.money import MoneyError
+from engine.registry import SOURCES, Kind
+from engine.sources.file import read_file
+from engine.transforms.datafusion_step import apply_datafusion
+from engine.transforms.polars_step import apply_polars
+from engine.transforms.python_step import apply_python
+
+
+def _csv_bytes(rows):
+    lines = ["a,b"] + [f"{a},{b}" for a, b in rows]
+    return ("\n".join(lines) + "\n").encode("utf-8")
+
+
+def tag_rows(table):
+    return table.append_column("tagged", pa.array([True] * table.num_rows))
+
+
+def test_zip_members_are_read_in_memory_and_never_extracted(tmp_path, monkeypatch):
+    raw = tmp_path / "raw"
+    raw.mkdir()
+    zip_path = raw / "pack.zip"
+    with zipfile.ZipFile(zip_path, "w") as zf:
+        zf.writestr("one.csv", _csv_bytes([(1, "x"), (2, "y")]))
+        zf.writestr("two.csv", _csv_bytes([(3, "z")]))
+    work = tmp_path / "work"
+    work.mkdir()
+    monkeypatch.chdir(work)
+
+    table = read_file({"path": str(zip_path), "member": "*.csv"})
+
+    assert table.num_rows == 3
+    assert sorted(set(table["_source_file"].to_pylist())) == ["pack.zip/one.csv", "pack.zip/two.csv"]
+    assert set(table["_source_sha256"].to_pylist()) == {hashlib.sha256(zip_path.read_bytes()).hexdigest()}
+    assert list(work.iterdir()) == []
+
+
+def test_load_metadata_is_file_name_and_hash_with_no_timestamp(tmp_path):
+    csv_path = tmp_path / "rows.csv"
+    csv_path.write_bytes(_csv_bytes([(1, "x")]))
+
+    table = read_file({"path": str(csv_path)})
+
+    assert table.column_names == ["a", "b", "_source_file", "_source_sha256"]
+    assert table["_source_file"].to_pylist() == ["rows.csv"]
+    assert table["_source_sha256"].to_pylist() == [hashlib.sha256(csv_path.read_bytes()).hexdigest()]
+
+
+def test_latin1_file_is_decoded_before_reading(tmp_path):
+    path = tmp_path / "census.csv"
+    path.write_bytes("name\nPe\xf1a\n".encode("latin-1"))
+
+    table = read_file({"path": str(path), "encoding": "latin-1"})
+
+    assert table["name"].to_pylist() == ["Peña"]
+
+
+def test_polars_step_selects_renames_and_casts_money():
+    table = pa.table({
+        "a": ["1", "2"],
+        "b": ["1.50", "2.25"],
+        "_source_file": ["x.csv", "x.csv"],
+    })
+
+    out = apply_polars({"select": ["a", "b", "_source_file"], "rename": {"b": "amount"},
+                        "cast": {"amount": "money"}}, table)
+
+    assert out.column_names == ["a", "amount", "_source_file"]
+    assert str(out.schema.field("amount").type) == "decimal128(18, 2)"
+
+
+def test_money_cast_error_names_the_file_and_the_file_row():
+    table = pa.table({
+        "amount": ["1.00", "2.00", "3.001"],
+        "_source_file": ["x.csv", "x.csv", "x.csv"],
+    })
+
+    with pytest.raises(MoneyError) as info:
+        apply_polars({"cast": {"amount": "money"}}, table)
+
+    assert str(info.value) == "x.csv: row 4: more than 2 decimal places: '3.001'"
+
+
+def test_datafusion_step_runs_sql_over_its_input():
+    table = pa.table({"a": pa.array([1, 2], pa.int64()), "b": pa.array([10, 20], pa.int64())})
+
+    out = apply_datafusion({"sql": "select a, b * 2 as c from input order by a"}, table)
+
+    assert out.to_pylist() == [{"a": 1, "c": 20}, {"a": 2, "c": 40}]
+
+
+def test_python_step_calls_the_named_function():
+    table = pa.table({"a": [1, 2]})
+
+    out = apply_python({"function": "test_runtime:tag_rows"}, table)
+
+    assert out["tagged"].to_pylist() == [True, True]
+
+
+def test_new_source_kind_needs_one_registry_entry(tmp_path):
+    kind = Kind(
+        name="inline",
+        required=frozenset({"rows"}),
+        optional=frozenset(),
+        run=lambda options: pa.table({"a": pa.array(options["rows"], pa.int64())}),
+    )
+    SOURCES.register(kind)
+    try:
+        cfg_path = tmp_path / "inline.yml"
+        cfg_path.write_text(
+            "sources:\n"
+            "  - name: nums\n"
+            "    kind: inline\n"
+            "    rows: [1, 2, 3]\n"
+            "transforms:\n"
+            "  - name: pass\n"
+            "    engine: polars\n"
+            "    input: nums\n"
+            "sinks:\n"
+            "  - name: out\n"
+            "    kind: lake\n"
+            "    input: pass\n"
+            "    table: nums\n",
+            encoding="utf-8",
+        )
+
+        cfg = load(str(cfg_path), env={})
+        runtime.run(cfg, lake_root=tmp_path / "lake")
+    finally:
+        SOURCES.unregister("inline")
+
+    assert pq.read_table(tmp_path / "lake" / "nums" / "part-0.parquet")["a"].to_pylist() == [1, 2, 3]
+
+
+def test_end_to_end_csv_to_lake_table(tmp_path):
+    raw = tmp_path / "raw"
+    raw.mkdir()
+    (raw / "rows.csv").write_bytes(_csv_bytes([(1, "1.50"), (2, "2.25")]))
+    cfg_path = tmp_path / "pipe.yml"
+    cfg_path.write_text(
+        "sources:\n"
+        "  - name: rows\n"
+        "    kind: file\n"
+        f"    path: {raw}/*.csv\n"
+        "transforms:\n"
+        "  - name: clean\n"
+        "    engine: polars\n"
+        "    input: rows\n"
+        "    cast:\n"
+        "      b: money\n"
+        "sinks:\n"
+        "  - name: out\n"
+        "    kind: lake\n"
+        "    input: clean\n"
+        "    table: rows\n",
+        encoding="utf-8",
+    )
+
+    runtime.run(load(str(cfg_path), env={}), lake_root=tmp_path / "lake")
+
+    out = pq.read_table(tmp_path / "lake" / "rows" / "part-0.parquet")
+    assert out["a"].to_pylist() == ["1", "2"]
+    assert str(out.schema.field("b").type) == "decimal128(18, 2)"
+    assert "_source_sha256" in out.column_names
+
+
+
+def test_constants_add_a_column_to_every_row(tmp_path):
+    path = tmp_path / "pop.csv"
+    path.write_bytes(_csv_bytes([(1, "x"), (2, "y")]))
+
+    table = read_file({"path": str(path), "constants": {"population_vintage": 2024}})
+
+    assert table["population_vintage"].to_pylist() == [2024, 2024]
+
+
+def test_json_document_source_gives_one_row_with_the_whole_text(tmp_path):
+    path = tmp_path / "matrix.json"
+    path.write_text('{"sitematrix": {"count": 0}}', encoding="utf-8")
+
+    table = read_file({"path": str(path), "format": "json_document"})
+
+    assert table["document"].to_pylist() == ['{"sitematrix": {"count": 0}}']
+
+
+def test_transform_with_a_list_input_reads_the_concatenated_tables(tmp_path):
+    cfg_path = tmp_path / "two.yml"
+    cfg_path.write_text(
+        "sources:\n"
+        "  - name: first\n"
+        "    kind: file\n"
+        f"    path: {tmp_path}/first.csv\n"
+        "  - name: second\n"
+        "    kind: file\n"
+        f"    path: {tmp_path}/second.csv\n"
+        "transforms:\n"
+        "  - name: both\n"
+        "    engine: polars\n"
+        "    input: [first, second]\n"
+        "sinks:\n"
+        "  - name: out\n"
+        "    kind: lake\n"
+        "    input: both\n"
+        "    table: both\n",
+        encoding="utf-8",
+    )
+    (tmp_path / "first.csv").write_bytes(_csv_bytes([(1, "x")]))
+    (tmp_path / "second.csv").write_bytes(_csv_bytes([(2, "y"), (3, "z")]))
+
+    runtime.run(load(str(cfg_path), env={}), lake_root=tmp_path / "lake")
+
+    assert pq.read_table(tmp_path / "lake" / "both" / "part-0.parquet").num_rows == 3
