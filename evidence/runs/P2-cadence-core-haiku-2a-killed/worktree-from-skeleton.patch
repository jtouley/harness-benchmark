+        data_type: varchar
+        tests: [not_null]
+      - name: county_fips
+        data_type: varchar
+        tests: [not_null]
+      - name: agency_code
+        data_type: varchar
+        tests: [not_null]
+      - name: month_start
+        data_type: date
+        tests: [not_null]
+      - name: net_obligations
+        data_type: decimal(18,2)
+        tests: [not_null]
+      - name: population
