diff --git a/transform/tests/mart_obligations_monthly_reconciles.sql b/transform/tests/mart_obligations_monthly_reconciles.sql
new file mode 100644
index 0000000..1a1bb95
--- /dev/null
+++ b/transform/tests/mart_obligations_monthly_reconciles.sql
@@ -0,0 +1,10 @@
+-- Returns a row when the mart total differs from the fact total (no rows lost or added).
+with mart as (
+    select sum(net_obligations) as total from {{ ref('mart_obligations_monthly') }}
+),
+fact as (
+    select sum(obligation_amount) as total from {{ ref('fct_award_transactions') }}
+)
+select mart.total as mart_total, fact.total as fact_total
+from mart, fact
+where mart.total is distinct from fact.total
