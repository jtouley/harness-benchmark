+-- Grain: one award transaction (transaction_key). Money is DECIMAL(18,2).
+select
+    s.transaction_key,
+    s.award_key,
+    s.award_kind,
+    s.agency_code as agency_key,
+    coalesce(s.state_fips, 'UNKNOWN') || '-' || coalesce(s.county_fips, 'UNKNOWN') as place_key,
