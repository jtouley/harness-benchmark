index 0000000..66acc1e
--- /dev/null
+++ b/engine/runtime.py
@@ -0,0 +1,47 @@
+"""Run a validated pipeline: sources, then transforms in dependency order, then sinks."""
+
+from pathlib import Path
+from typing import Any, Mapping
+
+import pyarrow as pa
+
+from engine import builtins  # noqa: F401  registers the built-in kinds
+from engine.registry import SINKS, SOURCES, TRANSFORMS
+
+_RESERVED = {"name", "kind", "engine", "input"}
+
+
+def run(config: Mapping[str, Any], *, lake_root: str | Path = "lake") -> None:
+    tables: dict[str, pa.Table] = {}
+    for source in config.get("sources", []):
+        tables[source["name"]] = SOURCES[source["kind"]].run(_options(source))
+
+    pending = list(config.get("transforms", []))
+    while pending:
+        ready = [t for t in pending if all(name in tables for name in _inputs(t))]
+        if not ready:
+            raise RuntimeError("transform inputs form a cycle or name no node")
+        for transform in ready:
+            names = _inputs(transform)
+            table = _concat([tables[name] for name in names])
+            engine = TRANSFORMS[transform["engine"]]
+            tables[transform["name"]] = engine.run(_options(transform), table)
+            pending.remove(transform)
+
+    for sink in config.get("sinks", []):
+        SINKS[sink["kind"]].run(tables[sink["input"]], _options(sink), lake_root=lake_root)
+
+
+def _options(node: Mapping[str, Any]) -> dict[str, Any]:
+    return {key: value for key, value in node.items() if key not in _RESERVED}
+
+
+def _inputs(transform: Mapping[str, Any]) -> list[str]:
+    value = transform["input"]
+    return list(value) if isinstance(value, list) else [value]
+
+
+def _concat(tables: list[pa.Table]) -> pa.Table:
+    if len(tables) == 1:
+        return tables[0]
+    return pa.concat_tables(tables, promote_options="permissive")
