new file mode 100644
index 0000000..ff06356
--- /dev/null
+++ b/engine/transforms/sitematrix.py
@@ -0,0 +1,57 @@
+"""Flatten the wiki site matrix into one row per site.
+
+The matrix holds numbered language groups (each with a `site` list and a group `code`) and
+a `specials` list (each site carries its own `lang`). Both kinds become rows here.
+"""
+
+import json
+
+import pyarrow as pa
+from urllib.parse import urlparse
+
+
+def flatten_sites(table: pa.Table) -> pa.Table:
+    rows: dict[str, list] = {name: [] for name in _COLUMNS}
+    documents = table["document"].to_pylist()
+    sources = table["_source_file"].to_pylist()
+    digests = table["_source_sha256"].to_pylist()
+    for document, source, digest in zip(documents, sources, digests):
+        for language, site in _sites(json.loads(document)["sitematrix"]):
+            rows["dbname"].append(site["dbname"])
+            rows["host"].append(urlparse(site["url"]).netloc)
+            rows["url"].append(site["url"])
+            rows["site_code"].append(site["code"])
+            rows["language_code"].append(language)
+            rows["sitename"].append(site.get("sitename"))
+            rows["is_closed"].append(bool(site.get("closed", False)))
+            rows["is_private"].append(bool(site.get("private", False)))
+            rows["_source_file"].append(source)
+            rows["_source_sha256"].append(digest)
+    return pa.table({name: pa.array(values, _TYPES[name]) for name, values in rows.items()})
+
+
+def _sites(matrix: dict):
+    for key, group in matrix.items():
+        if key == "count":
+            continue
+        if key == "specials":
+            for site in group:
+                yield site["lang"], site
+        else:
+            for site in group.get("site", []):
+                yield group["code"], site
+
+
+_TYPES = {
+    "dbname": pa.string(),
+    "host": pa.string(),
+    "url": pa.string(),
+    "site_code": pa.string(),
+    "language_code": pa.string(),
+    "sitename": pa.string(),
+    "is_closed": pa.bool_(),
+    "is_private": pa.bool_(),
+    "_source_file": pa.string(),
+    "_source_sha256": pa.string(),
+}
+_COLUMNS = list(_TYPES)
