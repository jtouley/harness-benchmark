+"""The `python` transform: calls a named function `module:callable` with the Arrow table."""
+
+import importlib
+from typing import Any, Mapping
+
+import pyarrow as pa
+
+
+def apply_python(options: Mapping[str, Any], table: pa.Table) -> pa.Table:
+    module_name, _, attr = options["function"].partition(":")
+    if not attr:
+        raise ValueError(f"function {options['function']!r} must look like module:callable")
+    function = getattr(importlib.import_module(module_name), attr)
+    return function(table)
