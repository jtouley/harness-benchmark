diff --git a/tests/conftest.py b/tests/conftest.py
new file mode 100644
index 0000000..d0e49ac
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,82 @@
+import http.server
+import json
+import threading
+from dataclasses import dataclass, field
+
+import pytest
+
+
+@dataclass
+class SseScript:
+    """A scripted SSE endpoint: serves `events` and honours Last-Event-ID on reconnect."""
+
+    events: list[tuple[str, str]]
+    drop_first_after: int | None = None
+    url: str = ""
+    connections: int = 0
+    last_event_ids: list[str | None] = field(default_factory=list)
+
+
+class _SseHandler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *args) -> None:
+        pass
+
+    def do_GET(self) -> None:
+        script: SseScript = self.server.script
+        script.connections += 1
+        last = self.headers.get("Last-Event-ID")
+        script.last_event_ids.append(last)
+        ids = [event_id for event_id, _ in script.events]
+        start = 0 if last is None else ids.index(last) + 1
+        remaining = script.events[start:]
+        if not remaining:
+            self.send_response(204)
+            self.end_headers()
+            return
+        self.send_response(200)
+        self.send_header("Content-Type", "text/event-stream")
+        self.end_headers()
+        drop = script.drop_first_after if script.connections == 1 else None
+        for sent, (event_id, data) in enumerate(remaining):
+            if drop is not None and sent == drop:
+                return  # cut the connection mid-stream
+            self.wfile.write(f"id: {event_id}\nevent: message\ndata: {data}\n\n".encode())
+            self.wfile.flush()
+
+
+@pytest.fixture
+def serve_sse():
+    servers: list[http.server.ThreadingHTTPServer] = []
+
+    def serve(events, drop_first_after=None) -> SseScript:
+        script = SseScript(events=list(events), drop_first_after=drop_first_after)
+        server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), _SseHandler)
+        server.daemon_threads = True
+        server.script = script
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        script.url = f"http://127.0.0.1:{server.server_port}/v2/stream/recentchange"
+        servers.append(server)
+        return script
+
+    yield serve
+    for server in servers:
+        server.shutdown()
+        server.server_close()
+
+
+def recentchange(meta_id, timestamp, *, kind="edit", server="en.wikipedia.org", bot=False,
+                 namespace=0, old=100, new=120):
+    """One recentchange event as the replay server sends it, reduced to the fields we read."""
+    data = {
+        "type": kind,
+        "namespace": namespace,
+        "title": f"Page {meta_id}",
+        "user": "someone",
+        "bot": bot,
+        "timestamp": timestamp,
+        "server_name": server,
+        "wiki": server.replace(".wikipedia.org", "wiki").replace(".org", ""),
+        "meta": {"id": meta_id, "dt": "2026-10-14T00:00:00.000Z"},
+        "length": {"old": old, "new": new},
+    }
+    return json.dumps(data)
