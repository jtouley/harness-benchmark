+SOURCES.register(Kind("file", frozenset({"path"}), frozenset({"format", "encoding", "member", "constants"}), read_file))
+SOURCES.register(Kind("sse", frozenset({"url"}), frozenset(), read_sse))
+
+TRANSFORMS.register(Kind("polars", frozenset(), frozenset({"select", "drop", "rename", "cast"}), apply_polars))
+TRANSFORMS.register(Kind("datafusion", frozenset({"sql"}), frozenset(), apply_datafusion))
+TRANSFORMS.register(Kind("python", frozenset({"function"}), frozenset(), apply_python))
+
+SINKS.register(Kind("lake", frozenset({"table"}), frozenset(), write_lake))
