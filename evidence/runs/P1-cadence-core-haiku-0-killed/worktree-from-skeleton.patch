+"""Shared helpers for tests that read the lake or the built warehouse."""
+
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+WAREHOUSE = ROOT / "out" / "warehouse.duckdb"
+LAKE = ROOT / "lake"
+
+
+def lake_glob(table):
+    return str(LAKE / table / "*.parquet")
+
+
+def dbt(command, *selectors):
+    """Run dbt from the repo root, against the project in transform/."""
+    args = [sys.executable, "-m", "dbt.cli.main", command,
+            "--project-dir", "transform", "--profiles-dir", "transform"]
+    if selectors:
+        args += ["--select", *selectors]
+    subprocess.run(args, cwd=ROOT, check=True, capture_output=True)
