+import csv
+import io
+import zipfile
+
+
+def usaspending_rows(zip_paths):
+    """Yield every CSV row of the given zips, read in place. The zip's toptier code tags each row."""
+    for zip_path in zip_paths:
+        toptier_code = zip_path.name.split("_")[1]
+        with zipfile.ZipFile(zip_path) as archive:
+            (member,) = archive.namelist()
+            with archive.open(member) as raw:
+                reader = csv.DictReader(io.TextIOWrapper(raw, encoding="utf-8-sig", newline=""))
+                for row in reader:
+                    row["source_toptier_code"] = toptier_code
+                    yield row
