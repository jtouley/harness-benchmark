+import csv
+import io
+import json
+import shutil
+import unittest
+import zipfile
+from pathlib import Path
+
+import duckdb
+
+ROOT = Path(__file__).resolve().parent.parent
+RAW = ROOT / "data" / "raw"
+TEST_ROOT = ROOT / "out" / "test-lake" / "batch_ingestion"
+
+USASPENDING_TABLES = {
+    "usaspending_contracts": "Contracts",
+    "usaspending_assistance": "Assistance",
+}
+CENSUS_FILES = {
+    "census_county_2024": "co-est2024-alldata.csv",
+    "census_county_2021": "co-est2021-alldata.csv",
+}
+
+
+def _usaspending_zips(kind):
+    return sorted((RAW / "usaspending").glob(f"FY2024_*_{kind}_Full_*.zip"))
+
+
+def _zip_csv_rows(zip_path):
+    with zipfile.ZipFile(zip_path) as zf:
+        (name,) = zf.namelist()
+        with zf.open(name) as raw:
+            reader = csv.reader(io.TextIOWrapper(raw, encoding="utf-8-sig", newline=""))
+            header = next(reader)
+            rows = list(reader)
+    return header, rows
+
+
+def _census_rows(file_name):
+    with open(RAW / "census" / file_name, encoding="latin-1", newline="") as handle:
+        reader = csv.DictReader(handle)
+        header = reader.fieldnames
+        rows = [row for row in reader if row["SUMLEV"] == "050"]
+    return header, rows
+
+
+def _sitematrix_sites():
+    sitematrix = json.loads((RAW / "sitematrix.json").read_text(encoding="utf-8"))["sitematrix"]
+    sites = []
+    for key, value in sitematrix.items():
+        if key == "count":
+            continue
+        if key == "specials":
+            sites.extend(value)
+        elif isinstance(value, dict):
+            sites.extend(value.get("site", []))
+    return sites
+
+
+def _lake_glob(table):
+    return str(TEST_ROOT / table / "**" / "*.parquet")
+
+
+def _lake_count(table):
+    return duckdb.sql(f"SELECT count(*) FROM read_parquet('{_lake_glob(table)}')").fetchone()[0]
+
+
+def _lake_columns(table):
+    return {row[0] for row in duckdb.sql(
+        f"DESCRIBE SELECT * FROM read_parquet('{_lake_glob(table)}')").fetchall()}
+
+
+def _lake_row_set(table):
+    rows = duckdb.sql(
+        f"SELECT * EXCLUDE (_dlt_load_id, _dlt_id) FROM read_parquet('{_lake_glob(table)}')"
+    ).fetchall()
+    return sorted(rows, key=repr)
+
+
+def setUpModule():
+    from pipeline.batch import run_batch
+
+    shutil.rmtree(TEST_ROOT, ignore_errors=True)
+    run_batch(TEST_ROOT, RAW)
+
+
+def tearDownModule():
+    shutil.rmtree(TEST_ROOT, ignore_errors=True)
+
+
+class UsaspendingIngestionTest(unittest.TestCase):
+    def test_lake_rows_equal_csv_data_rows_per_table(self):
+        for table, kind in USASPENDING_TABLES.items():
+            with self.subTest(table=table):
+                expected = sum(len(_zip_csv_rows(z)[1]) for z in _usaspending_zips(kind))
+                self.assertEqual(_lake_count(table), expected)
+
+    def test_contracts_row_total_is_416_and_assistance_row_total_is_9404(self):
+        self.assertEqual(_lake_count("usaspending_contracts"), 416)
+        self.assertEqual(_lake_count("usaspending_assistance"), 9404)
+
+    def test_lake_has_every_source_header_column(self):
+        for table, kind in USASPENDING_TABLES.items():
+            with self.subTest(table=table):
+                header = set()
+                for zip_path in _usaspending_zips(kind):
+                    header.update(_zip_csv_rows(zip_path)[0])
+                self.assertTrue(header <= _lake_columns(table))
+
+    def test_every_row_carries_its_zip_toptier_code(self):
+        for table, kind in USASPENDING_TABLES.items():
+            with self.subTest(table=table):
+                expected = {}
+                for zip_path in _usaspending_zips(kind):
+                    code = zip_path.name.split("_")[1]
+                    expected[code] = expected.get(code, 0) + len(_zip_csv_rows(zip_path)[1])
+                actual = dict(duckdb.sql(
+                    f"SELECT source_toptier_code, count(*) FROM read_parquet('{_lake_glob(table)}') "
+                    "GROUP BY 1").fetchall())
+                self.assertEqual(actual, expected)
+
+
+class CensusAndSitesIngestionTest(unittest.TestCase):
+    def test_census_lake_rows_equal_county_rows(self):
+        for table, file_name in CENSUS_FILES.items():
+            with self.subTest(table=table):
+                _, rows = _census_rows(file_name)
+                self.assertEqual(_lake_count(table), len(rows))
+
+    def test_census_lake_has_every_source_header_column(self):
+        for table, file_name in CENSUS_FILES.items():
+            with self.subTest(table=table):
+                header, _ = _census_rows(file_name)
+                self.assertTrue(set(header) <= _lake_columns(table))
+
+    def test_wiki_sites_lake_rows_equal_site_entries(self):
+        self.assertEqual(_lake_count("wiki_sites"), len(_sitematrix_sites()))
+
+    def test_wiki_sites_lake_has_dbname_code_url(self):
+        self.assertTrue({"dbname", "code", "url"} <= _lake_columns("wiki_sites"))
+
+
+class RepeatableLakeWriteTest(unittest.TestCase):
+    def test_second_run_gives_same_row_count_and_row_set(self):
+        from pipeline.batch import run_batch
+
+        tables = list(USASPENDING_TABLES) + list(CENSUS_FILES) + ["wiki_sites"]
+        before = {table: (_lake_count(table), _lake_row_set(table)) for table in tables}
+        run_batch(TEST_ROOT, RAW)
+        for table in tables:
+            with self.subTest(table=table):
+                self.assertEqual((_lake_count(table), _lake_row_set(table)), before[table])
+
+
+if __name__ == "__main__":
+    unittest.main()
