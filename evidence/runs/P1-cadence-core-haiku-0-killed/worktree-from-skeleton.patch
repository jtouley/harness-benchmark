+"""Batch ingestion: the raw USAspending zips, the Census files and the site matrix into the lake."""
+
+import argparse
+from pathlib import Path
+
+import dlt
+
+from pipeline.lake import make_pipeline
+from pipeline.sources.census import census_county_rows
+from pipeline.sources.sitematrix import wiki_site_rows
+from pipeline.sources.usaspending import usaspending_rows
+
+
+def _usaspending_zips(raw_root, kind):
+    return sorted((raw_root / "usaspending").glob(f"FY2024_*_{kind}_Full_*.zip"))
+
+
+def batch_source(raw_root):
+    raw_root = Path(raw_root)
+    census = raw_root / "census"
+    return [
+        dlt.resource(usaspending_rows(_usaspending_zips(raw_root, "Contracts")),
+                     name="usaspending_contracts", write_disposition="replace"),
+        dlt.resource(usaspending_rows(_usaspending_zips(raw_root, "Assistance")),
+                     name="usaspending_assistance", write_disposition="replace"),
+        dlt.resource(census_county_rows(census / "co-est2024-alldata.csv"),
+                     name="census_county_2024", write_disposition="replace"),
+        dlt.resource(census_county_rows(census / "co-est2021-alldata.csv"),
+                     name="census_county_2021", write_disposition="replace"),
+        dlt.resource(wiki_site_rows(raw_root / "sitematrix.json"),
+                     name="wiki_sites", write_disposition="replace"),
+    ]
+
+
+def run_batch(lake_root, raw_root):
+    pipeline = make_pipeline(lake_root, "batch")
+    return pipeline.run(batch_source(raw_root), loader_file_format="parquet")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--lake-root", default="lake")
+    parser.add_argument("--raw-root", default="data/raw")
+    args = parser.parse_args()
+    print(run_batch(Path(args.lake_root), Path(args.raw_root)))
+
+
+if __name__ == "__main__":
+    main()
