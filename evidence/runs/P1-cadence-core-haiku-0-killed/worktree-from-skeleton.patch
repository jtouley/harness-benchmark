+import unittest
+
+import duckdb
+
+from tests.support import WAREHOUSE, dbt, lake_glob
+
+OLD_CONNECTICUT = {f"09{number:03d}" for number in range(1, 16)}
+TERRITORY_CODES = {
+    "72013", "72021", "72025", "72035", "72049", "72061", "72063", "72093", "72097", "72113", "72127",
+    "60050", "66010", "69110", "78030",
+}
+
+
+def setUpModule():
+    dbt("run", "staging", "dim*", "fct_award_transaction", "mart_obligations_monthly")
+
+
+class PopulationYearTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.db = duckdb.connect(str(WAREHOUSE), read_only=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.db.close()
+
+    def _census_fips(self, table):
+        return {row[0] for row in self.db.sql(f"""
+            SELECT lpad(trim(STATE), 2, '0') || lpad(trim(COUNTY), 3, '0')
+            FROM read_parquet('{lake_glob(table)}')
+            WHERE SUMLEV = '050'
+        """).fetchall()}
+
+    def test_population_year_follows_rule(self):
+        in_2024 = self._census_fips("census_county_2024")
+        in_2021 = self._census_fips("census_county_2021")
+        counties = self.db.sql("""
+            SELECT DISTINCT county_fips, population_year FROM mart_obligations_monthly
+            WHERE county_fips <> 'UNASSIGNED'
+        """).fetchall()
+        self.assertTrue(counties)
+        for county_fips, population_year in counties:
+            with self.subTest(county_fips=county_fips):
+                if county_fips in in_2024:
+                    expected = 2024
+                elif county_fips in in_2021:
+                    expected = 2021
+                else:
+                    expected = None
+                self.assertEqual(population_year, expected)
+        vintage_2021 = {fips for fips, year in counties if year == 2021}
+        self.assertTrue(vintage_2021 <= OLD_CONNECTICUT)
+
+    def test_territory_codes_have_null_population(self):
+        codes = {row[0] for row in self.db.sql("""
+            SELECT DISTINCT county_fips FROM mart_obligations_monthly
+            WHERE population IS NULL AND county_fips <> 'UNASSIGNED'
+        """).fetchall()}
+        self.assertEqual(codes, TERRITORY_CODES)
+
+    def test_old_connecticut_rows_take_2021_vintage(self):
+        raw_rows = self.db.sql(f"""
+            SELECT count(*) FROM (
+                SELECT lpad(prime_award_transaction_recipient_county_fips_code, 5, '0') AS fips
+                FROM read_parquet('{lake_glob("usaspending_contracts")}')
+                UNION ALL
+                SELECT lpad(prime_award_transaction_recipient_county_fips_code, 5, '0')
+                FROM read_parquet('{lake_glob("usaspending_assistance")}')
+            ) WHERE fips IN (SELECT unnest($codes))
+        """, params={"codes": sorted(OLD_CONNECTICUT)}).fetchone()[0]
+        mart_rows = self.db.sql("""
+            SELECT count(*) FROM fct_award_transaction f
+            JOIN dim_place p ON p.place_key = f.place_key
+            WHERE p.county_fips IN (SELECT unnest($codes))
+        """, params={"codes": sorted(OLD_CONNECTICUT)}).fetchone()[0]
+        self.assertEqual(raw_rows, 68)
+        self.assertEqual(mart_rows, 68)
+
+
+if __name__ == "__main__":
+    unittest.main()
