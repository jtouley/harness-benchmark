+import json
+
+
+def wiki_site_rows(path):
+    """Yield one row per site of the Wikimedia site matrix, including the specials list."""
+    sitematrix = json.loads(path.read_text(encoding="utf-8"))["sitematrix"]
+    for key, value in sitematrix.items():
+        if key == "count":
+            continue
+        sites = value if key == "specials" else value.get("site", [])
+        for site in sites:
+            yield {"dbname": site["dbname"], "code": site["code"], "url": site["url"]}
