@@ -0,0 +1,33 @@
+"""The dlt pipeline helper shared by the batch and the stream. Writes Parquet to one lake folder.
+
+The filesystem destination writes to <bucket>/<dataset>/<table>/. The bucket is the lake's parent and
+the dataset is the lake's folder name, so each table is a folder directly under the lake root. The
+lake root name must already be a snake_case name (for example `lake` or `batch_ingestion`), because
+dlt normalizes the dataset name.
+"""
+
+import os
+from pathlib import Path
+
+import dlt
+from dlt.destinations import filesystem
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def make_pipeline(lake_root, name):
+    lake_root = Path(lake_root).resolve()
+    # Source column names are kept as written in the files (COVID-19, Q1, ...).
+    os.environ.setdefault("SCHEMA__NAMING", "direct")
+    return dlt.pipeline(
+        pipeline_name=f"{name}_{lake_root.name}",
+        # Outside the lake root: dlt cannot create its state inside the dataset folder.
+        pipelines_dir=str(ROOT / "out" / "dlt-state" / lake_root.name),
+        destination=filesystem(
+            bucket_url=str(lake_root.parent),
+            layout="{table_name}/{load_id}.{file_id}.{ext}",
+            # No table name is a prefix of another table name here, so `replace` deletes only its own folder.
+            warn_unsafe_layout_separators=False,
+        ),
+        dataset_name=lake_root.name,
+    )
