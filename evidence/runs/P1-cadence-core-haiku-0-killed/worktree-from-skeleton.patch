index 0000000..dd21bc9
--- /dev/null
+++ b/pipeline/stream/lateness.py
@@ -0,0 +1,23 @@
+"""Event time, windows and lateness (decisions cd-1-lateness-watermark and cd-1-stream-micro-batch)."""
+
+import math
+from datetime import datetime
+
+WINDOW_SECONDS = 300
+LATE_AFTER_SECONDS = 600
+
+
+def event_time_of(text):
+    """Epoch seconds of a Wikimedia meta.dt value, such as 2026-10-14T23:46:52.165Z (UTC)."""
+    return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
+
+
+def window_start_of(event_time):
+    return math.floor(event_time / WINDOW_SECONDS) * WINDOW_SECONDS
+
+
+def is_late(watermark_before, event_time):
+    """Late when the watermark before the event is more than 10 minutes past the event's window end."""
+    if watermark_before is None:
+        return False
+    return watermark_before > window_start_of(event_time) + WINDOW_SECONDS + LATE_AFTER_SECONDS
diff --git a/pipeline/stream/sse.py b/pipeline/stream/sse.py
new file mode 100644
index 0000000..369573b
--- /dev/null
+++ b/pipeline/stream/sse.py
@@ -0,0 +1,67 @@
+"""Server-sent events: a line parser and the HTTP opener. The parser is pure; the opener is the only network code."""
+
+import urllib.request
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class SSEEvent:
+    id: str | None
+    event: str
+    data: str
+
+
+class SSEParser:
+    """Feeds one line at a time. feed() returns an SSEEvent when a blank line ends a dispatched event."""
+
+    def __init__(self):
+        self.last_id = None
+        self.retry = None  # seconds, from the last retry: field
+        self._data = []
+        self._event = None
+
+    def feed(self, line):
+        if line == "":
+            if not self._data:
+                self._event = None
+                return None
+            event = SSEEvent(id=self.last_id, event=self._event or "message", data="\n".join(self._data))
+            self._data = []
+            self._event = None
+            return event
+        if line.startswith(":"):
+            return None
+        field, _, value = line.partition(":")
+        if value.startswith(" "):
+            value = value[1:]
+        if field == "data":
+            self._data.append(value)
+        elif field == "event":
+            self._event = value
+        elif field == "id" and "\x00" not in value:
+            self.last_id = value
+        elif field == "retry" and value.isdigit():
+            self.retry = int(value) / 1000
+        return None
+
+
+class SSEResponse:
+    def __init__(self, response):
+        self.status = response.status
+        self._response = response
+
+    def lines(self):
+        for raw in self._response:
+            yield raw.decode("utf-8").rstrip("\r\n")
+
+    def close(self):
+        self._response.close()
+
+
+def open_sse(url, last_event_id=None, timeout=60.0):
+    """Open one connection. Raises OSError for a refusal, a reset, or an HTTP error status (4xx, 5xx)."""
+    headers = {"Accept": "text/event-stream"}
+    if last_event_id:
+        headers["Last-Event-ID"] = last_event_id
+    request = urllib.request.Request(url, headers=headers)
+    return SSEResponse(urllib.request.urlopen(request, timeout=timeout))
