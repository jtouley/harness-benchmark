+import csv
+
+
+def census_county_rows(path):
+    """Yield the county rows (SUMLEV 050) of one Census county estimates file."""
+    with open(path, encoding="latin-1", newline="") as handle:
+        for row in csv.DictReader(handle):
+            if row["SUMLEV"] == "050":
+                yield row
