index 0000000..98dbd87
--- /dev/null
+++ b/transform/tests/assert_mart_grain_is_unique.sql
@@ -0,0 +1,5 @@
+-- The mart grain is month x state x county x awarding agency.
+select month, state_code, county_fips, agency_name, count(*) as n
+from {{ ref('mart_obligations_monthly') }}
+group by 1, 2, 3, 4
+having count(*) > 1
