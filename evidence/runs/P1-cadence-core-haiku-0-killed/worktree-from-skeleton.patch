+{#
+  One template for both USAspending families (decision cd-1-contracts-assistance-union).
+  The family argument picks the two key columns. Every other column maps to the shared set.
+#}
+{% macro usaspending_staging(family) %}
+{% set key_columns = {
+    'contracts': ('contract_transaction_unique_key', 'contract_award_unique_key'),
+    'assistance': ('assistance_transaction_unique_key', 'assistance_award_unique_key'),
+} %}
+{% set transaction_column, award_column = key_columns[family] %}
+
+with typed as (
+    select
+        trim("{{ transaction_column }}") as transaction_key,
+        trim("{{ award_column }}") as award_key,
+        trim(source_toptier_code) as source_toptier_code,
+        trim(awarding_agency_code) as agency_code,
+        trim(awarding_agency_name) as agency_name,
+        cast(action_date as date) as action_date,
+        cast(action_date_fiscal_year as integer) as action_date_fiscal_year,
+        nullif(trim(recipient_state_code), '') as raw_state_code,
+        nullif(trim(prime_award_transaction_recipient_county_fips_code), '') as raw_county_fips,
+        nullif(trim(recipient_county_name), '') as raw_county_name,
+        cast(nullif(trim(federal_action_obligation), '') as decimal(18, 2)) as federal_action_obligation
+    from {{ source('lake', 'usaspending_' ~ family) }}
+)
+
+select
+    transaction_key,
+    award_key,
+    '{{ family }}' as family,
+    source_toptier_code,
+    agency_code,
+    agency_name,
+    action_date,
+    action_date_fiscal_year,
+    coalesce(raw_state_code, 'UNASSIGNED') as state_code,
+    coalesce(lpad(raw_county_fips, 5, '0'), 'UNASSIGNED') as county_fips,
+    case when raw_county_fips is null then 'UNASSIGNED'
+         else coalesce(raw_county_name, 'UNASSIGNED') end as county_name,
+    federal_action_obligation
+from typed
+{% endmacro %}
