+      state_code is UNASSIGNED when the recipient state is blank (decision cd-1-place-rule).
+    columns:
+      - name: transaction_key
+        tests: [unique, not_null]
+      - name: award_key
+        description: The file's assistance_award_unique_key (decision cd-1-award-key).
+        tests: [not_null]
+      - name: family
+        tests:
+          - accepted_values:
+              arguments:
+                values: ['assistance']
+      - name: action_date_fiscal_year
+        tests: [not_null]
+
+  - name: stg_census_county
+    description: >
+      Grain: one row per county per population_year (2024 or 2021), SUMLEV 050 only.
+      county_fips is STATE (2 digits) followed by COUNTY (3 digits).
+    columns:
+      - name: population_year
+        tests: [not_null]
+      - name: county_fips
+        tests: [not_null]
+
+  - name: stg_wiki_sites
+    description: >
+      Grain: one row per Wikimedia site (the sitematrix list, including specials).
+    columns:
+      - name: dbname
+        tests: [unique, not_null]
