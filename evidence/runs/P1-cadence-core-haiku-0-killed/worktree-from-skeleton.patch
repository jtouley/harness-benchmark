+import unittest
+
+from pipeline.stream.consume import consume
+from pipeline.stream.sse import SSEParser
+from tests.stream_support import (
+    Clock,
+    ScriptedReplay,
+    Sleeps,
+    cleanup_root,
+    fresh_root,
+    landed_is_late,
+    landed_rows,
+    make_events,
+)
+
+
+def run(root, opener, clock, duration=1000.0, **kwargs):
+    kwargs.setdefault("sleep", Sleeps(clock))
+    return consume(url="replay://fixture", lake_root=root, duration=duration, clock=clock,
+                   open_stream=opener, **kwargs)
+
+
+class SSEParserTest(unittest.TestCase):
+    def test_sse_parser_handles_multiline_data_comments_and_ids(self):
+        lines = [
+            ": a comment", "id: 7", "event: message", 'data: {"a":', "data:  1}", "",
+            "retry: 2500", "id: 8", "data: x", "", ": another comment", "",
+            "data: not dispatched, no blank line follows",
+        ]
+        parser = SSEParser()
+        events = [event for line in lines if (event := parser.feed(line)) is not None]
+        self.assertEqual([(e.id, e.event, e.data) for e in events],
+                         [("7", "message", '{"a":\n 1}'), ("8", "message", "x")])
+        self.assertEqual(parser.retry, 2.5)
+
+
+class SameEventTwiceTest(unittest.TestCase):
+    def test_same_meta_id_lands_once(self):
+        root = fresh_root("stream_unit_dedupe")
+        events = make_events(3)
+        duplicate = dict(events[1], id="[copy-of-2]")
+        replay = ScriptedReplay(events + [duplicate], plan=[("send", None, "close"), ("end",)])
+        run(root, replay, Clock())
+        rows = landed_rows(root)
+        self.assertEqual(len(rows), 3)
+        self.assertEqual(sorted(r["arrival_seq"] for r in rows), [0, 1, 2])
+        cleanup_root(root)
+
+
+class ArrivalSeqRestartTest(unittest.TestCase):
+    def test_arrival_seq_increases_across_restart(self):
+        root = fresh_root("stream_unit_seq_restart")
+        clock = Clock()
+        events = make_events(8)
+        run(root, ScriptedReplay(events[:5], plan=[("send", None, "close"), ("end",)]), clock)
+        run(root, ScriptedReplay(events, plan=[("send", None, "close"), ("end",)]), clock)
+        rows = sorted(landed_rows(root), key=lambda r: r["arrival_seq"])
+        self.assertEqual(len(rows), 8)
+        seqs = [r["arrival_seq"] for r in rows]
+        self.assertEqual(seqs, list(range(8)))
+        cleanup_root(root)
+
+
+class GracefulEndTest(unittest.TestCase):
+    def test_graceful_end_lands_every_consumed_event(self):
+        root = fresh_root("stream_unit_graceful")
+        clock = Clock(1000.0)
+        events = make_events(500)
+
+        def one_second_per_event(line):
+            if line.startswith("data:"):
+                clock.advance(1.0)
+
+        summary = run(root, ScriptedReplay(events, plan=[("send", None, "close")]), clock,
+                      duration=301.0, on_line=one_second_per_event)
+        self.assertEqual(summary["reason"], "DURATION expired")
+        self.assertEqual(len(landed_rows(root)), 300)
+        self.assertEqual(summary["landed"], 300)
+
+        restart = ScriptedReplay(events, plan=[("send", None, "close")])
+        run(root, restart, clock, duration=301.0)
+        self.assertEqual(len(landed_rows(root)), 300)
+        cleanup_root(root)
+
+
+class UpstreamEndSignalTest(unittest.TestCase):
+    def test_upstream_close_lands_every_consumed_event(self):
+        root = fresh_root("stream_unit_upstream_end")
+        clock = Clock()
+        events = make_events(120)
+        summary = run(root, ScriptedReplay(events, plan=[("send", None, "close"), ("end",)]), clock)
+        self.assertEqual(summary["reason"], "upstream end signal")
+        self.assertEqual(len(landed_rows(root)), 120)
+
+        restart = run(root, ScriptedReplay(events, plan=[("end",)]), clock)
+        self.assertEqual(restart["reason"], "upstream end signal")
+        self.assertEqual(len(landed_rows(root)), 120)
+        cleanup_root(root)
+
+
+class CleanCloseReconnectTest(unittest.TestCase):
+    def test_clean_close_reconnects_and_lands_each_event_once(self):
+        root = fresh_root("stream_unit_clean_close")
+        events = make_events(240)
+        replay = ScriptedReplay(events, honors=True,
+                                plan=[("send", 120, "close"), ("send", 120, "close"), ("end",)])
+        summary = run(root, replay, Clock())
+        self.assertEqual(replay.last_event_ids, [None, events[119]["id"], events[239]["id"]])
+        rows = landed_rows(root)
+        self.assertEqual(len(rows), 240)
+        self.assertEqual(len({r["meta_id"] for r in rows}), 240)
+        self.assertEqual(summary["reason"], "upstream end signal")
+        cleanup_root(root)
+
+
+class MidBatchReconnectTest(unittest.TestCase):
+    def _is_late_of(self, root):
+        return landed_is_late(landed_rows(root))
+
+    def test_reconnect_mid_batch_dedupes_consumed_events(self):
+        events = make_events(1200)
+        reference_root = fresh_root("stream_unit_midbatch_ref")
+        run(reference_root, ScriptedReplay(events, plan=[("send", None, "close"), ("end",)]), Clock())
+        reference = self._is_late_of(reference_root)
+        self.assertEqual(len(reference), 1200)
+
+        for drop_after in (560, 1010):
+            for honors in (True, False):
+                with self.subTest(drop_after=drop_after, honors=honors):
+                    root = fresh_root(f"stream_unit_midbatch_{drop_after}_{int(honors)}")
+                    plan = [("send", drop_after, "error"), ("send", None, "close"), ("end",)]
+                    run(root, ScriptedReplay(events, plan=plan, honors=honors), Clock())
+                    rows = landed_rows(root)
+                    self.assertEqual(len(rows), 1200)
+                    self.assertEqual(len({r["meta_id"] for r in rows}), 1200)
+                    self.assertEqual(self._is_late_of(root), reference)
+                    cleanup_root(root)
+        cleanup_root(reference_root)
+
+
+class LakeRootIsolationTest(unittest.TestCase):
+    def test_lake_root_isolates_runs(self):
+        events = make_events(200)
+        first = fresh_root("stream_unit_root_a")
+        second = fresh_root("stream_unit_root_b")
+        run(first, ScriptedReplay(events, plan=[("send", None, "close"), ("end",)]), Clock())
+        run(second, ScriptedReplay(events, plan=[("send", None, "close"), ("end",)]), Clock())
+        self.assertEqual(len(landed_rows(first)), 200)
+        self.assertEqual(len(landed_rows(second)), 200)
+        cleanup_root(first)
+        cleanup_root(second)
+
+
+class NoEndSignalTest(unittest.TestCase):
+    def test_no_end_signal_runs_to_duration(self):
+        events = make_events(120)
+
+        root = fresh_root("stream_unit_no_end_one")
+        clock = Clock(1000.0)
+        replay = ScriptedReplay(events, plan=[("send", None, "close")], default=("refuse",))
+        summary = run(root, replay, clock, duration=30.0)
+        self.assertEqual(len(landed_rows(root)), 120)
+        self.assertEqual(summary["reason"], "DURATION expired")
+        self.assertEqual(summary["failed_attempts"], summary["attempts"] - 1)
+        self.assertEqual(clock(), 1030.0)
+        cleanup_root(root)
+
+        root = fresh_root("stream_unit_no_end_two")
+        clock = Clock(1000.0)
+        plan = [("send", 120, "close"), ("refuse",), ("refuse",), ("refuse",), ("refuse",),
+                ("send", 120, "close")]
+        replay = ScriptedReplay(events + make_events(120, first=121), plan=plan, honors=True,
+                                default=("refuse",))
+        summary = run(root, replay, clock, duration=60.0)
+        self.assertEqual(len(landed_rows(root)), 240)
+        self.assertEqual(summary["reason"], "DURATION expired")
+        self.assertEqual(summary["failed_attempts"], summary["attempts"] - 6)
+        cleanup_root(root)
+
+
+class _KeepaliveOnlyResponse:
+    """A connection that sends only keepalive comment lines, for a long time, and then closes."""
+
+    status = 200
+
+    def __init__(self, lines=10_000):
+        self._lines = lines
+
+    def lines(self):
+        for _ in range(self._lines):
+            yield ":"
+
+    def close(self):
+        pass
+
+
+class SilentStreamTest(unittest.TestCase):
+    def test_keepalive_lines_alone_end_the_run_at_duration(self):
+        clock = Clock(1000.0)
+        read = []
+
+        def count_line(line):
+            read.append(line)
+            clock.advance(1.0)
+
+        root = fresh_root("stream_unit_silent")
+        summary = run(root, lambda url, last_id: _KeepaliveOnlyResponse(),
+                      clock, duration=30.0, on_line=count_line)
+        self.assertEqual(summary["reason"], "DURATION expired")
+        self.assertLess(len(read), 100, "the run read keepalive lines long after DURATION")
+        cleanup_root(root)
+
+
+if __name__ == "__main__":
+    unittest.main()
