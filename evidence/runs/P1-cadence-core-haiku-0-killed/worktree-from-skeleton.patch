diff --git a/transform/tests/assert_check4_reconciles_by_month.sql b/transform/tests/assert_check4_reconciles_by_month.sql
new file mode 100644
index 0000000..12eb7ba
--- /dev/null
+++ b/transform/tests/assert_check4_reconciles_by_month.sql
@@ -0,0 +1,27 @@
+-- Check 4: for every month, the county sums, the state sums and the source total are equal.
+with source_by_month as (
+    select cast(date_trunc('month', date_key) as date) as month,
+           sum(federal_action_obligation) as total
+    from {{ ref('fct_award_transaction') }}
+    group by 1
+),
+county_by_month as (
+    select month, sum(net_obligations) as total
+    from {{ ref('mart_obligations_monthly') }}
+    group by 1
+),
+state_by_month as (
+    select month, sum(state_total) as total
+    from (
+        select month, state_code, sum(net_obligations) as state_total
+        from {{ ref('mart_obligations_monthly') }}
+        group by 1, 2
+    )
+    group by 1
+)
+select s.month, s.total as source_total, c.total as county_total, st.total as state_total
+from source_by_month as s
+left join county_by_month as c using (month)
+left join state_by_month as st using (month)
+where c.total is distinct from s.total
+   or st.total is distinct from s.total
