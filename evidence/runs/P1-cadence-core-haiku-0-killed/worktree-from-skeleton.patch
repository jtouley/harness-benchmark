+"""The stream consumer. Reads the SSE stream and lands each event once in <lake-root>/stream_edit_raw/.
+
+Usage: python -m pipeline.stream.consume --url <url> --duration <seconds> --lake-root <dir>
+A run ends at one graceful end: DURATION expired, SIGINT, or the upstream end signal (HTTP 204).
+"""
+
+import argparse
+import json
+import os
+import signal
+import time
+from pathlib import Path
+
+import dlt
+import duckdb
+
+from pipeline.lake import make_pipeline
+from pipeline.stream.lateness import WINDOW_SECONDS, event_time_of, is_late, window_start_of
+from pipeline.stream.sse import SSEParser, open_sse
+
+STREAM_TABLE = "stream_edit_raw"
+CURSOR_FILE = "_stream_cursor.json"
+DEFAULT_URL = "http://localhost:8099/v2/stream/recentchange"
+DEFAULT_DURATION = 3600.0
+FLUSH_EVENTS = 500
+FLUSH_SECONDS = 10.0
+RECONNECT_SECONDS = 1.0
+TIME_UP = "DURATION expired"
+INTERRUPTED = "SIGINT"
+END_OF_STREAM = "upstream end signal"
+
+STREAM_COLUMNS = {
+    "meta_id": {"data_type": "text"},
+    "event_id": {"data_type": "bigint"},
+    "event_time": {"data_type": "text"},
+    "event_epoch": {"data_type": "double"},
+    "type": {"data_type": "text"},
+    "namespace": {"data_type": "bigint"},
+    "title": {"data_type": "text"},
+    "comment": {"data_type": "text"},
+    "timestamp": {"data_type": "bigint"},
+    "user_name": {"data_type": "text"},
+    "bot": {"data_type": "bool"},
+    "wiki": {"data_type": "text"},
+    "server_name": {"data_type": "text"},
+    "length_old": {"data_type": "bigint"},
+    "length_new": {"data_type": "bigint"},
+    "revision_old": {"data_type": "bigint"},
+    "revision_new": {"data_type": "bigint"},
+    "sse_id": {"data_type": "text"},
+    "arrival_seq": {"data_type": "bigint"},
+    "window_start": {"data_type": "bigint"},
+    "window_end": {"data_type": "bigint"},
+    "watermark_before": {"data_type": "double"},
+    "is_late": {"data_type": "bool"},
+}
+
+
+def land_rows(pipeline, rows):
+    """Append one micro-batch as one committed dlt load (the same pipeline helper as the batch)."""
+    resource = dlt.resource(rows, name=STREAM_TABLE, write_disposition="append", columns=STREAM_COLUMNS)
+    pipeline.run(resource, loader_file_format="parquet")
+
+
+def _read_cursor(lake_root):
+    try:
+        return json.loads((lake_root / CURSOR_FILE).read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return {}
+
+
+def _write_cursor(lake_root, cursor):
+    temp = lake_root / (CURSOR_FILE + ".tmp")
+    temp.write_text(json.dumps(cursor, sort_keys=True), encoding="utf-8")
+    os.replace(temp, lake_root / CURSOR_FILE)
+
+
+def _committed_load_ids(lake_root):
+    """Load ids that dlt recorded as loaded (status 0). A load without that record is not landed."""
+    ids = set()
+    for path in (lake_root / "_dlt_loads").glob("*.jsonl"):
+        for line in path.read_text(encoding="utf-8").splitlines():
+            if line.strip():
+                record = json.loads(line)
+                if record.get("status") == 0:
+                    ids.add(str(record["load_id"]))
+    return ids
+
+
+def _landed_state(lake_root):
+    """The dedupe set, the lateness watermark and the next arrival_seq, from the committed rows.
+
+    Files of uncommitted loads (a kill during a write) are removed here, so no later read sees them.
+    """
+    table_dir = lake_root / STREAM_TABLE
+    committed = _committed_load_ids(lake_root)
+    files = sorted(table_dir.glob("*.parquet")) if table_dir.is_dir() else []
+    kept = [p for p in files if p.name.rsplit(".", 2)[0] in committed]
+    for path in files:
+        if path not in kept:
+            path.unlink()
+    if not kept:
+        return set(), None, 0
+    connection = duckdb.connect()
+    try:
+        rows = connection.execute(
+            "SELECT meta_id, event_epoch, arrival_seq FROM read_parquet(?)",
+            [[str(p) for p in kept]],
+        ).fetchall()
+    finally:
+        connection.close()
+    if not rows:
+        return set(), None, 0
+    seen = {meta_id for meta_id, _, _ in rows}
+    watermark = max(epoch for _, epoch, _ in rows)
+    next_seq = max(seq for _, _, seq in rows) + 1
+    return seen, watermark, next_seq
+
+
+def _row(data, meta_id, epoch, sse_id, arrival_seq, watermark_before, late):
+    length = data.get("length") or {}
+    revision = data.get("revision") or {}
+    start = window_start_of(epoch)
+    return {
+        "meta_id": meta_id,
+        "event_id": data.get("id"),
+        "event_time": data["meta"]["dt"],
+        "event_epoch": epoch,
+        "type": data.get("type"),
+        "namespace": data.get("namespace"),
+        "title": data.get("title"),
+        "comment": data.get("comment"),
+        "timestamp": data.get("timestamp"),
+        "user_name": data.get("user"),
+        "bot": data.get("bot"),
+        "wiki": data.get("wiki"),
+        "server_name": data.get("server_name"),
+        "length_old": length.get("old"),
+        "length_new": length.get("new"),
+        "revision_old": revision.get("old"),
+        "revision_new": revision.get("new"),
+        "sse_id": sse_id,
+        "arrival_seq": arrival_seq,
+        "window_start": start,
+        "window_end": start + WINDOW_SECONDS,
+        "watermark_before": watermark_before,
+        "is_late": late,
+    }
+
+
+class _Run:
+    """The state of one consumer process: the open micro-batch and the dedupe set."""
+
+    def __init__(self, *, pipeline, lake_root, clock, flush_events, flush_seconds,
+                 seen, watermark, next_seq, run_started_at):
+        self.pipeline = pipeline
+        self.lake_root = lake_root
+        self.clock = clock
+        self.flush_events = flush_events
+        self.flush_seconds = flush_seconds
+        self.seen = seen
+        self.watermark = watermark
+        self.next_seq = next_seq
+        self.run_started_at = run_started_at
+        self.batch = []
+        self.new_events = 0
+        self.landed = 0
+        self.last_flush = clock()
+
+    def take(self, sse_event):
+        """Consume one SSE event. A meta_id already in the set is dropped: no seq, no watermark change."""
+        try:
+            data = json.loads(sse_event.data)
+            meta_id = data["meta"]["id"]
+            epoch = event_time_of(data["meta"]["dt"])
+        except (ValueError, KeyError, TypeError):
+            return False
+        if meta_id in self.seen:
+            return False
+        late = is_late(self.watermark, epoch)
+        self.batch.append(_row(data, meta_id, epoch, sse_event.id, self.next_seq, self.watermark, late))
+        self.seen.add(meta_id)
+        self.next_seq += 1
+        self.watermark = epoch if self.watermark is None else max(self.watermark, epoch)
+        self.new_events += 1
+        return True
+
+    def maybe_flush(self, last_id):
+        if not self.batch:
+            return
+        full = len(self.batch) >= self.flush_events
+        timed = self.flush_seconds is not None and self.clock() - self.last_flush >= self.flush_seconds
+        if full or timed:
+            self.flush(last_id)
+
+    def flush(self, last_id):
+        """Write the batch as one dlt load, then the cursor (temp name, then rename)."""
+        if not self.batch:
+            return
+        land_rows(self.pipeline, self.batch)
+        self.landed += len(self.batch)
+        self.batch = []
+        self.last_flush = self.clock()
+        _write_cursor(self.lake_root, {"run_started_at": self.run_started_at, "last_landed_sse_id": last_id})
+
+
+def consume(*, url=DEFAULT_URL, lake_root, duration=DEFAULT_DURATION, clock=time.time, sleep=time.sleep,
+            open_stream=open_sse, flush_events=FLUSH_EVENTS, flush_seconds=FLUSH_SECONDS,
+            should_stop=lambda: False, on_line=None):
+    """Consume the stream until a graceful end. Returns the exit summary (reason, attempts, failures)."""
+    lake_root = Path(lake_root)
+    pipeline = make_pipeline(lake_root, "stream")
+    # dlt creates the lake root itself, so it must be initialized before the cursor file is written.
+    with pipeline.destination_client() as client:
+        client.initialize_storage()
+    # Packages left pending by a kill are re-consumed from the replay, so dlt must not load them again.
+    pipeline.abort_packages()
+
+    cursor = _read_cursor(lake_root)
+    if "run_started_at" not in cursor:
+        cursor = {"run_started_at": clock(), "last_landed_sse_id": None}
+        _write_cursor(lake_root, cursor)
+    deadline = cursor["run_started_at"] + duration
+
+    seen, watermark, next_seq = _landed_state(lake_root)
+    run = _Run(pipeline=pipeline, lake_root=lake_root, clock=clock, flush_events=flush_events,
+               flush_seconds=flush_seconds, seen=seen, watermark=watermark, next_seq=next_seq,
+               run_started_at=cursor["run_started_at"])
+
+    last_id = cursor.get("last_landed_sse_id")
+    attempts = 0
+    failed = 0
+    reason = None
+    while reason is None:
+        if should_stop():
+            reason = INTERRUPTED
+            break
+        if clock() >= deadline:
+            reason = TIME_UP
+            break
+        attempts += 1
+        before = run.new_events
+        retry = None
+        try:
+            response = open_stream(url, last_id)
+        except OSError:
+            response = None
+        if response is not None and response.status == 204:
+            response.close()
+            reason = END_OF_STREAM
+            break
+        if response is not None and response.status == 200:
+            parser = SSEParser()
+            try:
+                for line in response.lines():
+                    if on_line is not None:
+                        on_line(line)
+                    event = parser.feed(line)
+                    if event is None:
+                        continue
+                    if should_stop():
+                        reason = INTERRUPTED
+                        break
+                    if clock() >= deadline:
+                        reason = TIME_UP
+                        break
+                    last_id = event.id or last_id
+                    run.take(event)
+                    run.maybe_flush(last_id)
+            except OSError:
+                pass
+            retry = parser.retry
+        if response is not None:
+            response.close()
+        failed = 0 if run.new_events > before else failed + 1
+        if reason is not None:
+            break
+        sleep(retry if retry else RECONNECT_SECONDS)
+
+    run.flush(last_id)
+    return {"reason": reason, "attempts": attempts, "failed_attempts": failed, "landed": run.landed}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Consume the Wikimedia recentchange stream into the lake.")
+    parser.add_argument("--url", default=DEFAULT_URL)
+    parser.add_argument("--duration", type=float, default=DEFAULT_DURATION, help="seconds")
+    parser.add_argument("--lake-root", default="lake")
+    parser.add_argument("--flush-events", type=int, default=FLUSH_EVENTS)
+    args = parser.parse_args(argv)
+
+    interrupted = {"flag": False}
+    signal.signal(signal.SIGINT, lambda signum, frame: interrupted.update(flag=True))
+    summary = consume(url=args.url, lake_root=args.lake_root, duration=args.duration,
+                      flush_events=args.flush_events, should_stop=lambda: interrupted["flag"])
+    print(json.dumps(summary, sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
+    main()
