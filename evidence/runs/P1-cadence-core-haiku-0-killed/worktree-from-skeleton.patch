+import unittest
+
+import duckdb
+
+from tests.support import WAREHOUSE, dbt, lake_glob
+
+
+def setUpModule():
+    dbt("run", "staging", "dim*")
+
+
+class AwardKeyTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.db = duckdb.connect(str(WAREHOUSE), read_only=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.db.close()
+
+    def test_award_key_not_null_on_all_rows(self):
+        total, nulls = self.db.sql("""
+            SELECT count(*), count_if(award_key IS NULL OR award_key = '')
+            FROM (SELECT award_key FROM stg_usaspending_contracts
+                  UNION ALL SELECT award_key FROM stg_usaspending_assistance)
+        """).fetchone()
+        self.assertEqual(total, 9820)
+        self.assertEqual(nulls, 0)
+
+    def test_planned_key_groups_map_to_one_award_key(self):
+        contract_groups = self.db.sql(f"""
+            SELECT raw.awarding_agency_code, raw.award_id_piid
+            FROM read_parquet('{lake_glob("usaspending_contracts")}') AS raw
+            JOIN stg_usaspending_contracts AS stg
+              ON stg.transaction_key = raw.contract_transaction_unique_key
+            WHERE trim(raw.award_id_piid) <> ''
+            GROUP BY ALL HAVING count(DISTINCT stg.award_key) > 1
+        """).fetchall()
+        assistance_groups = self.db.sql(f"""
+            SELECT raw.awarding_agency_code, raw.award_id_fain, raw.award_id_uri
+            FROM read_parquet('{lake_glob("usaspending_assistance")}') AS raw
+            JOIN stg_usaspending_assistance AS stg
+              ON stg.transaction_key = raw.assistance_transaction_unique_key
+            WHERE trim(raw.award_id_fain) <> '' AND trim(raw.award_id_uri) <> ''
+            GROUP BY ALL HAVING count(DISTINCT stg.award_key) > 1
+        """).fetchall()
+        self.assertEqual(contract_groups, [])
+        self.assertEqual(assistance_groups, [])
+
+    def test_aggregate_keys_counted_once(self):
+        blank_fain_keys, blank_fain_rows = self.db.sql(f"""
+            SELECT count(DISTINCT raw.assistance_award_unique_key), count(*)
+            FROM read_parquet('{lake_glob("usaspending_assistance")}') AS raw
+            WHERE trim(raw.award_id_fain) = ''
+        """).fetchone()
+        self.assertEqual((blank_fain_rows, blank_fain_keys), (68, 65))
+
+        staged_aggregate_keys = self.db.sql("""
+            SELECT count(DISTINCT award_key) FROM stg_usaspending_assistance
+            WHERE award_key LIKE 'ASST_AGG_%'
+        """).fetchone()[0]
+        self.assertEqual(staged_aggregate_keys, 65)
+
+        distinct_keys = self.db.sql("""
+            SELECT count(DISTINCT award_key) FROM (
+                SELECT award_key FROM stg_usaspending_contracts
+                UNION ALL SELECT award_key FROM stg_usaspending_assistance)
+        """).fetchone()[0]
+        self.assertEqual(distinct_keys, 7918)
+
+
+if __name__ == "__main__":
+    unittest.main()
