index 0000000..6e12f56
--- /dev/null
+++ b/tests/stream_kill_driver.py
@@ -0,0 +1,31 @@
+"""Test driver: runs the consumer and kills it with SIGKILL during the write of its second batch.
+
+The write leaves a partial file in stream_edit_raw, under a load id that is never committed.
+Usage: python tests/stream_kill_driver.py <url> <lake-root> <duration> <flush-events>
+"""
+
+import os
+import signal
+import sys
+from pathlib import Path
+
+from pipeline.stream import consume as consume_module
+
+PARTIAL_NAME = "9999999999.1.parquet"
+
+
+def land_then_die(pipeline, rows, _calls=[0]):
+    _calls[0] += 1
+    if _calls[0] == 2:
+        partial = Path(LAKE_ROOT) / "stream_edit_raw" / PARTIAL_NAME
+        partial.parent.mkdir(parents=True, exist_ok=True)
+        partial.write_bytes(b"PAR1 partial batch")
+        os.kill(os.getpid(), signal.SIGKILL)
+    return ORIGINAL(pipeline, rows)
+
+
+url, LAKE_ROOT, duration, flush_events = sys.argv[1], sys.argv[2], float(sys.argv[3]), int(sys.argv[4])
+ORIGINAL = consume_module.land_rows
+consume_module.land_rows = land_then_die
+consume_module.consume(url=url, lake_root=LAKE_ROOT, duration=duration,
+                       flush_events=flush_events, flush_seconds=None)
diff --git a/tests/stream_support.py b/tests/stream_support.py
new file mode 100644
index 0000000..759f2e9
--- /dev/null
+++ b/tests/stream_support.py
@@ -0,0 +1,209 @@
+"""Fixtures and fakes for the stream tests. No test here needs the live stream; the replay tests say so."""
+
+import http.server
+import json
+import shutil
+import threading
+import time
+from datetime import datetime, timezone
+
+from tests.support import ROOT
+
+FIXTURE = ROOT / "tests" / "fixtures" / "recentchange_slice.jsonl"
+DLT_STATE = ROOT / "out" / "dlt-state"
+TEST_LAKE = ROOT / "out" / "test-lake"
+REPLAY_URL = "http://localhost:8099/v2/stream/recentchange"
+# Measured in Phase 4: the replay delivers its 21,503 events in about 60 s, then sends keepalives and never
+# HTTP 204. A live run therefore ends at DURATION, so DURATION is 1.5 times the replay length (plan C-2).
+REPLAY_LENGTH_SECONDS = 60.0
+LIVE_DURATION = 1.5 * REPLAY_LENGTH_SECONDS
+
+
+def fresh_root(name):
+    """A lake root under out/test-lake/<name>, with its dlt state, emptied. <name> is snake_case."""
+    shutil.rmtree(TEST_LAKE / name, ignore_errors=True)
+    shutil.rmtree(DLT_STATE / name, ignore_errors=True)
+    return TEST_LAKE / name
+
+
+def cleanup_root(root):
+    shutil.rmtree(root, ignore_errors=True)
+    shutil.rmtree(DLT_STATE / root.name, ignore_errors=True)
+
+
+def fixture_events():
+    """The 600-event slice of the replay, as {"id": SSE id, "data": JSON text}."""
+    return [json.loads(line) for line in FIXTURE.read_text(encoding="utf-8").splitlines()]
+
+
+def make_event(n, epoch, *, type="edit", meta_prefix="m"):
+    """A replay-shaped event with a meta.id and meta.dt at the given epoch seconds."""
+    dt = datetime.fromtimestamp(epoch, timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
+    data = {
+        "meta": {"id": f"{meta_prefix}-{n:06d}", "dt": dt},
+        "id": n,
+        "type": type,
+        "namespace": 0,
+        "title": f"Page {n}",
+        "timestamp": int(epoch),
+        "user": f"user{n}",
+        "bot": n % 3 == 0,
+        "wiki": "enwiki",
+        "server_name": "en.wikipedia.org",
+        "length": {"old": n, "new": n + 1},
+        "revision": {"old": n, "new": n + 1},
+    }
+    return {"id": f"[{n}]", "data": json.dumps(data)}
+
+
+def make_events(count, *, start=1_800_000_000.0, step=1.0, first=1, meta_prefix="m"):
+    return [make_event(first + i, start + i * step, meta_prefix=meta_prefix) for i in range(count)]
+
+
+def sse_lines(events):
+    lines = [":ok", ""]
+    for event in events:
+        lines += [f"id: {event['id']}", "event: message", f"data: {event['data']}", ""]
+    return lines
+
+
+class Clock:
+    def __init__(self, start=1000.0):
+        self.now = start
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+class Sleeps:
+    """Injected sleep: records each wait and moves the fake clock forward by it."""
+
+    def __init__(self, clock):
+        self.clock = clock
+        self.waits = []
+
+    def __call__(self, seconds):
+        self.waits.append(seconds)
+        self.clock.advance(seconds)
+
+
+class FakeResponse:
+    def __init__(self, status, events=(), error=None):
+        self.status = status
+        self._events = list(events)
+        self._error = error
+
+    def lines(self):
+        yield from sse_lines(self._events)
+        if self._error is not None:
+            raise self._error
+
+    def close(self):
+        pass
+
+
+class ScriptedReplay:
+    """Fake connections for the consumer's open_stream.
+
+    Each connection takes the next plan item:
+      ("send", count, end)  send count events (None: every event after the start), then end is
+                            "close" (clean) or "error" (a connection reset);
+      ("refuse",)           the connection is refused;
+      ("status", code)      an HTTP status other than 200 or 204;
+      ("end",)              HTTP 204, the upstream end signal.
+    The start is the event after Last-Event-ID when honors is True, else the first event.
+    After the plan, every connection uses the default item.
+    """
+
+    def __init__(self, events, plan=(), honors=False, default=("send", None, "close")):
+        self.events = events
+        self.plan = list(plan)
+        self.honors = honors
+        self.default = default
+        self.last_event_ids = []
+        self._position = {event["id"]: i for i, event in enumerate(events)}
+
+    def __call__(self, url, last_event_id):
+        self.last_event_ids.append(last_event_id)
+        item = self.plan.pop(0) if self.plan else self.default
+        if item[0] == "refuse":
+            raise ConnectionRefusedError("refused")
+        if item[0] == "status":
+            return FakeResponse(item[1])
+        if item[0] == "end":
+            return FakeResponse(204)
+        _, count, end = item
+        start = 0
+        if self.honors and last_event_id in self._position:
+            start = self._position[last_event_id] + 1
+        stop = len(self.events) if count is None else min(len(self.events), start + count)
+        error = ConnectionResetError("reset") if end == "error" else None
+        return FakeResponse(200, self.events[start:stop], error=error)
+
+
+class ReplayServer:
+    """A local SSE server over the fixture. It honors Last-Event-ID when honors is True and then
+    answers 204 once nothing follows the header. When honors is False it ignores the header and
+    never sends 204, like the replay on localhost:8099."""
+
+    def __init__(self, events, *, honors=True, pace=0.0):
+        self.events = events
+        self.honors = honors
+        self.pace = pace
+        self._position = {event["id"]: i for i, event in enumerate(events)}
+        server = self
+
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def log_message(self, *args):
+                pass
+
+            def do_GET(self):
+                start = 0
+                last = self.headers.get("Last-Event-ID")
+                if server.honors and last in server._position:
+                    start = server._position[last] + 1
+                if server.honors and start >= len(server.events):
+                    self.send_response(204)
+                    self.send_header("Connection", "close")
+                    self.end_headers()
+                    return
+                self.send_response(200)
+                self.send_header("Content-Type", "text/event-stream")
+                self.send_header("Cache-Control", "no-cache")
+                self.send_header("Connection", "close")
+                self.end_headers()
+                self.wfile.write(b":ok\n\n")
+                for event in server.events[start:]:
+                    frame = f"id: {event['id']}\nevent: message\ndata: {event['data']}\n\n"
+                    self.wfile.write(frame.encode("utf-8"))
+                    self.wfile.flush()
+                    if server.pace:
+                        time.sleep(server.pace)
+
+        self._httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.url = f"http://127.0.0.1:{self._httpd.server_address[1]}/v2/stream/recentchange"
+        self._thread = threading.Thread(target=self._httpd.serve_forever, daemon=True)
+
+    def __enter__(self):
+        self._thread.start()
+        return self
+
+    def __exit__(self, *exc):
+        self._httpd.shutdown()
+        self._httpd.server_close()
+
+
+def landed_rows(root):
+    """Every row of stream_edit_raw under root, as dicts."""
+    import duckdb
+
+    relation = duckdb.sql(f"SELECT * FROM read_parquet('{root / 'stream_edit_raw' / '*.parquet'}')")
+    names = relation.columns
+    return [dict(zip(names, row)) for row in relation.fetchall()]
+
+
+def landed_is_late(rows):
+    return {row["meta_id"]: row["is_late"] for row in rows}
