diff --git a/transform/models/marts/mart_obligations_monthly.sql b/transform/models/marts/mart_obligations_monthly.sql
new file mode 100644
index 0000000..56eddb5
--- /dev/null
+++ b/transform/models/marts/mart_obligations_monthly.sql
@@ -0,0 +1,60 @@
+{{ config(materialized='table') }}
+
+-- Population: the July 1, 2024 estimate, else the latest earlier estimate (Amendment A; decision
+-- cd-1-population-fallback). population_year says which file was used.
+with population as (
+    select county_fips, population_year, population
+    from (
+        select county_fips, population_year, population,
+               row_number() over (partition by county_fips order by population_year desc) as rn
+        from {{ ref('stg_census_county') }}
+    )
+    where rn = 1
+),
+
+grouped as (
+    select
+        cast(date_trunc('month', f.date_key) as date) as month,
+        pl.state_code,
+        pl.county_fips,
+        pl.county_name,
+        ag.agency_name,
+        cast(sum(f.federal_action_obligation) as decimal(18, 2)) as net_obligations
+    from {{ ref('fct_award_transaction') }} as f
+    join {{ ref('dim_place') }} as pl on pl.place_key = f.place_key
+    join {{ ref('dim_agency') }} as ag on ag.agency_key = f.agency_key
+    group by all
+),
+
+with_population as (
+    select
+        g.*,
+        p.population_year,
+        p.population,
+        -- Exact cents. DECIMAL / BIGINT would be DOUBLE in DuckDB, so the rounding is integer math.
+        cast(g.net_obligations * 100 as hugeint) as net_cents
+    from grouped as g
+    left join population as p on p.county_fips = g.county_fips
+)
+
+select
+    month,
+    state_code,
+    county_fips,
+    county_name,
+    agency_name,
+    net_obligations,
+    cast(population_year as integer) as population_year,
+    cast(population as bigint) as population,
+    cast(
+        case
+            when population is null then null
+            -- net / population at 4 places, ROUND_HALF_UP: round(C * 100 / P) in units of 0.0001.
+            else cast(
+                     sign(net_cents) * ((abs(net_cents * 100) * 2 + population) // (2 * population))
+                     as decimal(38, 0)
+                 ) * cast(0.0001 as decimal(18, 4))
+        end
+        as decimal(18, 4)
+    ) as obligations_per_person
+from with_population
