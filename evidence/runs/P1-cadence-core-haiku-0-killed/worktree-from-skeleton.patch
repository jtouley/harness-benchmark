+)
+
+LATE_SEQUENCE_EPOCHS = [901, 0]    # the event at 0 is in window [0, 300); the watermark is 901 (> 300 + 600)
+ON_TIME_SEQUENCE_EPOCHS = [900, 0]  # exactly 10 minutes after the window end: not late
+
+
+def _events_at(epochs, first=1):
+    return [make_event(first + i, epoch) for i, epoch in enumerate(epochs)]
+
+
+def _run(root, events, **kwargs):
+    clock = kwargs.pop("clock", Clock())
+    return consume(url="replay://fixture", lake_root=root, duration=1000.0, clock=clock,
+                   sleep=Sleeps(clock), open_stream=ScriptedReplay(
+                       events, plan=[("send", None, "close"), ("end",)]), **kwargs)
+
+
+class LatenessRuleTest(unittest.TestCase):
+    def test_late_rule_fixed_sequence(self):
+        self.assertEqual(window_start_of(0), 0)
+        self.assertEqual(window_start_of(901), 900)
+        self.assertFalse(is_late(None, 0))
+        self.assertTrue(is_late(901, 0))       # window end 300 + 600 < 901
+        self.assertFalse(is_late(900, 0))      # exactly 600 s past the window end: not late
+
+        late_root = fresh_root("stream_lateness_late")
+        _run(late_root, _events_at(LATE_SEQUENCE_EPOCHS))
+        late = landed_is_late(landed_rows(late_root))
+        self.assertEqual(late, {"m-000001": False, "m-000002": True})
+        cleanup_root(late_root)
+
+        on_time_root = fresh_root("stream_lateness_on_time")
+        _run(on_time_root, _events_at(ON_TIME_SEQUENCE_EPOCHS))
+        on_time = landed_is_late(landed_rows(on_time_root))
+        self.assertEqual(on_time, {"m-000001": False, "m-000002": False})
+        cleanup_root(on_time_root)
+
+
+class WallClockGapTest(unittest.TestCase):
+    def test_late_count_ignores_wall_clock_gaps(self):
+        epochs = [0, 1000, 500, 2000, 100, 3000, 2500, 50]
+        events = _events_at(epochs)
+        results = {}
+        for gap in (0.0, 5.0):
+            root = fresh_root(f"stream_lateness_gap_{int(gap)}")
+            clock = Clock(1000.0)
+
+            def advance(line, clock=clock, gap=gap):
+                if line.startswith("data:"):
+                    clock.advance(gap)
+
+            _run(root, events, clock=clock, on_line=advance)
+            results[gap] = landed_is_late(landed_rows(root))
+            cleanup_root(root)
+        self.assertEqual(results[0.0], results[5.0])
+        self.assertGreater(sum(results[0.0].values()), 0)
+
+
+class FlushCadenceIntegrationTest(unittest.TestCase):
+    def test_is_late_set_independent_of_flush_cadence(self):
+        results = {}
+        for flush_events in (500, 50):
+            root = fresh_root(f"is_late_cadence_{flush_events}")
+            summary = consume(url=REPLAY_URL, lake_root=root, duration=LIVE_DURATION,
+                              flush_events=flush_events, flush_seconds=None)
+            results[flush_events] = (summary, landed_is_late(landed_rows(root)))
+            cleanup_root(root)
+        (summary_a, late_a), (summary_b, late_b) = results[500], results[50]
+        self.assertEqual(summary_a["reason"], "DURATION expired")
+        self.assertEqual(summary_b["reason"], "DURATION expired")
+        self.assertEqual(late_a, late_b)
+        self.assertEqual(sum(late_a.values()), sum(late_b.values()))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_stream_restart.py b/tests/test_stream_restart.py
new file mode 100644
index 0000000..4aa9b76
--- /dev/null
+++ b/tests/test_stream_restart.py
@@ -0,0 +1,136 @@
+import os
+import signal
+import subprocess
+import sys
+import time
+import unittest
+
+import duckdb
+
+from pipeline.stream.consume import consume
+from pipeline.stream.sse import open_sse
+from tests.stream_support import (
+    LIVE_DURATION,
+    REPLAY_URL,
+    ReplayServer,
+    cleanup_root,
+    fixture_events,
+    fresh_root,
+    landed_is_late,
+    landed_rows,
+    ROOT,
+)
+
+# The live replay has 21,503 events. One third of them is about 7,168 rows.
+LIVE_THIRD_OF_EVENTS = 7000
+
+
+def _ignore_last_event_id(url, last_event_id):
+    """An opener that drops the Last-Event-ID header, so the reconnect resends from the first event."""
+    return open_sse(url, None)
+
+
+def _landed_count(root):
+    files = list((root / "stream_edit_raw").glob("*.parquet"))
+    if not files:
+        return 0
+    try:
+        return duckdb.sql(f"SELECT count(*) FROM read_parquet('{root / 'stream_edit_raw' / '*.parquet'}')"
+                          ).fetchone()[0]
+    except duckdb.Error:
+        return 0
+
+
+def _start_piece(url, root, duration, flush_events):
+    command = [sys.executable, "-m", "pipeline.stream.consume", "--url", url,
+               "--duration", str(duration), "--lake-root", str(root),
+               "--flush-events", str(flush_events)]
+    return subprocess.Popen(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def _kill_when_landed(process, root, at_least, timeout=120.0):
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        if _landed_count(root) >= at_least:
+            process.send_signal(signal.SIGKILL)
+            process.wait()
+            return True
+        if process.poll() is not None:
+            return False
+        time.sleep(0.05)
+    process.kill()
+    raise AssertionError("the first piece did not land enough rows before the timeout")
+
+
+def _assert_same_as_reference(testcase, root, reference_root):
+    rows = landed_rows(root)
+    reference = landed_rows(reference_root)
+    testcase.assertEqual(len(rows), len({r["meta_id"] for r in rows}), "a meta_id landed twice")
+    kinds = lambda rs: [r for r in rs if r["type"] in ("edit", "new")]  # noqa: E731
+    testcase.assertEqual(len(kinds(rows)), len(kinds(reference)))
+    testcase.assertEqual(len(rows), len(reference))
+    testcase.assertEqual(landed_is_late(rows), landed_is_late(reference))
+
+
+class RestartTest(unittest.TestCase):
+    def test_restart_matches_uninterrupted_run(self):
+        events = fixture_events()
+        reference_root = fresh_root("restart_reference_honoring")
+        with ReplayServer(events, honors=True) as server:
+            reference = consume(url=server.url, lake_root=reference_root, duration=60.0,
+                                flush_events=100, flush_seconds=None)
+            self.assertEqual(reference["reason"], "upstream end signal")
+
+            root = fresh_root("restart_killed_honoring")
+            process = _start_piece(server.url, root, 60.0, 100)
+            self.assertTrue(_kill_when_landed(process, root, at_least=200))
+            resumed = consume(url=server.url, lake_root=root, duration=60.0,
+                              flush_events=100, flush_seconds=None)
+        self.assertEqual(resumed["reason"], "upstream end signal")
+        _assert_same_as_reference(self, root, reference_root)
+        cleanup_root(root)
+        cleanup_root(reference_root)
+
+    def test_restart_with_ignored_header_dedupes_landed_rows(self):
+        reference_root = fresh_root("restart_reference_live")
+        reference = consume(url=REPLAY_URL, lake_root=reference_root, duration=LIVE_DURATION,
+                            flush_events=500, flush_seconds=None)
+        self.assertEqual(reference["reason"], "DURATION expired")
+
+        root = fresh_root("restart_killed_live")
+        process = _start_piece(REPLAY_URL, root, LIVE_DURATION, 500)
+        self.assertTrue(_kill_when_landed(process, root, at_least=LIVE_THIRD_OF_EVENTS))
+        resumed = consume(url=REPLAY_URL, lake_root=root, duration=LIVE_DURATION,
+                          flush_events=500, flush_seconds=None, open_stream=_ignore_last_event_id)
+        self.assertEqual(resumed["reason"], "DURATION expired")
+        _assert_same_as_reference(self, root, reference_root)
+        cleanup_root(root)
+        cleanup_root(reference_root)
+
+
+class KillDuringBatchWriteTest(unittest.TestCase):
+    def test_kill_during_batch_write_loses_nothing(self):
+        events = fixture_events()
+        reference_root = fresh_root("restart_reference_kill")
+        root = fresh_root("restart_kill_during_write")
+        partial = root / "stream_edit_raw" / "9999999999.1.parquet"
+        with ReplayServer(events, honors=True) as server:
+            consume(url=server.url, lake_root=reference_root, duration=60.0,
+                    flush_events=100, flush_seconds=None)
+            env = dict(os.environ, PYTHONPATH=str(ROOT))
+            driver = [sys.executable, str(ROOT / "tests" / "stream_kill_driver.py"),
+                      server.url, str(root), "60", "100"]
+            killed = subprocess.run(driver, cwd=ROOT, env=env, capture_output=True)
+            self.assertEqual(killed.returncode, -signal.SIGKILL)
+            self.assertTrue(partial.exists())
+            resumed = consume(url=server.url, lake_root=root, duration=60.0,
+                              flush_events=100, flush_seconds=None)
+        self.assertEqual(resumed["reason"], "upstream end signal")
+        self.assertFalse(partial.exists(), "the partial batch of an uncommitted load was read or kept")
+        _assert_same_as_reference(self, root, reference_root)
+        cleanup_root(root)
+        cleanup_root(reference_root)
+
+
+if __name__ == "__main__":
+    unittest.main()
