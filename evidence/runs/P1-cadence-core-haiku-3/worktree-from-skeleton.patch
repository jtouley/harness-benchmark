+import csv
+import io
+import os
+import tempfile
+import unittest
+import zipfile
+from decimal import Decimal
+
+from pipeline import oracle
+
+
+def award_csv(rows):
+    buffer = io.StringIO()
+    writer = csv.writer(buffer)
+    writer.writerow(["action_date_fiscal_year", "federal_action_obligation", "awarding_agency_code"])
+    writer.writerows(rows)
+    return buffer.getvalue()
+
+
+class HalfUpTest(unittest.TestCase):
+    def test_half_up_4_roundsHalfAwayFromZeroAtFourthPlace(self):
+        self.assertEqual(oracle.half_up_4(Decimal("1.00005"), 1), Decimal("1.0001"))
+
+    def test_half_up_4_nullPopulation_isNone(self):
+        self.assertIsNone(oracle.half_up_4(Decimal("5.00"), None))
+
+
+class PerPersonTest(unittest.TestCase):
+    def test_find_per_person_mismatches_correctRowsPass(self):
+        rows = [
+            {"obligation_total": Decimal("100.00"), "population": 3, "obligation_per_person": Decimal("33.3333")},
+            {"obligation_total": Decimal("1.00"), "population": None, "obligation_per_person": None},
+        ]
+        self.assertEqual(oracle.find_per_person_mismatches(rows), [])
+
+    def test_find_per_person_mismatches_wrongValueReported(self):
+        rows = [
+            {"obligation_total": Decimal("10.00"), "population": 4, "obligation_per_person": Decimal("1.0000")},
+        ]
+        self.assertEqual(len(oracle.find_per_person_mismatches(rows)), 1)
+
+
+class StateCountyTest(unittest.TestCase):
+    def test_find_state_county_mismatches_sumsAgree_noMismatch(self):
+        county = [
+            {"state_fips": "11", "month_start": "2024-09-01", "obligation_total": Decimal("1.00")},
+            {"state_fips": "11", "month_start": "2024-09-01", "obligation_total": Decimal("2.50")},
+        ]
+        state = {("11", "2024-09-01"): Decimal("3.50")}
+        self.assertEqual(oracle.find_state_county_mismatches(state, county), [])
+
+    def test_find_state_county_mismatches_differentTotal_reported(self):
+        county = [{"state_fips": "11", "month_start": "2024-09-01", "obligation_total": Decimal("1.00")}]
+        state = {("11", "2024-09-01"): Decimal("1.01")}
+        self.assertEqual(len(oracle.find_state_county_mismatches(state, county)), 1)
+
+
+class ConservationTest(unittest.TestCase):
+    def test_ids_unique_countEqualsDistinct_true(self):
+        self.assertTrue(oracle.ids_unique(3, 3))
+        self.assertFalse(oracle.ids_unique(3, 2))
+
+    def test_window_conserved_editsPlusLateEqualsStored_true(self):
+        self.assertTrue(oracle.window_conserved(10, 2, 12))
+        self.assertFalse(oracle.window_conserved(10, 2, 13))
+
+    def test_raw_rows_conserved_recordedCountEqualsDistinctKeys_true(self):
+        self.assertTrue(oracle.raw_rows_conserved(9820, 9820))
