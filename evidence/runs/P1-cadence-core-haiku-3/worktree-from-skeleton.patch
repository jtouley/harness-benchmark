diff --git a/transform/models/marts/fct_wiki_edit_5min.sql b/transform/models/marts/fct_wiki_edit_5min.sql
new file mode 100644
index 0000000..01fbc6e
--- /dev/null
+++ b/transform/models/marts/fct_wiki_edit_5min.sql
@@ -0,0 +1,23 @@
+-- Grain: window_start x wiki x namespace x is_bot (window_key is the surrogate key).
+-- Windows are [window_start, window_start + 5 min) in UTC, by event time (meta.dt).
+-- Late events (is_late as stored at arrival) are excluded here; they are in late_events.
+-- Measures: edit_count, net_bytes. missing_length_count counts events whose net_bytes was set to 0.
+-- Published to out/marts (Question B). The dimension it references is dim_wiki.
+{{ config(
+    materialized='external',
+    location='out/marts/fct_wiki_edit_5min.parquet',
+    format='parquet'
+) }}
+
+select
+    strftime(window_start, '%Y%m%dT%H%M%SZ') || '|' || dbname || '|' || cast(namespace as varchar) || '|' || cast(is_bot as varchar) as window_key,
+    window_start,
+    dbname,
+    namespace,
+    is_bot,
+    cast(count(*) as bigint) as edit_count,
+    cast(sum(net_bytes) as bigint) as net_bytes,
+    cast(count(*) filter (where net_bytes_missing) as bigint) as missing_length_count
+from {{ ref('stg_wiki__recentchange') }}
+where not is_late
+group by window_start, dbname, namespace, is_bot
diff --git a/transform/models/marts/late_events.sql b/transform/models/marts/late_events.sql
