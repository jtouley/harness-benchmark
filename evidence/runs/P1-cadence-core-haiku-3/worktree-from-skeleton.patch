+"""Oracle checks from oracle_map.yml.
+
+Checks 1 to 6 read the lake and out/marts after make build. Check 7 (resume_equivalence)
+needs the replay server and runs under the stream step.
+
+    python -m pipeline.oracle run              # checks 1 to 6, writes out/oracle/results.json
+    python -m pipeline.oracle run --check resume_equivalence
+    python -m pipeline.oracle marts-hash       # row hash per mart, for the idempotence check
+"""
+
+import argparse
+import csv
+import hashlib
+import io
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+import zipfile
+from collections import defaultdict
+from decimal import ROUND_HALF_UP, Decimal
+
+import duckdb
+import yaml
+
+from pipeline import batch, stream
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+MAP_PATH = os.path.join(REPO_ROOT, "oracle_map.yml")
+MARTS_DIR = os.path.join(REPO_ROOT, "out", "marts")
+RESULTS_PATH = os.path.join(REPO_ROOT, "out", "oracle", "results.json")
+RESUME_DIR = os.path.join(REPO_ROOT, "out", "oracle", "resume")
+RESUME_EVENTS = 2000
+RESUME_DURATION = 300
+RESUME_KILL_TIMEOUT = 120
+
+
+def half_up_4(total, population):
+    """obligation_total / population, rounded half-up to four places; None without population."""
+    if not population:
+        return None
+    return (Decimal(total) / Decimal(population)).quantize(Decimal("0.0001"), rounding=ROUND_HALF_UP)
+
+
+def find_per_person_mismatches(rows):
+    return [
+        row
+        for row in rows
+        if half_up_4(row["obligation_total"], row["population"]) != row["obligation_per_person"]
+    ]
+
+
+def find_state_county_mismatches(state_totals, county_rows):
+    """State-month keys whose total differs from the sum of their county-month totals."""
+    county_sums: defaultdict[tuple[str | None, str], Decimal] = defaultdict(Decimal)
+    for row in county_rows:
+        county_sums[(row["state_fips"], row["month_start"])] += row["obligation_total"]
+    keys = set(state_totals) | set(county_sums)
+    return [key for key in keys if state_totals.get(key) != county_sums.get(key)]
+
+
+def ids_unique(total_count, distinct_count):
+    return total_count == distinct_count
+
+
+def window_conserved(edit_sum, late_count, distinct_stored):
+    return edit_sum + late_count == distinct_stored
+
+
+def raw_rows_conserved(distinct_keys, recorded_total):
+    return distinct_keys == recorded_total
+
+
+def independent_csv_total(zip_dir):
+    """FY2024 row count and obligation total, read from the zip CSVs with the csv module."""
+    rows = 0
+    total = Decimal(0)
+    for name in sorted(os.listdir(zip_dir)):
+        if not name.endswith(".zip"):
+            continue
+        with zipfile.ZipFile(os.path.join(zip_dir, name)) as archive:
+            for member in archive.namelist():
+                if not member.lower().endswith(".csv"):
+                    continue
+                with archive.open(member) as handle:
+                    reader = csv.DictReader(io.TextIOWrapper(handle, encoding="utf-8-sig", newline=""))
+                    for raw in reader:
+                        if raw["action_date_fiscal_year"] != "2024":
+                            continue
+                        rows += 1
+                        total += Decimal(raw["federal_action_obligation"])
+    return rows, total
+
+
+def resume_result(replay_mode, rows_a, rows_b):
+    """rows: (meta_id, max_event_time_before, is_late) in arrival order."""
+    if replay_mode != "R":
+        return "fail", "no replay"
+    if rows_a == rows_b:
+        return "pass", f"{len(rows_a)} rows equal in arrival order"
+    return "fail", "arrival-ordered rows differ"
+
+
+def _lake_glob(*parts):
+    return os.path.join(batch.LAKE_DIR, *parts, "*.parquet")
+
+
+def _mart(name):
+    return os.path.join(MARTS_DIR, name)
+
+
+def _rows(sql, *paths):
+    """Run a query whose only variables are parquet paths, bound as parameters."""
+    return duckdb.connect().execute(sql, list(paths)).fetchall()
+
+
+def _scalar(sql, *paths):
+    return _rows(sql, *paths)[0][0]
+
+
+def check_raw_row_conservation():
+    distinct = _scalar(
+        "select count(distinct award_row_key) from read_parquet(?) where action_date_fiscal_year = 2024",
+        _lake_glob("raw", "usaspending_awards"),
+    )
+    with open(batch.COUNTS_PATH, encoding="utf-8") as handle:
+        recorded = sum(zip_counts["rows_fy2024"] for zip_counts in json.load(handle)["zips"])
+    return raw_rows_conserved(distinct, recorded), f"distinct={distinct} recorded={recorded}"
+
+
+def check_obligation_total_exact():
+    mart_total = _scalar(
+        "select sum(obligation_total) from read_parquet(?)",
+        _mart("mart_obligations_by_geo_agency_month.parquet"),
+    )
+    csv_rows, csv_total = independent_csv_total(os.path.join(batch.RAW_DIR, "usaspending"))
+    mart_total = Decimal(mart_total or 0).quantize(Decimal("0.01"))
+    csv_total = csv_total.quantize(Decimal("0.01"))
+    return mart_total == csv_total, f"mart={mart_total} csv={csv_total} csv_rows={csv_rows}"
+
+
+def check_state_equals_county():
+    county = _rows(
+        "select state_fips, cast(month_start as varchar), obligation_total from read_parquet(?)",
+        _mart("mart_obligations_by_geo_agency_month.parquet"),
+    )
+    county_rows = [{"state_fips": s, "month_start": m, "obligation_total": Decimal(t)} for s, m, t in county]
+    state = _rows(
+        "select state_fips, cast(month_start as varchar), obligation_total from read_parquet(?)",
+        _mart("mart_obligations_by_state_month.parquet"),
+    )
+    state_totals = {(s, m): Decimal(t) for s, m, t in state}
+    bad = find_state_county_mismatches(state_totals, county_rows)
+    return not bad, f"state-month keys that differ: {len(bad)}"
+
+
+def check_per_person_recompute():
+    rows = _rows(
+        "select obligation_total, population, obligation_per_person from read_parquet(?)",
+        _mart("mart_obligations_by_geo_agency_month.parquet"),
+    )
+    records = [
+        {"obligation_total": Decimal(t), "population": p, "obligation_per_person": None if v is None else Decimal(v)}
+        for t, p, v in rows
+    ]
+    bad = find_per_person_mismatches(records)
+    return not bad, f"rows={len(records)} mismatches={len(bad)}"
+
+
+def check_stream_no_duplicate_ids():
+    total, distinct = _rows(
+        "select count(*), count(distinct meta_id) from read_parquet(?)",
+        _lake_glob("raw", "stream_events"),
+    )[0]
+    return ids_unique(total, distinct), f"rows={total} distinct={distinct}"
+
+
+def check_window_conservation():
+    edit_sum = _scalar(
+        "select coalesce(sum(edit_count), 0) from read_parquet(?)",
+        _mart("fct_wiki_edit_5min.parquet"),
+    )
+    late = _scalar("select count(*) from read_parquet(?)", _mart("late_events.parquet"))
+    distinct = _scalar(
+        "select count(distinct meta_id) from read_parquet(?)",
+        _lake_glob("raw", "stream_events"),
+    )
+    return window_conserved(edit_sum, late, distinct), f"edits={edit_sum} late={late} stored={distinct}"
+
+
+def _arrival_rows(lake_dir):
+    rows = sorted(stream.Store(lake_dir).all_rows(), key=lambda row: row["arrival_seq"])
+    return [(row["meta_id"], row["max_event_time_before"], row["is_late"]) for row in rows]
+
+
+def _store_parts(lake_dir):
+    folder = os.path.join(lake_dir, "raw", "stream_events")
+    return len([name for name in os.listdir(folder) if name.endswith(".parquet")]) if os.path.isdir(folder) else 0
+
+
+def check_resume_equivalence(replay_mode, url=stream.DEFAULT_URL):
+    if replay_mode != "R":
+        return resume_result(replay_mode, [], [])
+    shutil.rmtree(RESUME_DIR, ignore_errors=True)
+    lake_a = os.path.join(RESUME_DIR, "a")
+    lake_b = os.path.join(RESUME_DIR, "b")
+    stream.consume(url, lake_a, RESUME_DURATION, max_events=RESUME_EVENTS)
+    args = [
+        sys.executable, "-m", "pipeline.stream",
+        "--duration", str(RESUME_DURATION), "--max-events", str(RESUME_EVENTS),
+        "--url", url, "--lake", lake_b,
+    ]
+    killed = subprocess.Popen(args, cwd=REPO_ROOT)
+    deadline = time.monotonic() + RESUME_KILL_TIMEOUT
+    while _store_parts(lake_b) < 2 and killed.poll() is None and time.monotonic() < deadline:
+        time.sleep(0.2)
+    killed.kill()
+    killed.wait()
+    subprocess.run(args, cwd=REPO_ROOT, check=True, timeout=RESUME_DURATION + RESUME_KILL_TIMEOUT)
+    return resume_result(replay_mode, _arrival_rows(lake_a), _arrival_rows(lake_b))
+
+
+CHECKS = {
+    "raw_row_conservation": lambda ctx: check_raw_row_conservation(),
+    "obligation_total_exact": lambda ctx: check_obligation_total_exact(),
+    "state_equals_county": lambda ctx: check_state_equals_county(),
+    "per_person_recompute": lambda ctx: check_per_person_recompute(),
+    "stream_no_duplicate_ids": lambda ctx: check_stream_no_duplicate_ids(),
+    "window_conservation": lambda ctx: check_window_conservation(),
+    "resume_equivalence": lambda ctx: check_resume_equivalence(ctx["replay_mode"]),
+}
+DEFAULT_CHECKS = [name for name in CHECKS if name != "resume_equivalence"]
+
+
+def load_map():
+    with open(MAP_PATH, encoding="utf-8") as handle:
+        return yaml.safe_load(handle)
+
+
+def run_checks(names):
+    oracle_map = load_map()
+    context = {"replay_mode": oracle_map["replay_mode"]}
+    results = []
+    for name in names:
+        outcome = CHECKS[name](context)
+        if isinstance(outcome[0], str):
+            status, detail = outcome
+        else:
+            status, detail = ("pass" if outcome[0] else "fail"), outcome[1]
+        results.append({"id": name, "status": status, "detail": detail})
+    os.makedirs(os.path.dirname(RESULTS_PATH), exist_ok=True)
+    with open(RESULTS_PATH, "w", encoding="utf-8") as handle:
+        json.dump(results, handle, indent=2)
+    return results
+
+
+def mart_hashes():
+    hashes = {}
+    for name in sorted(os.listdir(MARTS_DIR)):
+        if not name.endswith(".parquet"):
+            continue
+        rows = _rows("select * from read_parquet(?) order by all", _mart(name))
+        digest = hashlib.sha256()
+        for row in rows:
+            digest.update(repr(row).encode("utf-8"))
+        hashes[name] = {"rows": len(rows), "sha256": digest.hexdigest()}
+    return hashes
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = parser.add_subparsers(dest="command", required=True)
+    run = sub.add_parser("run")
+    run.add_argument("--check", action="append", choices=list(CHECKS))
+    sub.add_parser("marts-hash")
+    args = parser.parse_args(argv)
+    if args.command == "marts-hash":
+        print(json.dumps(mart_hashes(), indent=2, sort_keys=True))
+        return 0
+    results = run_checks(args.check or DEFAULT_CHECKS)
+    for result in results:
+        print(f"{result['status'].upper():5} {result['id']}: {result['detail']}")
+    return 0 if all(result["status"] == "pass" for result in results) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
