+where is_late
diff --git a/transform/models/marts/mart_obligations_by_geo_agency_month.sql b/transform/models/marts/mart_obligations_by_geo_agency_month.sql
new file mode 100644
index 0000000..36eeadf
--- /dev/null
+++ b/transform/models/marts/mart_obligations_by_geo_agency_month.sql
@@ -0,0 +1,31 @@
+-- Question A. Grain: county_key x agency_code x month_start. Key: obligation_key.
+-- obligation_per_person = obligation_total / population (July 1, 2024), DECIMAL(18,4), half-up.
+-- Null population (not in the Census file, or unallocated) gives a null per-person value.
+{{ config(
+    materialized='external',
+    location='out/marts/mart_obligations_by_geo_agency_month.parquet',
+    format='parquet'
+) }}
+
+select
+    f.obligation_key,
+    f.county_key,
+    g.state_fips,
+    g.state_name,
+    g.county_name,
+    f.agency_code,
+    a.agency_name,
+    f.month_start,
+    f.obligation_total,
+    g.population_2024 as population,
+    cast(
+        case
+            when g.population_2024 > 0
+                then round(cast(f.obligation_total as decimal(38, 12)) / g.population_2024, 4)
+        end
+        as decimal(18, 4)
+    ) as obligation_per_person,
+    f.award_count
+from {{ ref('fct_obligation_monthly') }} as f
+inner join {{ ref('dim_geography') }} as g on g.county_key = f.county_key
+inner join {{ ref('dim_agency') }} as a on a.agency_code = f.agency_code
diff --git a/transform/models/marts/mart_obligations_by_state_month.sql b/transform/models/marts/mart_obligations_by_state_month.sql
new file mode 100644
index 0000000..b8f5ffb
--- /dev/null
+++ b/transform/models/marts/mart_obligations_by_state_month.sql
@@ -0,0 +1,46 @@
+-- State rollup of mart_obligations_by_geo_agency_month. Grain: state_fips x month_start.
+-- Key: state_month_key. State totals are the sum of the county totals (oracle check 3).
+-- state population is the sum of Census county populations in the state.
+{{ config(
+    materialized='external',
+    location='out/marts/mart_obligations_by_state_month.parquet',
+    format='parquet'
+) }}
+
+with county_month as (
+    select
+        state_fips,
+        month_start,
+        sum(obligation_total) as obligation_total,
+        cast(sum(award_count) as bigint) as award_count
+    from {{ ref('mart_obligations_by_geo_agency_month') }}
+    group by state_fips, month_start
+),
+
+state_population as (
+    select
+        state_fips,
+        max(state_name) as state_name,
+        cast(sum(population_2024) as bigint) as population
+    from {{ ref('dim_geography') }}
+    where population_2024 is not null
+    group by state_fips
+)
+
+select
+    coalesce(c.state_fips, '') || '|' || cast(c.month_start as varchar) as state_month_key,
+    c.state_fips,
+    coalesce(p.state_name, '') as state_name,
+    c.month_start,
+    cast(c.obligation_total as decimal(18, 2)) as obligation_total,
+    p.population,
+    cast(
+        case
+            when p.population > 0
+                then round(cast(c.obligation_total as decimal(38, 12)) / p.population, 4)
+        end
+        as decimal(18, 4)
+    ) as obligation_per_person,
+    c.award_count
+from county_month as c
+left join state_population as p on p.state_fips = c.state_fips
