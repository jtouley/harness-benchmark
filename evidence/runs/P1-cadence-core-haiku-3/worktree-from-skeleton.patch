@@ -0,0 +1,180 @@
+"""Batch sources: sitematrix, Census county population, USAspending FY2024 awards.
+
+Each source is a dlt resource. Pure row functions do the parsing so the tests run
+without dlt or the network. `main()` loads the resources into Parquet under lake/raw/.
+"""
+
+import csv
+import io
+import json
+import os
+import re
+import zipfile
+
+import dlt
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+RAW_DIR = os.path.join(REPO_ROOT, "data", "raw")
+LAKE_DIR = os.path.join(REPO_ROOT, "lake")
+COUNTS_PATH = os.path.join(LAKE_DIR, "logs", "batch_counts.json")
+
+FISCAL_YEAR = "2024"
+COUNTY_SUMLEV = "050"
+ZIP_NAME = re.compile(r"^FY2024_(?P<agency>\d+)_(?P<kind>Assistance|Contracts)_")
+AWARD_TYPES = {"Assistance": "assistance", "Contracts": "contract"}
+
+
+def flatten_sitematrix(doc):
+    """One row per site, from the numbered language entries and the specials list."""
+    rows = []
+    matrix = doc["sitematrix"]
+    for key, entry in matrix.items():
+        if not key.isdigit():
+            continue
+        for site in entry.get("site", []):
+            rows.append(
+                {
+                    "dbname": site["dbname"],
+                    "code": site["code"],
+                    "url": site["url"],
+                    "language_code": entry["code"],
+                    "closed": bool(site.get("closed", False)),
+                }
+            )
+    for special in matrix.get("specials", []):
+        rows.append(
+            {
+                "dbname": special["dbname"],
+                "code": special["code"],
+                "url": special["url"],
+                "language_code": special.get("lang"),
+                "closed": bool(special.get("closed", False)),
+            }
+        )
+    return rows
+
+
+def census_county_rows(lines):
+    """County rows (SUMLEV 050) with the July 1, 2024 estimate as an integer."""
+    rows = []
+    for raw in csv.DictReader(lines):
+        if raw["SUMLEV"] != COUNTY_SUMLEV:
+            continue
+        rows.append(
+            {
+                "state": raw["STATE"],
+                "county": raw["COUNTY"],
+                "stname": raw["STNAME"],
+                "ctyname": raw["CTYNAME"],
+                "popestimate2024": int(raw["POPESTIMATE2024"]),
+            }
+        )
+    return rows
+
+
+def _award_row(raw, source_file, source_row, agency, award_type):
+    return {
+        "source_file": source_file,
+        "source_row": source_row,
+        "award_row_key": f"{source_file}#{source_row}",
+        "award_type": award_type,
+        "toptier_agency_code": agency,
+        "action_date": raw["action_date"],
+        "action_date_fiscal_year": int(raw["action_date_fiscal_year"]),
+        "federal_action_obligation": raw["federal_action_obligation"],
+        "place_state_fips": raw["prime_award_transaction_place_of_performance_state_fips_code"],
+        "place_county_fips": raw["prime_award_transaction_place_of_performance_county_fips_code"],
+        "place_state_name": raw["primary_place_of_performance_state_name"],
+        "place_county_name": raw["primary_place_of_performance_county_name"],
+        "awarding_agency_code": raw["awarding_agency_code"],
+        "awarding_agency_name": raw["awarding_agency_name"],
+    }
+
+
+def usaspending_zip_rows(zip_path):
+    """Rows of FY2024 from every CSV member of one zip, with counts per member.
+
+    source_row is 1-based and counted before the fiscal-year filter, so it does not
+    change when the filter changes. award_row_key is unique per member.
+    """
+    zip_name = os.path.basename(zip_path)
+    match = ZIP_NAME.match(zip_name)
+    if not match:
+        raise ValueError(f"unexpected USAspending zip name: {zip_name}")
+    agency = match.group("agency")
+    award_type = AWARD_TYPES[match.group("kind")]
+
+    counts = {"zip": zip_name, "rows_before_filter": 0, "rows_fy2024": 0}
+    rows = []
+    with zipfile.ZipFile(zip_path) as archive:
+        for member in archive.namelist():
+            if not member.lower().endswith(".csv"):
+                continue
+            source_file = f"{zip_name}/{member}"
+            with archive.open(member) as handle:
+                text = io.TextIOWrapper(handle, encoding="utf-8-sig", newline="")
+                for source_row, raw in enumerate(csv.DictReader(text), start=1):
+                    counts["rows_before_filter"] += 1
+                    if raw["action_date_fiscal_year"] != FISCAL_YEAR:
+                        continue
+                    counts["rows_fy2024"] += 1
+                    rows.append(_award_row(raw, source_file, source_row, agency, award_type))
+    return counts, rows
+
+
+def _write_counts(counts):
+    os.makedirs(os.path.dirname(COUNTS_PATH), exist_ok=True)
+    tmp = COUNTS_PATH + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as handle:
+        json.dump(counts, handle, indent=2, sort_keys=True)
+    os.replace(tmp, COUNTS_PATH)
+
+
+@dlt.resource(name="sitematrix", write_disposition="replace")
+def sitematrix():
+    with open(os.path.join(RAW_DIR, "sitematrix.json"), encoding="utf-8") as handle:
+        yield from flatten_sitematrix(json.load(handle))
+
+
+@dlt.resource(name="census_county", write_disposition="replace")
+def census_county():
+    path = os.path.join(RAW_DIR, "census", "co-est2024-alldata.csv")
+    with open(path, encoding="latin-1", newline="") as handle:
+        yield from census_county_rows(handle)
+
+
+def usaspending_awards(counts):
+    """Build the resource; per-zip counts are appended to `counts` while it runs."""
+
+    @dlt.resource(name="usaspending_awards", write_disposition="replace")
+    def _awards():
+        usaspending_dir = os.path.join(RAW_DIR, "usaspending")
+        for zip_name in sorted(os.listdir(usaspending_dir)):
+            if not zip_name.endswith(".zip"):
+                continue
+            zip_counts, rows = usaspending_zip_rows(os.path.join(usaspending_dir, zip_name))
+            counts.setdefault("zips", []).append(zip_counts)
+            yield from rows
+
+    return _awards()
+
+
+def main():
+    counts: dict[str, list[dict[str, object]]] = {}
+    pipeline = dlt.pipeline(
+        pipeline_name="batch",
+        pipelines_dir=os.path.join(LAKE_DIR, "state", "dlt"),
+        destination=dlt.destinations.filesystem(bucket_url=LAKE_DIR),
+        dataset_name="raw",
+    )
+    info = pipeline.run(
+        [sitematrix(), census_county(), usaspending_awards(counts)],
+        loader_file_format="parquet",
+        write_disposition="replace",
+    )
+    print(info)
+    _write_counts(counts)
+
+
+if __name__ == "__main__":
+    main()
