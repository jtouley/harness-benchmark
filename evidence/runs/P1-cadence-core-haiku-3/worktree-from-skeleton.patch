+import http.server
+import json
+import os
+import tempfile
+import threading
+import unittest
+from datetime import datetime, timedelta, timezone
+from unittest import mock
+
+from pipeline import stream
+
+UTC = timezone.utc
+
+
+def event_json(meta_id, dt, wiki="enwiki", bot=False, namespace=0, old=100, new=120):
+    return json.dumps(
+        {
+            "meta": {"id": meta_id, "dt": dt},
+            "type": "edit",
+            "namespace": namespace,
+            "wiki": wiki,
+            "bot": bot,
+            "length": {"old": old, "new": new},
+        }
+    )
+
+
+def at(minute_offset_seconds):
+    base = datetime(2026, 10, 14, 12, 0, 0, tzinfo=UTC)
+    return (base + timedelta(seconds=minute_offset_seconds)).strftime("%Y-%m-%dT%H:%M:%S.000Z")
+
+
+class Killed(Exception):
+    """Simulates a process kill between two commit steps."""
+
+
+class SSEParserTest(unittest.TestCase):
+    def test_feed_splitChunks_yieldsOneFrame(self):
+        parser = stream.SSEParser()
+        frames = []
+        for chunk in ["id: abc\nda", "ta: {\"x\":1}\n", "\nevent: message\n", "\n"]:
+            frames.extend(parser.feed(chunk))
+        self.assertEqual(len(frames), 1)
+        self.assertEqual(frames[0].id, "abc")
+        self.assertEqual(frames[0].data, '{"x":1}')
+
+    def test_feed_commentLine_isIgnored(self):
+        parser = stream.SSEParser()
+        frames = parser.feed(": ok\n\nid: 7\ndata: {}\n\n")
+        self.assertEqual([f.id for f in frames], ["7"])
+
+    def test_feed_multipleDataLines_joinedWithNewline(self):
+        parser = stream.SSEParser()
+        frames = parser.feed("id: 1\ndata: a\ndata: b\n\n")
+        self.assertEqual(frames[0].data, "a\nb")
+
+
+class LateRuleTest(unittest.TestCase):
+    def setUp(self):
+        self.window_end = datetime(2026, 10, 14, 12, 5, tzinfo=UTC)
+
+    def test_is_late_exactlyTenMinutesAfterWindowEnd_notLate(self):
+        self.assertFalse(stream.is_late(self.window_end, self.window_end + timedelta(minutes=10)))
+
+    def test_is_late_tenMinutesOneSecondAfterWindowEnd_isLate(self):
+        self.assertTrue(
+            stream.is_late(self.window_end, self.window_end + timedelta(minutes=10, seconds=1))
+        )
+
+    def test_is_late_noEventSeenBefore_notLate(self):
+        self.assertFalse(stream.is_late(self.window_end, None))
+
+
+class ParseEventTest(unittest.TestCase):
+    def test_parse_event_normalEdit_returnsEvent(self):
+        frame = stream.Frame("s1", event_json("e1", at(0)))
+        event, kind = stream.parse_event(frame)
+        self.assertEqual(kind, "event")
+        self.assertEqual(event.meta_id, "e1")
+        self.assertEqual(event.fields["wiki"], "enwiki")
+
+    def test_parse_event_canaryDomain_isSkippedAsCanary(self):
+        body = json.dumps({"meta": {"id": "c1", "dt": at(0), "domain": "canary"}})
+        event, kind = stream.parse_event(stream.Frame("s1", body))
+        self.assertIsNone(event)
+        self.assertEqual(kind, "canary")
+
+    def test_parse_event_rawControlCharacterInString_parses(self):
+        body = '{"meta": {"id": "c2", "dt": "%s"}, "comment": "a\tb", "wiki": "enwiki"}' % at(0)
+        event, kind = stream.parse_event(stream.Frame("s2", body))
+        self.assertEqual(kind, "event")
+        self.assertEqual(event.meta_id, "c2")
+
+    def test_parse_event_notJson_isMalformed(self):
+        event, kind = stream.parse_event(stream.Frame("s3", "{not json"))
+        self.assertIsNone(event)
+        self.assertEqual(kind, "malformed")
+
+
+class WindowTest(unittest.TestCase):
+    def test_window_bounds_floorsToFiveMinutesUtc(self):
+        start, end = stream.window_bounds(datetime(2026, 10, 14, 12, 7, 31, 500000, tzinfo=UTC))
+        self.assertEqual(start, datetime(2026, 10, 14, 12, 5, tzinfo=UTC))
+        self.assertEqual(end, datetime(2026, 10, 14, 12, 10, tzinfo=UTC))
+
+
+class ArrivalTest(unittest.TestCase):
+    def test_classify_replayedId_droppedWithoutChangingMax(self):
+        seen = {"a"}
+        events = [stream.StreamEvent(id="1", meta_id="a", dt=stream.parse_dt(at(0)), fields={})]
+        rows, max_seen, next_seq = stream.classify_batch(events, seen, None, 0, arrival=stream.parse_dt(at(5)))
+        self.assertEqual(rows, [])
+        self.assertIsNone(max_seen)
+        self.assertEqual(next_seq, 0)
+
+    def test_classify_withinBatch_keepsFirstOccurrence(self):
+        dt = stream.parse_dt(at(0))
+        events = [
+            stream.StreamEvent(id="1", meta_id="a", dt=dt, fields={}),
+            stream.StreamEvent(id="2", meta_id="a", dt=dt, fields={}),
+        ]
+        rows, _, _ = stream.classify_batch(events, set(), None, 0, arrival=dt)
+        self.assertEqual([r["meta_id"] for r in rows], ["a"])
+
+    def test_classify_maxEventTime_isRunningMaxBeforeEachEvent(self):
+        events = [
+            stream.StreamEvent(id="1", meta_id="a", dt=stream.parse_dt(at(0)), fields={}),
+            stream.StreamEvent(id="2", meta_id="b", dt=stream.parse_dt(at(900)), fields={}),
+            stream.StreamEvent(id="3", meta_id="c", dt=stream.parse_dt(at(60)), fields={}),
+        ]
+        rows, max_seen, _ = stream.classify_batch(events, set(), None, 0, arrival=stream.parse_dt(at(0)))
+        self.assertIsNone(rows[0]["max_event_time_before"])
+        self.assertEqual(rows[1]["max_event_time_before"], stream.parse_dt(at(0)))
+        self.assertEqual(rows[2]["max_event_time_before"], stream.parse_dt(at(900)))
+        self.assertEqual(max_seen, stream.parse_dt(at(900)))
+
+    def test_classify_lateFlag_setFromMaxEventTimeBeforeWindowEnd(self):
+        events = [
+            stream.StreamEvent(id="1", meta_id="a", dt=stream.parse_dt(at(1500)), fields={}),
+            stream.StreamEvent(id="2", meta_id="b", dt=stream.parse_dt(at(200)), fields={}),
+        ]
+        rows, _, _ = stream.classify_batch(events, set(), None, 0, arrival=stream.parse_dt(at(1500)))
+        self.assertFalse(rows[0]["is_late"])
+        self.assertTrue(rows[1]["is_late"])
+
+
+class FakeReplayServer:
+    """Serves a fixed replay over HTTP. Starts on 127.0.0.1 with an ephemeral port.
+
+    honor_last_event_id: True replays from the event with the Last-Event-ID (inclusive,
+    minus `replay_back` events). False resumes from the position where the last
+    connection stopped, after `gap_events` events emitted while nobody was connected.
+    drop_after: list of counts; connection i closes after drop_after[i] events.
+    """
+
+    def __init__(self, events, honor_last_event_id=True, replay_back=0, drop_after=(), gap_events=0):
+        self.events = events
+        self.honor = honor_last_event_id
+        self.replay_back = replay_back
+        self.drop_after = list(drop_after)
+        self.gap_events = gap_events
+        self.position = 0
+        self.connections = 0
+        self.stop = threading.Event()
+        server = self
+
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def log_message(self, *args):
+                pass
+
+            def do_GET(self):
+                server.serve(self)
+
+        self.httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.httpd.daemon_threads = True
+        self.url = f"http://127.0.0.1:{self.httpd.server_address[1]}/v2/stream/recentchange"
+        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+
+    def start(self):
+        self.thread.start()
+        return self
+
+    def close(self):
+        self.stop.set()
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+    def start_index(self, last_event_id):
+        if not last_event_id:
+            return 0
+        if self.honor:
+            ids = [sse_id for sse_id, _ in self.events]
+            index = ids.index(last_event_id)
+            return max(0, index - self.replay_back)
+        return self.position + self.gap_events
+
+    def serve(self, handler):
+        last = handler.headers.get("Last-Event-ID")
+        start = self.start_index(last)
+        limit = self.drop_after[self.connections] if self.connections < len(self.drop_after) else None
+        self.connections += 1
+        handler.send_response(200)
+        handler.send_header("Content-Type", "text/event-stream")
+        handler.end_headers()
+        sent = 0
+        index = start
+        while index < len(self.events):
+            if limit is not None and sent >= limit:
+                break
+            sse_id, data = self.events[index]
+            handler.wfile.write(f"event: message\nid: {sse_id}\ndata: {data}\n\n".encode("utf-8"))
+            handler.wfile.flush()
+            index += 1
+            sent += 1
+            self.position = index
+        if limit is not None and sent >= limit:
+            return
+        while not self.stop.wait(0.05):
+            pass
+
+
+def fixture_events():
+    rows = [
+        ("s1", "e1", at(0)),
+        ("s2", "e2", at(30)),
+        ("s3", "e3", at(60)),
+        ("s4", "e4", at(900)),
+        ("s5", "e5", at(120)),
+        ("s6", "e6", at(1500)),
+        ("s7", "e7", at(200)),
+    ]
+    return [(sse_id, event_json(meta_id, dt)) for sse_id, meta_id, dt in rows]
+
+
+def stored_rows(lake_dir):
+    return stream.Store(lake_dir).all_rows()
+
+
+class ConsumerTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.lake = os.path.join(self.tmp.name, "lake")
+
+    def run_consumer(self, url, duration=2):
+        return stream.consume(url, self.lake, duration=duration, backoff_max=0.2)
+
+    def test_consume_disconnectThenResume_storesEachEventOnce(self):
+        server = FakeReplayServer(fixture_events(), drop_after=[3]).start()
+        self.addCleanup(server.close)
+        self.run_consumer(server.url)
+        ids = sorted(r["meta_id"] for r in stored_rows(self.lake))
+        self.assertEqual(ids, ["e1", "e2", "e3", "e4", "e5", "e6", "e7"])
+
+    def test_consume_serverReplaysLastThree_noDoubleCount(self):
+        server = FakeReplayServer(fixture_events(), replay_back=2, drop_after=[4]).start()
+        self.addCleanup(server.close)
+        self.run_consumer(server.url)
+        ids = [r["meta_id"] for r in stored_rows(self.lake)]
+        self.assertEqual(len(ids), len(set(ids)))
+        self.assertEqual(len(ids), 7)
+
+    def test_no_replay_records_gap(self):
+        server = FakeReplayServer(fixture_events(), honor_last_event_id=False, drop_after=[3], gap_events=2).start()
+        self.addCleanup(server.close)
+        self.run_consumer(server.url)
+        gaps = stream.Store(self.lake).gaps()
+        self.assertTrue(gaps)
+        self.assertIn("cursor", gaps[0])
+        self.assertIn("disconnected_at", gaps[0])
+
+    def test_kill_between_write_and_cursor_no_duplicate(self):
+        server = FakeReplayServer(fixture_events(), drop_after=[]).start()
+        self.addCleanup(server.close)
+        with mock.patch.object(stream.Store, "save_cursor", side_effect=Killed):
+            with self.assertRaises(Killed):
+                self.run_consumer(server.url)
+        self.assertTrue(stored_rows(self.lake))
+        self.run_consumer(server.url)
+        ids = [r["meta_id"] for r in stored_rows(self.lake)]
+        self.assertEqual(len(ids), len(set(ids)))
+        self.assertEqual(len(ids), 7)
+
+    def test_kill_between_write_and_cursor_same_is_late(self):
+        events = fixture_events()
+        run_a_lake = os.path.join(self.tmp.name, "run_a")
+        server_a = FakeReplayServer(events).start()
+        self.addCleanup(server_a.close)
+        stream.consume(server_a.url, run_a_lake, duration=2, backoff_max=0.2)
+        expected = {
+            (r["meta_id"], r["max_event_time_before"], r["is_late"]) for r in stored_rows(run_a_lake)
+        }
+        self.assertTrue(any(late for _, _, late in expected))
+
+        server_b = FakeReplayServer(events).start()
+        self.addCleanup(server_b.close)
+        with mock.patch.object(stream.Store, "save_cursor", side_effect=Killed):
+            with self.assertRaises(Killed):
+                stream.consume(server_b.url, self.lake, duration=2, backoff_max=0.2)
+        stream.consume(server_b.url, self.lake, duration=2, backoff_max=0.2)
+        actual = {(r["meta_id"], r["max_event_time_before"], r["is_late"]) for r in stored_rows(self.lake)}
+        self.assertEqual(actual, expected)
+
+
+class EnsureStoreTest(unittest.TestCase):
+    def test_ensure_events_file_emptyLake_writesZeroRowParquet(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            lake = os.path.join(tmp, "lake")
+            store = stream.Store(lake)
+            store.ensure_events_file()
+            self.assertEqual(store.all_rows(), [])
+            files = os.listdir(store.events_dir)
+            self.assertEqual(len(files), 1)
+            store.ensure_events_file()
+            self.assertEqual(os.listdir(store.events_dir), files)
+
+
+if __name__ == "__main__":
+    unittest.main()
