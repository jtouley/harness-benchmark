@@ -0,0 +1,12 @@
+-- Grain: county_key x agency_code x month_start (obligation_key is the surrogate key).
+-- Measures: obligation_total (DECIMAL(18,2), exact sum), award_count.
+
+select
+    county_key || '|' || agency_code || '|' || cast(cast(date_trunc('month', action_date) as date) as varchar) as obligation_key,
+    county_key,
+    agency_code,
+    cast(date_trunc('month', action_date) as date) as month_start,
+    cast(sum(federal_action_obligation) as decimal(18, 2)) as obligation_total,
+    count(*) as award_count
+from {{ ref('stg_usaspending__awards') }}
+group by county_key, agency_code, cast(date_trunc('month', action_date) as date)
