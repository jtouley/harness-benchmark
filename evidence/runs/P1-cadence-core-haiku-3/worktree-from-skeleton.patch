diff --git a/transform/tests/assert_obligation_has_two_decimals.sql b/transform/tests/assert_obligation_has_two_decimals.sql
new file mode 100644
index 0000000..a93ebd0
--- /dev/null
+++ b/transform/tests/assert_obligation_has_two_decimals.sql
@@ -0,0 +1,9 @@
+-- Fails (returns rows) when a FY2024 obligation value has more than two decimal places.
+-- Such a value would be silently rounded by the DECIMAL(18,2) cast.
+
+select
+    award_row_key,
+    federal_action_obligation
+from {{ source('lake', 'usaspending_awards') }}
+where action_date_fiscal_year = 2024
+  and regexp_matches(federal_action_obligation, '\.[0-9]{3,}')
diff --git a/transform/tests/assert_state_total_equals_county_sum.sql b/transform/tests/assert_state_total_equals_county_sum.sql
new file mode 100644
index 0000000..bf2335b
--- /dev/null
+++ b/transform/tests/assert_state_total_equals_county_sum.sql
@@ -0,0 +1,22 @@
+-- Fails (returns rows) when a state-month total in mart_obligations_by_state_month
+-- differs from the sum of its county-month totals in mart_obligations_by_geo_agency_month.
+
+with county_sum as (
+    select
+        state_fips,
+        month_start,
+        sum(obligation_total) as county_total
+    from {{ ref('mart_obligations_by_geo_agency_month') }}
+    group by state_fips, month_start
+)
+
+select
+    s.state_fips,
+    s.month_start,
+    s.obligation_total,
+    c.county_total
+from {{ ref('mart_obligations_by_state_month') }} as s
+full outer join county_sum as c
+    on s.state_fips is not distinct from c.state_fips
+   and s.month_start = c.month_start
+where s.obligation_total is distinct from c.county_total
diff --git a/transform/tests/assert_stg_usaspending_total_matches_raw_csv.sql b/transform/tests/assert_stg_usaspending_total_matches_raw_csv.sql
new file mode 100644
index 0000000..1c12493
--- /dev/null
+++ b/transform/tests/assert_stg_usaspending_total_matches_raw_csv.sql
@@ -0,0 +1,28 @@
+-- Fails (returns rows) when the staged FY2024 row count or obligation total differs
+-- from an independent read of the raw CSV members inside data/raw/usaspending/*.zip.
+{% do run_query("INSTALL zipfs FROM community") %}
+{% do run_query("LOAD zipfs") %}
+
+with raw_csv as (
+    select
+        cast(federal_action_obligation as decimal(18, 2)) as obligation
+    from read_csv('zip://data/raw/usaspending/*.zip/*.csv', all_varchar = true, union_by_name = true)
+    where action_date_fiscal_year = '2024'
+),
+
+raw_totals as (
+    select count(*) as raw_rows, sum(obligation) as raw_total from raw_csv
+),
+
+staged_totals as (
+    select
+        count(*) as staged_rows,
+        sum(federal_action_obligation) as staged_total
+    from {{ ref('stg_usaspending__awards') }}
+)
+
+select *
+from raw_totals
+cross join staged_totals
+where raw_rows <> staged_rows
+   or raw_total <> staged_total
