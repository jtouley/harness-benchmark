+import csv
+import io
+import json
+import os
+import tempfile
+import unittest
+import zipfile
+
+from pipeline import batch
+
+ASSISTANCE_HEADER = [
+    "federal_action_obligation",
+    "action_date",
+    "action_date_fiscal_year",
+    "awarding_agency_code",
+    "awarding_agency_name",
+    "prime_award_transaction_place_of_performance_county_fips_code",
+    "prime_award_transaction_place_of_performance_state_fips_code",
+    "primary_place_of_performance_county_name",
+    "primary_place_of_performance_state_name",
+]
+
+
+def make_member_csv(rows):
+    buffer = io.StringIO()
+    writer = csv.DictWriter(buffer, fieldnames=ASSISTANCE_HEADER)
+    writer.writeheader()
+    writer.writerows(rows)
+    return buffer.getvalue()
+
+
+def make_zip(directory, zip_name, member_name, csv_text):
+    path = os.path.join(directory, zip_name)
+    with zipfile.ZipFile(path, "w") as archive:
+        archive.writestr(member_name, csv_text)
+    return path
+
+
+def award_row(fiscal_year, obligation, county="11001"):
+    return {
+        "federal_action_obligation": obligation,
+        "action_date": "2024-09-30" if fiscal_year == "2024" else "2023-10-02",
+        "action_date_fiscal_year": fiscal_year,
+        "awarding_agency_code": "417",
+        "awarding_agency_name": "National Endowment for the Arts",
+        "prime_award_transaction_place_of_performance_county_fips_code": county,
+        "prime_award_transaction_place_of_performance_state_fips_code": county[:2],
+        "primary_place_of_performance_county_name": "DISTRICT OF COLUMBIA",
+        "primary_place_of_performance_state_name": "DISTRICT OF COLUMBIA",
+    }
+
+
+class SitematrixRowsTest(unittest.TestCase):
+    def test_flatten_sitematrix_oneRowPerSite(self):
+        doc = {
+            "sitematrix": {
+                "count": 1,
+                "0": {
+                    "code": "aa",
+                    "site": [
+                        {"url": "https://aa.wikipedia.org", "dbname": "aawiki", "code": "wiki", "closed": True},
+                        {"url": "https://aa.wiktionary.org", "dbname": "aawiktionary", "code": "wiktionary"},
+                    ],
+                },
+                "specials": [
+                    {"url": "https://abstract.wikipedia.org", "dbname": "abstractwiki", "code": "abstract", "lang": "en"},
+                ],
+            }
+        }
+        rows = batch.flatten_sitematrix(doc)
+        self.assertEqual(
+            [(r["dbname"], r["language_code"], r["closed"]) for r in rows],
+            [("aawiki", "aa", True), ("aawiktionary", "aa", False), ("abstractwiki", "en", False)],
+        )
+
+
+class CensusRowsTest(unittest.TestCase):
+    def test_census_county_rows_keepsCountyLevelOnly(self):
+        lines = [
+            "SUMLEV,STATE,COUNTY,STNAME,CTYNAME,POPESTIMATE2024",
+            "040,01,000,Alabama,Alabama,5157699",
+            "050,01,001,Alabama,Autauga County,60000",
+            "050,01,003,Alabama,Baldwin County,250000",
+        ]
+        rows = batch.census_county_rows(lines)
+        self.assertEqual([r["county"] for r in rows], ["001", "003"])
+
+    def test_census_county_rows_populationIsInteger(self):
+        lines = [
+            "SUMLEV,STATE,COUNTY,STNAME,CTYNAME,POPESTIMATE2024",
+            "050,01,001,Alabama,Autauga County,60000",
+        ]
+        rows = batch.census_county_rows(lines)
+        self.assertEqual(rows[0]["popestimate2024"], 60000)
+        self.assertIsInstance(rows[0]["popestimate2024"], int)
+
+
+class UsaspendingRowsTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+
+    def test_zip_rows_mapsSharedColumnsToOneShape(self):
+        csv_text = make_member_csv([award_row("2024", "157500.00", county="11001")])
+        zip_path = make_zip(
+            self.tmp.name,
+            "FY2024_417_Assistance_Full_20261006.zip",
+            "FY2024_417_Assistance_Full_20261007_1.csv",
+            csv_text,
+        )
+        counts, rows = batch.usaspending_zip_rows(zip_path)
+        self.assertEqual(len(rows), 1)
+        row = rows[0]
+        self.assertEqual(row["award_type"], "assistance")
+        self.assertEqual(row["toptier_agency_code"], "417")
+        self.assertEqual(row["federal_action_obligation"], "157500.00")
+        self.assertEqual(row["place_county_fips"], "11001")
+        self.assertEqual(row["place_state_fips"], "11")
+        self.assertEqual(row["awarding_agency_code"], "417")
+
+    def test_zip_rows_keepsFiscalYear2024Only(self):
+        csv_text = make_member_csv(
+            [award_row("2024", "1.00"), award_row("2023", "2.00"), award_row("2024", "3.00")]
+        )
+        zip_path = make_zip(
+            self.tmp.name,
+            "FY2024_417_Assistance_Full_20261006.zip",
+            "FY2024_417_Assistance_Full_20261007_1.csv",
+            csv_text,
+        )
+        counts, rows = batch.usaspending_zip_rows(zip_path)
+        self.assertEqual([r["federal_action_obligation"] for r in rows], ["1.00", "3.00"])
+        self.assertEqual(counts["rows_before_filter"], 3)
+        self.assertEqual(counts["rows_fy2024"], 2)
+
+    def test_award_row_key_unique_per_member(self):
+        csv_text = make_member_csv([award_row("2024", "1.00"), award_row("2024", "2.00")])
+        first = make_zip(
+            self.tmp.name,
+            "FY2024_417_Assistance_Full_20261006.zip",
+            "FY2024_417_Assistance_Full_20261007_1.csv",
+            csv_text,
+        )
+        second = make_zip(
+            self.tmp.name,
+            "FY2024_418_Assistance_Full_20261006.zip",
+            "FY2024_418_Assistance_Full_20261007_1.csv",
+            csv_text,
+        )
+        _, rows = batch.usaspending_zip_rows(first)
+        _, rows_second = batch.usaspending_zip_rows(second)
+        keys = [r["award_row_key"] for r in rows + rows_second]
+        self.assertEqual(len(keys), len(set(keys)))
+        self.assertEqual(rows[1]["source_row"], 2)
+        self.assertEqual(
+            rows[0]["award_row_key"],
+            "FY2024_417_Assistance_Full_20261006.zip/FY2024_417_Assistance_Full_20261007_1.csv#1",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
