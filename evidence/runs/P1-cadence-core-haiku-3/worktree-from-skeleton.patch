+-- Grain: one row per county_key.
+-- Census counties, plus the county keys that USAspending reports but Census does not
+-- carry (territories, state-unallocated '000' keys, UNKNOWN). Those rows have a null
+-- population_2024, so per-person values stay null for them.
+
+with census as (
+    select county_fips, state_fips, state_name, county_name, population_2024
+    from {{ ref('stg_census__county_population') }}
+),
+
+awards_only as (
+    select
+        county_key,
+        max(nullif(place_state_fips, '')) as state_fips,
+        max(nullif(place_state_name, '')) as state_name,
+        coalesce(max(nullif(place_county_name, '')), '(county not reported)') as county_name
+    from {{ ref('stg_usaspending__awards') }}
+    where county_key not in (select county_fips from census)
+    group by county_key
+)
+
+select
+    county_fips as county_key,
+    state_fips,
+    state_name,
+    county_name,
+    population_2024
+from census
+
+union all
+
+select
+    county_key,
+    state_fips,
+    state_name,
+    county_name,
+    cast(null as integer) as population_2024
+from awards_only
