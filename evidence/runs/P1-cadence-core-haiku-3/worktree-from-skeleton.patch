diff --git a/transform/models/staging/stg_usaspending__awards.sql b/transform/models/staging/stg_usaspending__awards.sql
new file mode 100644
index 0000000..6853342
--- /dev/null
+++ b/transform/models/staging/stg_usaspending__awards.sql
@@ -0,0 +1,27 @@
+-- Grain: one row per FY2024 USAspending prime award CSV row (award_row_key).
+-- federal_action_obligation is parsed to DECIMAL(18,2); a value with more than two
+-- decimals is caught by tests/assert_obligation_has_two_decimals.sql.
+-- county_key is the five-digit county FIPS when reported; otherwise the state FIPS
+-- plus '000' (state not allocated to a county); otherwise 'UNKNOWN'.
+
+select
+    award_row_key,
+    source_file,
+    award_type,
+    toptier_agency_code,
+    awarding_agency_code as agency_code,
+    awarding_agency_name as agency_name,
+    cast(action_date as date) as action_date,
+    action_date_fiscal_year,
+    cast(federal_action_obligation as decimal(18, 2)) as federal_action_obligation,
+    place_state_fips,
+    place_county_fips,
+    place_state_name,
+    place_county_name,
+    case
+        when place_county_fips <> '' then place_county_fips
+        when place_state_fips <> '' then place_state_fips || '000'
+        else 'UNKNOWN'
+    end as county_key
+from {{ source('lake', 'usaspending_awards') }}
+where action_date_fiscal_year = 2024
diff --git a/transform/models/staging/stg_wiki__recentchange.sql b/transform/models/staging/stg_wiki__recentchange.sql
new file mode 100644
index 0000000..dfbf9b2
--- /dev/null
+++ b/transform/models/staging/stg_wiki__recentchange.sql
@@ -0,0 +1,22 @@
+-- Grain: one row per first-arrival recentchange event (event_id).
+-- is_late is read as stored at arrival (never recomputed here).
+-- A null length on either side gives net_bytes = 0 and net_bytes_missing = true.
+
+select
+    meta_id as event_id,
+    meta_dt as event_time,
+    wiki as dbname,
+    namespace,
+    bot as is_bot,
+    type as event_type,
+    length_old,
+    length_new,
+    case
+        when length_old is null or length_new is null then 0
+        else length_new - length_old
+    end as net_bytes,
+    (length_old is null or length_new is null) as net_bytes_missing,
+    window_start,
+    window_end,
+    is_late
+from {{ source('lake', 'stream_events') }}
