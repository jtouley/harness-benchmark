+import os
+import re
+import unittest
+
+from pipeline import stream
+from tests.test_stream import fixture_events
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def arrival_flags(fixture):
+    parser = stream.SSEParser()
+    frames = []
+    for sse_id, data in fixture:
+        frames.extend(parser.feed(f"id: {sse_id}\ndata: {data}\n\n"))
+    events = [stream.parse_event(frame)[0] for frame in frames]
+    rows, _, _ = stream.classify_batch(events, set(), None, 0, arrival=events[0].dt)
+    return {row["meta_id"]: row["is_late"] for row in rows}
+
+
+class ArrivalRuleTest(unittest.TestCase):
+    def test_arrival_rule_fixture_onlyEventTenMinutesPastWindowEndIsLate(self):
+        flags = arrival_flags(fixture_events())
+        self.assertEqual({meta_id for meta_id, late in flags.items() if late}, {"e7"})
+
+    def test_arrival_rule_boundaryEventExactlyTenMinutesPastWindowEnd_notLate(self):
+        flags = arrival_flags(fixture_events())
+        self.assertFalse(flags["e5"])
+
+
+def _files_mentioning_threshold():
+    pattern = re.compile(r"LATE_AFTER|minutes=10")
+    hits = []
+    for folder in ("pipeline", os.path.join("transform", "models")):
+        for dirpath, _, names in os.walk(os.path.join(REPO_ROOT, folder)):
+            for name in names:
+                if name.endswith((".py", ".sql", ".yml")):
+                    path = os.path.join(dirpath, name)
+                    with open(path, encoding="utf-8") as handle:
+                        if pattern.search(handle.read()):
+                            hits.append(os.path.relpath(path, REPO_ROOT))
+    return hits
+
+
+class SingleDefinitionTest(unittest.TestCase):
+    def test_late_threshold_definedOnlyInStreamModule(self):
+        self.assertEqual(_files_mentioning_threshold(), [os.path.join("pipeline", "stream.py")])
+
+
+if __name__ == "__main__":
+    unittest.main()
