+import os
+import subprocess
+import unittest
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def run_make(*args):
+    return subprocess.run(
+        ["make", "-C", REPO_ROOT, *args],
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+
+
+class MakefileTargetsTest(unittest.TestCase):
+    def test_makefile_declaresBuildAndStreamTargets(self):
+        result = run_make("-n", "build", "stream", "DURATION=1")
+        self.assertEqual(result.returncode, 0, result.stderr)
+
+    def test_stream_missingDuration_failsWithMessage(self):
+        result = run_make("stream")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("DURATION", result.stderr + result.stdout)
+
+    def test_stream_nonPositiveDuration_fails(self):
+        for value in ("0", "-5", "abc"):
+            with self.subTest(duration=value):
+                result = run_make("stream", f"DURATION={value}")
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("DURATION", result.stderr + result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
