@@ -0,0 +1,424 @@
+"""SSE consumer for the Wikimedia recentchange stream.
+
+Pure functions (frame parsing, window bounds, the late rule, arrival classification)
+sit above the I/O: the Store (Parquet rows, cursor, gaps) and consume() (HTTP).
+
+Commit order per batch (MF-2): write the new rows to lake/raw/stream_events, then
+save the cursor. A kill between the two leaves the cursor behind the stored rows; the
+restart reloads the seen ids and the running max from the stored rows (MF-5), so the
+replayed copies are dropped.
+"""
+
+import argparse
+import http.client
+import json
+import os
+import sys
+import time
+import urllib.request
+import uuid
+from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+LAKE_DIR = os.path.join(REPO_ROOT, "lake")
+DEFAULT_URL = "http://localhost:8099/v2/stream/recentchange"
+
+LATE_AFTER = timedelta(minutes=10)
+WINDOW = timedelta(minutes=5)
+FLUSH_EVENTS = 200
+MAX_READ_TIMEOUT = 10.0
+UTC = timezone.utc
+
+SCHEMA = pa.schema(
+    [
+        ("meta_id", pa.string()),
+        ("meta_dt", pa.timestamp("us", tz="UTC")),
+        ("wiki", pa.string()),
+        ("namespace", pa.int64()),
+        ("bot", pa.bool_()),
+        ("type", pa.string()),
+        ("length_old", pa.int64()),
+        ("length_new", pa.int64()),
+        ("window_start", pa.timestamp("us", tz="UTC")),
+        ("window_end", pa.timestamp("us", tz="UTC")),
+        ("max_event_time_before", pa.timestamp("us", tz="UTC")),
+        ("arrival_seq", pa.int64()),
+        ("arrival_ts", pa.timestamp("us", tz="UTC")),
+        ("is_late", pa.bool_()),
+    ]
+)
+
+
+class Frame:
+    __slots__ = ("id", "data")
+
+    def __init__(self, frame_id, data):
+        self.id = frame_id
+        self.data = data
+
+
+class SSEParser:
+    """Incremental parser for text/event-stream. Accepts text in any chunk size."""
+
+    def __init__(self):
+        self._buffer = ""
+        self._id = None
+        self._data = []
+
+    def feed(self, text):
+        self._buffer += text
+        frames = []
+        while "\n" in self._buffer:
+            line, self._buffer = self._buffer.split("\n", 1)
+            line = line.rstrip("\r")
+            if line == "":
+                if self._data:
+                    frames.append(Frame(self._id, "\n".join(self._data)))
+                self._data = []
+                continue
+            if line.startswith(":"):
+                continue
+            field, _, value = line.partition(":")
+            if value.startswith(" "):
+                value = value[1:]
+            if field == "id":
+                self._id = value
+            elif field == "data":
+                self._data.append(value)
+        return frames
+
+
+@dataclass
+class StreamEvent:
+    id: str
+    meta_id: str
+    dt: datetime
+    fields: dict
+
+
+def parse_dt(text):
+    value = datetime.fromisoformat(text.replace("Z", "+00:00"))
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=UTC)
+    return value.astimezone(UTC)
+
+
+def parse_event(frame):
+    """Return (StreamEvent, "event"), or (None, kind) with kind "canary" or "malformed".
+
+    Canary events (meta.domain "canary") are Wikimedia test traffic with no wiki or
+    namespace; they are not edits and are not stored. Control characters inside JSON
+    strings are accepted (the server sends some).
+    """
+    try:
+        body = json.loads(frame.data, strict=False)
+        meta = body["meta"]
+        if meta.get("domain") == "canary":
+            return None, "canary"
+        length = body.get("length") or {}
+        event = StreamEvent(
+            id=frame.id,
+            meta_id=meta["id"],
+            dt=parse_dt(meta["dt"]),
+            fields={
+                "wiki": body.get("wiki"),
+                "namespace": body.get("namespace"),
+                "bot": bool(body.get("bot")),
+                "type": body.get("type"),
+                "length_old": length.get("old"),
+                "length_new": length.get("new"),
+            },
+        )
+        return event, "event"
+    except (ValueError, KeyError, TypeError, AttributeError):
+        return None, "malformed"
+
+
+def window_bounds(dt):
+    """[start, start + 5 min) in UTC, start floored to the 5-minute grid."""
+    dt = dt.astimezone(UTC)
+    start = dt.replace(minute=dt.minute - dt.minute % 5, second=0, microsecond=0)
+    return start, start + WINDOW
+
+
+def is_late(window_end, max_event_time_before):
+    """An event is late when an event more than LATE_AFTER past the window end came first."""
+    if max_event_time_before is None:
+        return False
+    return max_event_time_before - window_end > LATE_AFTER
+
+
+def classify_batch(events, seen, max_seen, next_seq, arrival):
+    """Return (new rows, max event time after the batch, next arrival_seq).
+
+    Drops ids already in `seen` and repeats within the batch (first occurrence kept).
+    max_event_time_before is the running max before each first-arrival event.
+    """
+    local_seen = set(seen)
+    rows = []
+    for event in events:
+        if event.meta_id in local_seen:
+            continue
+        local_seen.add(event.meta_id)
+        window_start, window_end = window_bounds(event.dt)
+        rows.append(
+            {
+                "meta_id": event.meta_id,
+                "meta_dt": event.dt,
+                **event.fields,
+                "window_start": window_start,
+                "window_end": window_end,
+                "max_event_time_before": max_seen,
+                "arrival_seq": next_seq,
+                "arrival_ts": arrival,
+                "is_late": is_late(window_end, max_seen),
+            }
+        )
+        next_seq += 1
+        if max_seen is None or event.dt > max_seen:
+            max_seen = event.dt
+    return rows, max_seen, next_seq
+
+
+def _atomic_write_text(path, text):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    tmp = os.path.join(os.path.dirname(path), f".{uuid.uuid4().hex}.tmp")
+    with open(tmp, "w", encoding="utf-8") as handle:
+        handle.write(text)
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(tmp, path)
+
+
+class Store:
+    """Stored rows under lake/raw/stream_events, the cursor and the gaps under lake/state/."""
+
+    def __init__(self, lake_dir):
+        self.events_dir = os.path.join(lake_dir, "raw", "stream_events")
+        self.tmp_dir = os.path.join(lake_dir, "state", "tmp")
+        self.cursor_path = os.path.join(lake_dir, "state", "cursor.json")
+        self.gaps_path = os.path.join(lake_dir, "state", "gaps.json")
+
+    def all_rows(self):
+        if not os.path.isdir(self.events_dir):
+            return []
+        rows = []
+        for name in sorted(os.listdir(self.events_dir)):
+            if name.endswith(".parquet"):
+                rows.extend(pq.read_table(os.path.join(self.events_dir, name)).to_pylist())
+        return rows
+
+    def load_state(self):
+        """Seen ids, running max event time and next arrival_seq from the stored rows (MF-2, MF-5)."""
+        rows = self.all_rows()
+        seen = {row["meta_id"] for row in rows}
+        max_seen = max((row["meta_dt"] for row in rows), default=None)
+        next_seq = max((row["arrival_seq"] for row in rows), default=-1) + 1
+        return seen, max_seen, next_seq
+
+    def cursor(self):
+        if not os.path.exists(self.cursor_path):
+            return None
+        with open(self.cursor_path, encoding="utf-8") as handle:
+            return json.load(handle).get("last_event_id")
+
+    def write_rows(self, rows):
+        if not rows:
+            return
+        self._write_part(rows)
+
+    def _write_part(self, rows):
+        os.makedirs(self.tmp_dir, exist_ok=True)
+        os.makedirs(self.events_dir, exist_ok=True)
+        name = f"part-{uuid.uuid4().hex}.parquet"
+        tmp = os.path.join(self.tmp_dir, name)
+        pq.write_table(pa.Table.from_pylist(rows, schema=SCHEMA), tmp)
+        os.replace(tmp, os.path.join(self.events_dir, name))
+
+    def ensure_events_file(self):
+        """Write a zero-row part file when the store has none, so that `make build`
+        reads a valid (empty) stream table without a stream run (decision N-4)."""
+        names = os.listdir(self.events_dir) if os.path.isdir(self.events_dir) else []
+        if not any(name.endswith(".parquet") for name in names):
+            self._write_part([])
+
+    def save_cursor(self, last_event_id):
+        _atomic_write_text(self.cursor_path, json.dumps({"last_event_id": last_event_id}))
+
+    def gaps(self):
+        if not os.path.exists(self.gaps_path):
+            return []
+        with open(self.gaps_path, encoding="utf-8") as handle:
+            return json.load(handle)
+
+    def record_gap(self, gap):
+        _atomic_write_text(self.gaps_path, json.dumps(self.gaps() + [gap], indent=2))
+
+
+def _iso(dt):
+    return dt.astimezone(UTC).isoformat()
+
+
+class Consumer:
+    """One run: the stored ids, the running max, the cursor and the pending batch."""
+
+    def __init__(self, lake_dir, *, flush_events, max_events, clock, sleep, now):
+        self.store = Store(lake_dir)
+        self.seen, self.max_seen, self.next_seq = self.store.load_state()
+        self.cursor = self.store.cursor()
+        self.flush_events = flush_events
+        self.max_events = max_events
+        self.clock = clock
+        self.sleep = sleep
+        self.now = now
+        self.deadline = None
+        self.pending = []
+        self.stats = {"stored": 0, "dropped": 0, "gaps": 0, "canary": 0, "malformed": 0}
+
+    def reached(self):
+        return self.max_events is not None and len(self.seen) + len(self.pending) >= self.max_events
+
+    def flush(self):
+        """Commit the pending batch: rows first, then the cursor (MF-2 order)."""
+        if not self.pending:
+            return
+        rows, self.max_seen, self.next_seq = classify_batch(
+            self.pending, self.seen, self.max_seen, self.next_seq, arrival=self.now()
+        )
+        if self.max_events is not None:
+            rows = rows[: max(0, self.max_events - len(self.seen))]
+        self.store.write_rows(rows)
+        self.seen = self.seen | {row["meta_id"] for row in rows}
+        self.stats["stored"] += len(rows)
+        self.stats["dropped"] += len(self.pending) - len(rows)
+        last_id = next((event.id for event in reversed(self.pending) if event.id is not None), None)
+        self.pending.clear()
+        if last_id is not None:
+            self.cursor = last_id
+        self.store.save_cursor(self.cursor)
+
+    def _take(self, frame):
+        event, kind = parse_event(frame)
+        if event is not None:
+            self.pending.append(event)
+        elif kind in self.stats:
+            self.stats[kind] += 1
+
+    def _read(self, response):
+        parser = SSEParser()
+        for raw in response:
+            for frame in parser.feed(raw.decode("utf-8")):
+                self._take(frame)
+                if len(self.pending) >= self.flush_events or self.reached():
+                    self.flush()
+                if self.reached():
+                    return
+            if self.clock() >= self.deadline:
+                return
+
+    def _connect(self):
+        headers = {"Accept": "text/event-stream"}
+        if self.cursor is not None:
+            headers["Last-Event-ID"] = self.cursor
+        request = urllib.request.Request(self.url, headers=headers)  # noqa: S310
+        timeout = max(1.0, min(MAX_READ_TIMEOUT, self.deadline - self.clock()))
+        # The URL is checked to be http or https in run().
+        return urllib.request.urlopen(request, timeout=timeout)  # noqa: S310
+
+    def _record_reconnect(self, disconnected):
+        self.store.record_gap(
+            {
+                "disconnected_at": _iso(disconnected[0]),
+                "reconnected_at": _iso(self.now()),
+                "cursor": disconnected[1],
+                "reason": disconnected[2],
+            }
+        )
+        self.stats["gaps"] += 1
+
+    def run(self, url, duration, backoff_max):
+        if not url.startswith(("http://", "https://")):
+            raise ValueError(f"stream URL must be http or https: {url}")
+        self.url = url
+        self.deadline = self.clock() + duration
+        backoff = 0.5
+        disconnected = None
+        while self.clock() < self.deadline:
+            try:
+                with self._connect() as response:
+                    if disconnected is not None:
+                        self._record_reconnect(disconnected)
+                        disconnected = None
+                    backoff = 0.5
+                    self._read(response)
+                reason = "end of stream"
+            except (OSError, http.client.HTTPException) as exc:
+                reason = repr(exc)
+            if self.clock() >= self.deadline or self.reached():
+                break
+            self.flush()
+            disconnected = (self.now(), self.cursor, reason)
+            self.sleep(backoff)
+            backoff = min(backoff * 2, backoff_max)
+        self.flush()
+        return self.stats
+
+
+def consume(
+    url,
+    lake_dir,
+    duration,
+    *,
+    backoff_max=8.0,
+    flush_events=FLUSH_EVENTS,
+    clock=time.monotonic,
+    sleep=time.sleep,
+    now=lambda: datetime.now(UTC),
+    max_events=None,
+):
+    """Read the stream for `duration` seconds, reconnecting after a disconnect.
+
+    With max_events, stop once that many events are stored (the oracle uses this to
+    compare two runs over the same prefix of the replay).
+
+    Returns a summary dict: stored, dropped (duplicates), gaps (reconnects),
+    canary and malformed (frames not stored).
+    """
+    consumer = Consumer(
+        lake_dir,
+        flush_events=flush_events,
+        max_events=max_events,
+        clock=clock,
+        sleep=sleep,
+        now=now,
+    )
+    return consumer.run(url, duration, backoff_max)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Consume the recentchange SSE stream.")
+    parser.add_argument("--duration", type=int, help="seconds to run")
+    parser.add_argument("--ensure-store", action="store_true", help="write an empty stream table if none exists")
+    parser.add_argument("--max-events", type=int, default=None, help="stop after this many stored events")
+    parser.add_argument("--url", default=DEFAULT_URL)
+    parser.add_argument("--lake", default=LAKE_DIR)
+    args = parser.parse_args(argv)
+    if args.ensure_store:
+        Store(args.lake).ensure_events_file()
+        return 0
+    if args.duration is None or args.duration <= 0:
+        parser.error("--duration must be a positive integer")
+    stats = consume(args.url, args.lake, args.duration, max_events=args.max_events)
+    print(
+        f"stream: stored={stats['stored']} dropped={stats['dropped']} reconnects={stats['gaps']} "
+        f"canary={stats['canary']} malformed={stats['malformed']}"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
